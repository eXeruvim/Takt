import { Theme } from "../theme.slint";
import { Divider, UiText, TextVariant } from "../design_system/primitives.slint";

component PropertyRow inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: Theme.space-12;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-1;

        UiText {
            text: root.label;
            variant: TextVariant.caption;
            color: Theme.text-muted;
        }
        UiText {
            text: root.value;
            variant: TextVariant.label;
            overflow: elide;
        }
    }
}

export component InfoDrawer inherits Rectangle {
    in-out property <bool> drawer_visible;
    in-out property <string> file_name;
    in-out property <string> codec;
    in-out property <string> audio_codec;
    in-out property <string> resolution;
    in-out property <string> fps;
    in property <bool> audio_media;
    in property <length> parent_width;
    in property <length> parent_height;
    callback close();

    private property <length> swipe_offset: 0px;

    width: min(340px, parent_width - Theme.space-8);
    height: max(0px, parent_height - self.y
        - Theme.player-controls-height - Theme.space-6);
    x: -self.width - Theme.space-12;
    y: Theme.space-4 + Theme.top-bar-height + Theme.space-2;
    border-radius: Theme.radius-xlarge;
    background: Theme.surface-glass-strong;
    border-width: 1px;
    border-color: Theme.border-glass;
    drop-shadow-color: Theme.shadow-high;
    drop-shadow-blur: Theme.elevation-high-blur;
    drop-shadow-offset-y: Theme.elevation-high-y;
    clip: true;

    states [
        open when root.drawer_visible : {
            root.x: Theme.space-4 + root.swipe_offset;
            in {
                animate x {
                    duration: Theme.motion-slow;
                    easing: cubic-bezier(0.16, 1, 0.3, 1);
                }
            }
            out {
                animate x {
                    duration: Theme.motion-normal;
                    easing: cubic-bezier(0.4, 0, 1, 1);
                }
            }
        }
    ]

    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {
        padding: Theme.space-5;
        spacing: Theme.space-3;

        UiText { text: "Свойства файла"; variant: TextVariant.title; }
        UiText {
            text: root.file_name;
            color: Theme.text-secondary;
            overflow: elide;
        }
        Divider { }
        if !root.audio_media : PropertyRow { label: "Видео"; value: root.codec; }
        if !root.audio_media : PropertyRow { label: "Разрешение"; value: root.resolution; }
        if !root.audio_media : PropertyRow { label: "Частота кадров"; value: root.fps + " FPS"; }
        if !root.audio_media : Divider { }
        PropertyRow { label: "Аудио"; value: root.audio_codec; }
        Rectangle { vertical-stretch: 1; background: transparent; }
        UiText {
            text: "I — скрыть панель";
            variant: TextVariant.caption;
            color: Theme.text-muted;
        }
    }

    swipe := TouchArea {
        width: parent.width;
        height: Theme.top-bar-height;
        mouse-cursor: MouseCursor.grab;

        moved => {
            if (self.pressed) {
                root.swipe_offset = min(0px, self.mouse-x - self.pressed-x);
            }
        }

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                if (self.mouse-x - self.pressed-x < -72px) {
                    root.close();
                }
                root.swipe_offset = 0px;
            }
        }
    }
}
