import { Theme } from "../theme.slint";
import { Divider, UiText, TextVariant } from "../design_system/primitives.slint";

component PropertyRow inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: Theme.space-12;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-1;

        UiText {
            text: root.label;
            variant: TextVariant.caption;
            color: Theme.text-muted;
        }
        UiText {
            text: root.value;
            variant: TextVariant.label;
            overflow: elide;
        }
    }
}

export component InfoDrawer inherits Rectangle {
    in-out property <bool> drawer_visible;
    in-out property <string> file_name;
    in-out property <string> codec;
    in-out property <string> audio_codec;
    in-out property <string> resolution;
    in-out property <string> fps;
    in property <length> parent_width;
    in property <length> parent_height;

    width: min(340px, parent_width - Theme.space-8);
    height: parent_height - Theme.space-8;
    x: drawer_visible ? Theme.space-4 : -self.width - Theme.space-5;
    y: Theme.space-4;
    border-radius: Theme.radius-xlarge;
    background: Theme.surface-glass-strong;
    border-width: 1px;
    border-color: Theme.border-glass;
    drop-shadow-color: Theme.shadow-high;
    drop-shadow-blur: Theme.elevation-high-blur;
    drop-shadow-offset-y: Theme.elevation-high-y;

    animate x { duration: Theme.motion-normal; easing: ease-out; }

    VerticalLayout {
        padding: Theme.space-5;
        spacing: Theme.space-3;

        UiText { text: "Свойства файла"; variant: TextVariant.title; }
        UiText {
            text: root.file_name;
            color: Theme.text-secondary;
            overflow: elide;
        }
        Divider { }
        PropertyRow { label: "Видео"; value: root.codec; }
        PropertyRow { label: "Разрешение"; value: root.resolution; }
        PropertyRow { label: "Частота кадров"; value: root.fps + " FPS"; }
        Divider { }
        PropertyRow { label: "Аудио"; value: root.audio_codec; }
        Rectangle { vertical-stretch: 1; background: transparent; }
        UiText {
            text: "I — скрыть панель";
            variant: TextVariant.caption;
            color: Theme.text-muted;
        }
    }
}
