import { Theme } from "../theme.slint";

export component InfoDrawer inherits Rectangle {

    in-out property <bool> drawer_visible;

    in-out property <string> file_name;

    in-out property <string> codec;
    in-out property <string> audio_codec;

    in-out property <string> resolution;
    in-out property <string> fps;


    in property <length> parent_width;
    in property <length> parent_height;


    width: 340px;
    height: parent_height;


    x: drawer_visible
        ? 0px
        : -self.width - 20px;


    background: Theme.surface-elevated;

    border-width: 1px;
    border-color: Theme.border-default;


    animate x {
        duration: Theme.motion-slow;
        easing: ease-in-out;
    }


    VerticalLayout {

        padding: Theme.space-6;
        spacing: Theme.space-3;


        Text {
            text: "Информация";

            font-size: Theme.text-heading;
            font-weight: 700;

            color: Theme.text-primary;
        }


        Rectangle {
            height: 1px;

            background: Theme.border-subtle;
        }


        Text {
            text: "Файл";

            color: Theme.text-muted;
        }


        Text {
            text: file_name;

            color: Theme.text-primary;
        }


        Rectangle {
            height: 1px;

            background: Theme.border-subtle;
        }


        Text {
            text: "Видео";

            color: Theme.text-muted;
        }


        Text {
            text: codec;

            color: Theme.text-primary;
        }


        Text {
            text: resolution;

            color: Theme.text-primary;
        }


        Text {
            text: fps;

            color: Theme.text-primary;
        }


        Rectangle {
            height: 1px;

            background: Theme.border-subtle;
        }


        Text {
            text: "Аудио";

            color: Theme.text-muted;
        }


        Text {
            text: audio_codec;

            color: Theme.text-primary;
        }
    }
}
