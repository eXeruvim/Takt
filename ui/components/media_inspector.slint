import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Button, Divider, FocusTouchArea, IconButton, Toggle, UiText, TextVariant } from "../design_system/primitives.slint";
import { MediaListItem, SettingsRow } from "../design_system/composites.slint";

export struct AudioTrackEntry {
    id: int,
    label: string,
    selected: bool,
}

export struct SubtitleTrackEntry {
    id: int,
    label: string,
    selected: bool,
}

export struct ChapterEntry {
    index: int,
    label: string,
}

export struct EqualizerBandEntry {
    label: string,
    gain-db: float,
}

export struct RecentFileEntry {
    name: string,
    path: string,
    location: string,
}

component PlaylistQueue inherits Rectangle {
    in property <[string]> items;
    in property <int> current-index: -1;
    in property <int> focus-revision: 0;
    callback play-index(int);
    callback remove-index(int);
    private property <length> item-height: Theme.space-12 + Theme.space-1;
    private property <bool> auto-centering: false;
    private property <length> center-start: 0px;
    private property <float> center-progress: 0;
    background: transparent;

    function target-offset() -> length {
        if (root.current-index < 0 || root.items.length == 0) {
            return playlist-list.viewport-y;
        }
        let content-height = root.items.length * root.item-height;
        let minimum-offset = min(0px, playlist-list.visible-height - content-height);
        let centered-offset = playlist-list.visible-height / 2 - root.item-height / 2
            - root.current-index * root.item-height;
        return max(minimum-offset, min(0px, centered-offset));
    }

    function center-current() {
        if (root.current-index >= 0 && root.items.length > 0) {
            root.center-start = playlist-list.viewport-y;
            root.center-progress = 0;
            root.auto-centering = true;
        }
    }

    changed current-index => root.center-current();
    changed items => root.center-current();
    changed focus-revision => root.center-current();
    changed height => root.center-current();

    center-timer := Timer {
        interval: 16ms;
        running: root.auto-centering;
        triggered => {
            let target = root.target-offset();
            root.center-progress = min(1, root.center-progress + 0.04);
            let eased = root.center-progress * root.center-progress
                * (3 - 2 * root.center-progress);
            playlist-list.viewport-y = root.center-start
                + (target - root.center-start) * eased;
            if (root.center-progress >= 1) {
                playlist-list.viewport-y = target;
                root.auto-centering = false;
            }
        }
    }

    playlist-list := ListView {
        width: parent.width;
        height: parent.height;

        for item[index] in root.items : Rectangle {
            width: max(0px, playlist-list.visible-width - Theme.space-5);
            height: root.item-height;
            background: transparent;

            MediaListItem {
                width: parent.width;
                title: item;
                subtitle: index == root.current-index
                    ? "Сейчас воспроизводится" : "Открыть";
                selected: index == root.current-index;
                removable: true;
                activated => root.play-index(index);
                remove-requested => root.remove-index(index);
            }
        }
    }
}

component CompactToggleRow inherits Rectangle {
    in property <string> title;
    in property <bool> checked: false;
    callback toggled(bool);

    min-height: Theme.space-10;
    background: transparent;

    control := Toggle {
        x: parent.width * 2 / 3;
        y: (parent.height - self.height) / 2;
        checked: root.checked;
        toggled(checked) => root.toggled(checked);
    }

    UiText {
        x: Theme.space-2;
        y: 0px;
        width: max(0px, control.x - self.x - Theme.space-3);
        height: parent.height;
        text: root.title;
        variant: TextVariant.label;
        overflow: elide;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component PropertyRow inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: Theme.space-12;
    min-width: 0px;
    horizontal-stretch: 1;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-1;

        UiText {
            text: root.label;
            variant: TextVariant.caption;
            color: Theme.text-muted;
        }
        UiText {
            text: root.value;
            variant: TextVariant.label;
            overflow: elide;
        }
    }
}

component DelayControl inherits Rectangle {
    in property <float> value;
    callback adjust(float);
    callback reset();

    height: Theme.space-10;
    background: transparent;

    HorizontalLayout {
        spacing: Theme.space-2;
        alignment: center;

        Button {
            width: 76px;
            text: "−0,1 с";
            clicked => root.adjust(-0.1);
        }
        UiText {
            horizontal-stretch: 1;
            text: Math.round(root.value * 10) / 10 + " с";
            variant: TextVariant.label;
            color: root.value == 0 ? Theme.text-secondary : Theme.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Button {
            width: 76px;
            text: "+0,1 с";
            clicked => root.adjust(0.1);
        }
        Button {
            width: 72px;
            text: "Сброс";
            enabled: root.value != 0;
            clicked => root.reset();
        }
    }
}

component PreampControl inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    in property <bool> reset-enabled;
    callback adjust(float);
    callback reset();

    height: Theme.space-10;
    background: transparent;

    HorizontalLayout {
        spacing: Theme.space-2;
        alignment: center;

        Button {
            width: 64px;
            text: "−1 дБ";
            enabled: root.enabled;
            clicked => root.adjust(-1);
        }
        UiText {
            horizontal-stretch: 1;
            text: (root.value > 0 ? "+" : "") + Math.round(root.value) + " дБ";
            variant: TextVariant.label;
            color: root.value == 0 ? Theme.text-secondary : Theme.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Button {
            width: 64px;
            text: "+1 дБ";
            enabled: root.enabled;
            clicked => root.adjust(1);
        }
        Button {
            width: 72px;
            text: "Сброс";
            enabled: root.enabled && root.reset-enabled;
            clicked => root.reset();
        }
    }
}

component EqualizerBandControl inherits Rectangle {
    in property <string> label;
    in property <float> gain-db;
    callback adjust(float);

    height: Theme.space-10;
    background: transparent;

    HorizontalLayout {
        spacing: Theme.space-2;
        alignment: center;

        UiText {
            width: 68px;
            text: root.label;
            variant: TextVariant.caption;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        Button {
            width: 56px;
            text: "−";
            enabled: root.gain-db > -6;
            clicked => root.adjust(-1);
        }
        Rectangle {
            horizontal-stretch: 1;
            height: Theme.space-8;
            border-radius: Theme.radius-medium;
            background: Theme.surface-control;

            UiText {
                width: parent.width;
                height: parent.height;
                text: (root.gain-db > 0 ? "+" : "")
                    + Math.round(root.gain-db) + " дБ";
                variant: TextVariant.label;
                color: root.gain-db == 0 ? Theme.text-secondary : Theme.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Button {
            width: 56px;
            text: "+";
            enabled: root.gain-db < 6;
            clicked => root.adjust(1);
        }
    }
}

component AccentChoice inherits Rectangle {
    in property <string> text;
    in property <color> swatch;
    in property <bool> selected: false;
    callback activated();

    private property <length> label-x: Theme.space-2 + 12px + Theme.space-1;
    private property <length> label-width: max(0px, root.width - root.label-x - Theme.space-2);
    private property <length> measured-text-width: label-text.preferred-width;
    private property <bool> text-overflows:
        root.measured-text-width > root.label-width;

    height: 36px;
    min-width: 0px;
    border-radius: Theme.radius-medium;
    background: hit.pressed ? Theme.surface-pressed
        : hit.has-hover ? Theme.surface-hover
        : root.selected ? Theme.surface-selected : Theme.surface-control;
    border-width: root.selected || hit.has-focus ? 1px : 0px;
    border-color: hit.has-focus ? Theme.focus-ring : root.swatch;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => root.activated();

    hit := FocusTouchArea {
        width: parent.width;
        height: parent.height;
        clicked => root.activated();
    }

    Rectangle {
        x: Theme.space-2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: Theme.radius-full;
        background: root.swatch;
        border-width: 1px;
        border-color: Theme.border-glass;
    }

    label-viewport := Rectangle {
        x: root.label-x;
        width: root.label-width;
        height: parent.height;
        background: transparent;
        clip: true;

        label-text := UiText {
            x: root.text-overflows && hit.has-hover
                ? parent.width - root.measured-text-width
                : 0px;
            width: root.text-overflows && hit.has-hover
                ? root.measured-text-width
                : parent.width;
            height: parent.height;
            text: root.text;
            variant: TextVariant.caption;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.text-small;
            overflow: elide;
            vertical-alignment: center;

            animate x {
                duration: 900ms;
                easing: linear;
            }
        }
    }

    animate background, border-color {
        duration: Theme.motion-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
}

export component MediaInspector inherits Rectangle {
    private property <bool> prewarming: true;
    private property <int> settings-page: 0;
    private property <bool> wide-layout: parent-width >= 1100px;
    private property <bool> video-settings-available: media-loaded && !audio-media;
    in property <bool> open;
    in property <bool> left-aligned: false;
    in property <bool> playlist-open;
    in property <bool> info-open;
    in property <bool> playback-open;
    in property <[string]> items;
    in property <[RecentFileEntry]> recent-files;
    in property <bool> playback-data-cleared: false;
    in property <bool> settings-reset-done: false;
    in property <int> current-index: -1;
    in property <int> playlist-focus-revision: 0;
    in property <string> file-name;
    in property <string> codec;
    in property <string> audio-codec;
    in property <string> container-format;
    in property <string> file-size-label;
    in property <string> media-duration-label;
    in property <string> media-bitrate-label;
    in property <string> track-summary;
    in property <string> app-version;
    in property <string> resolution;
    in property <string> fps;
    in property <bool> audio-media;
    in property <bool> media-loaded;
    in property <[AudioTrackEntry]> audio-tracks;
    in property <[SubtitleTrackEntry]> subtitle-tracks;
    in property <bool> subtitles-enabled;
    in property <[ChapterEntry]> chapters;
    in property <int> current-chapter-index: -1;
    in property <int> aspect-ratio-index: 0;
    in property <bool> hardware-decoding-enabled: false;
    in property <string> hardware-decoder: "no";
    in property <bool> integrated-video-renderer: false;
    in property <int> theme-mode: 0;
    in property <int> accent-mode: 0;
    in property <bool> equalizer-enabled: false;
    in property <int> equalizer-preset-index: 0;
    in property <float> equalizer-preamp-db: 0;
    in property <[EqualizerBandEntry]> equalizer-bands;
    in property <float> audio-delay;
    in property <float> subtitle-delay;
    in-out property <float> speed;
    in-out property <bool> folder-loop-enabled;
    in-out property <bool> shuffle-enabled;
    in property <length> parent-width;
    in property <length> parent-height;
    in property <bool> fullscreen-active: false;
    in property <bool> media-presented: false;
    out property <length> slide-offset: open || prewarming
        ? 0px : self.width + Theme.space-5;
    private property <length> playback-content-height: 912px;
    private property <length> video-content-height: 80px
        + (chapters.length > 0 ? 64px + chapters.length * 48px : 0px)
        + 116px + 64px + 96px
        + 168px + subtitle-tracks.length * 48px
        + (subtitle-tracks.length > 0 ? 144px : 0px);
    private property <length> sound-content-height: media-loaded
        ? 372px
            + (audio-tracks.length > 0 ? 88px : 0px)
            + max(0, audio-tracks.length - 1) * 48px
            + (!audio-media ? 144px : 64px)
            + (equalizer-preset-index == 5 ? 288px : 0px)
        : 120px;
    private property <length> info-content-height: audio-media ? 320px : 416px;
    callback show-playlist();
    callback show-info();
    callback show-playback();
    callback close();
    callback play-index(int);
    callback remove-index(int);
    callback open-recent(string);
    callback set-speed(float);
    callback select-audio-track(int);
    callback select-subtitle-track(int);
    callback load-subtitle();
    callback adjust-audio-delay(float);
    callback adjust-subtitle-delay(float);
    callback reset-audio-delay();
    callback reset-subtitle-delay();
    callback select-chapter(int);
    callback set-aspect-ratio(int);
    callback set-hardware-decoding(bool);
    callback choose-theme(int);
    callback choose-accent(int);
    callback step-frame(int);
    callback set-equalizer-enabled(bool);
    callback set-equalizer-preset(int);
    callback adjust-equalizer-preamp(float);
    callback adjust-equalizer-band(int, float);
    callback reset-equalizer();
    callback set-folder-loop(bool);
    callback toggle-shuffle();
    callback request-clear-playback-data();
    callback request-reset-settings();

    private property <length> top-clearance: fullscreen-active
        ? Theme.space-4 : Theme.top-bar-height + Theme.space-2;
    private property <length> bottom-clearance: media-presented
        ? Theme.player-controls-height + Theme.space-6 : Theme.space-4;
    private property <length> available-height:
        max(0px, parent-height - top-clearance - bottom-clearance);
    width: min(wide-layout ? 440px : 392px, parent-width - Theme.space-8);
    height: wide-layout ? available-height : min(available-height, 820px);
    x: left-aligned
        ? Theme.space-4 - slide-offset
        : parent-width - self.width - Theme.space-4 + slide-offset;
    y: top-clearance + (wide-layout ? 0px : max(0px, (available-height - self.height) / 2));
    opacity: open ? 1 : prewarming ? 0.001 : 0;
    border-radius: Theme.radius-large;
    background: Theme.surface-inspector;
    border-width: 1px;
    border-color: Theme.border-glass;
    drop-shadow-color: Theme.shadow-low;
    drop-shadow-blur: Theme.space-1;
    drop-shadow-offset-y: Theme.elevation-low-y;
    clip: true;

    changed video-settings-available => {
        if (!root.video-settings-available && root.settings-page == 2) {
            root.settings-page = 0;
        }
    }

    animate opacity {
        duration: root.open ? Theme.motion-slow : Theme.motion-gentle;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }

    animate slide-offset {
        duration: root.open ? Theme.motion-slow : Theme.motion-gentle;
        easing: cubic-bezier(0.16, 1, 0.3, 1);
    }

    prewarm-timer := Timer {
        interval: 120ms;
        running: root.prewarming;
        triggered => { root.prewarming = false; }
    }

    TouchArea {
        enabled: root.open;
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {
        padding: Theme.space-5;
        spacing: Theme.space-3;

        HorizontalLayout {
            height: Theme.space-10;
            alignment: center;

            UiText {
                text: "Inspector";
                variant: TextVariant.title;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            IconButton {
                icon: @image-url("../icons/window-close.svg");
                accessible-name: "Закрыть Inspector";
                circular: true;
                capture-focus: false;
                clicked => root.close();
            }
        }

        if root.left-aligned : HorizontalLayout {
            height: Theme.space-10;
            spacing: Theme.space-2;

            Button {
                horizontal-stretch: 1;
                min-width: 0px;
                text: "Очередь";
                selected: root.playlist-open;
                clicked => {
                    if (!root.playlist-open) { root.show-playlist(); }
                }
            }
            Button {
                horizontal-stretch: 1;
                min-width: 0px;
                text: "Инфо";
                selected: root.info-open;
                clicked => {
                    if (!root.info-open) { root.show-info(); }
                }
            }
        }

        if !root.left-aligned : HorizontalLayout {
            height: Theme.space-10;
            spacing: Theme.space-2;

            Button {
                horizontal-stretch: 1;
                min-width: 0px;
                text: "Плеер";
                selected: root.playback-open && root.settings-page == 0;
                clicked => {
                    root.settings-page = 0;
                    if (!root.playback-open) { root.show-playback(); }
                }
            }
            Button {
                horizontal-stretch: 1;
                min-width: 0px;
                text: "Звук";
                selected: root.playback-open && root.settings-page == 1;
                clicked => {
                    root.settings-page = 1;
                    if (!root.playback-open) { root.show-playback(); }
                }
            }
            if root.video-settings-available : Button {
                horizontal-stretch: 1;
                min-width: 0px;
                text: "Видео";
                selected: root.playback-open && root.settings-page == 2;
                clicked => {
                    root.settings-page = 2;
                    if (!root.playback-open) { root.show-playback(); }
                }
            }
        }

        Divider { }

        content-host := Rectangle {
            vertical-stretch: 1;
            background: transparent;
            clip: true;

            VerticalLayout {
                x: root.playlist-open || root.prewarming
                    ? 0px : parent.width + Theme.space-1;
                width: parent.width;
                height: parent.height;
                spacing: Theme.space-3;

                queue-pane := Rectangle {
                    vertical-stretch: 1;
                    background: transparent;

                    VerticalLayout {
                        spacing: Theme.space-2;

                        UiText {
                            text: root.items.length == 0
                                ? "Очередь пока пуста"
                                : root.items.length + (root.items.length == 1
                                    ? " файл" : " файлов в очереди");
                            variant: TextVariant.caption;
                            color: Theme.text-secondary;
                        }

                        if root.items.length == 0 : UiText {
                            text: "Откройте файл или папку, чтобы сформировать очередь";
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }

                        if root.items.length == 0 : Rectangle {
                            vertical-stretch: 1;
                            background: transparent;
                        }

                        if root.items.length > 0 : PlaylistQueue {
                            vertical-stretch: 1;
                            items: root.items;
                            current-index: root.current-index;
                            focus-revision: root.playlist-focus-revision;
                            play-index(index) => root.play-index(index);
                            remove-index(index) => root.remove-index(index);
                        }
                    }
                }

                if root.recent-files.length > 0 : Divider { }

                if root.recent-files.length > 0 : recent-pane := Rectangle {
                    vertical-stretch: 1;
                    background: transparent;

                    VerticalLayout {
                        spacing: Theme.space-2;

                        UiText {
                            text: "Недавние";
                            variant: TextVariant.caption;
                            color: Theme.text-secondary;
                        }

                        ListView {
                            vertical-stretch: 1;

                            for entry in root.recent-files : Rectangle {
                                width: parent.width;
                                height: Theme.space-12 + Theme.space-1;
                                background: transparent;

                                MediaListItem {
                                    width: parent.width;
                                    title: entry.name;
                                    subtitle: entry.location;
                                    activated => root.open-recent(entry.path);
                                }
                            }
                        }

                        UiText {
                            text: "История и позиции хранятся только на этом устройстве";
                            variant: TextVariant.caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            info-scroll := ScrollView {
                visible: root.info-open || root.prewarming;
                x: 0px;
                width: parent.width;
                height: parent.height;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, root.info-content-height);

                info-viewport := Rectangle {
                    width: max(0px, info-scroll.visible-width
                        - Theme.space-8 - Theme.space-1);
                    height: max(root.info-content-height, info-scroll.visible-height);
                    y: 0px;
                    background: transparent;
                    clip: true;

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: Theme.space-3;
                        alignment: start;

                        UiText {
                            text: root.file-name;
                            variant: TextVariant.label;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }

                        Divider { }

                        HorizontalLayout {
                            height: Theme.space-12;
                            spacing: Theme.space-3;
                            PropertyRow { label: "Контейнер"; value: root.container-format; }
                            PropertyRow { label: "Размер"; value: root.file-size-label; }
                        }

                        HorizontalLayout {
                            height: Theme.space-12;
                            spacing: Theme.space-3;
                            PropertyRow { label: "Длительность"; value: root.media-duration-label; }
                            PropertyRow { label: "Bitrate"; value: root.media-bitrate-label; }
                        }

                        if !root.audio-media : HorizontalLayout {
                            height: Theme.space-12;
                            spacing: Theme.space-3;
                            PropertyRow { label: "Видео"; value: root.codec; }
                            PropertyRow { label: "Разрешение"; value: root.resolution; }
                        }

                        if !root.audio-media : HorizontalLayout {
                            height: Theme.space-12;
                            spacing: Theme.space-3;
                            PropertyRow { label: "Частота кадров"; value: root.fps; }
                            PropertyRow { label: "Аудио"; value: root.audio-codec; }
                        }

                        if root.audio-media : PropertyRow {
                            label: "Аудио";
                            value: root.audio-codec;
                        }

                        PropertyRow {
                            label: "Дорожки";
                            value: root.track-summary;
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        UiText {
                            text: "Oxide " + root.app-version
                                + "  ·  I — открыть или закрыть Inspector";
                            variant: TextVariant.caption;
                            color: Theme.text-muted;
                        }
                    }
                }
            }

            playback-scroll := ScrollView {
                visible: (root.playback-open && root.settings-page == 0) || root.prewarming;
                x: 0px;
                width: parent.width;
                height: parent.height;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, root.playback-content-height);

                settings-viewport := Rectangle {
                    // Fluent ScrollView expands its overlaid scrollbar on hover.
                    // Keep both the expanded bar and a visible air gap outside
                    // control borders so their hover states never touch.
                    width: max(0px, playback-scroll.visible-width
                        - Theme.space-8 - Theme.space-1);
                    height: root.playback-content-height;
                    y: 0px;
                    background: transparent;
                    clip: true;

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: Theme.space-3;
                        alignment: start;

                UiText {
                    text: "Оформление";
                    variant: TextVariant.caption;
                    color: Theme.text-muted;
                }

                UiText { text: "Тема"; variant: TextVariant.label; }

                HorizontalLayout {
                    height: Theme.space-10;
                    spacing: Theme.space-2;

                    for option[index] in ["Система", "Тёмная", "Светлая"] : Button {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: option;
                        selected: root.theme-mode == index;
                        clicked => root.choose-theme(index);
                    }
                }

                UiText { text: "Акцент"; variant: TextVariant.label; }

                HorizontalLayout {
                    height: 36px;
                    spacing: Theme.space-2;

                    AccentChoice {
                        horizontal-stretch: 1;
                        text: "Медь";
                        swatch: Theme.is-dark ? #e07a4f : #c85f38;
                        selected: root.accent-mode == 0;
                        activated => root.choose-accent(0);
                    }
                    AccentChoice {
                        horizontal-stretch: 1;
                        text: "Янтарь";
                        swatch: Theme.is-dark ? #e3a64b : #b96b13;
                        selected: root.accent-mode == 1;
                        activated => root.choose-accent(1);
                    }
                    AccentChoice {
                        horizontal-stretch: 1;
                        text: "Шалфей";
                        swatch: Theme.is-dark ? #5fb38b : #2f8060;
                        selected: root.accent-mode == 2;
                        activated => root.choose-accent(2);
                    }
                    AccentChoice {
                        horizontal-stretch: 1;
                        text: "Синий";
                        swatch: Theme.is-dark ? #6f9df5 : #3f72c8;
                        selected: root.accent-mode == 3;
                        activated => root.choose-accent(3);
                    }
                }

                Divider { }

                UiText {
                    text: "Настройки воспроизведения";
                    variant: TextVariant.caption;
                    color: Theme.text-muted;
                }

                UiText { text: "Скорость"; variant: TextVariant.label; }
                HorizontalLayout {
                    height: Theme.space-10;
                    spacing: Theme.space-2;

                    for value in ["0.5", "0.75", "1.0"] : Button {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: value == "1.0" ? "1×" : value + "×";
                        selected: root.speed == value.to-float();
                        clicked => root.set-speed(value.to-float());
                    }
                }

                HorizontalLayout {
                    height: Theme.space-10;
                    spacing: Theme.space-2;

                    for value in ["1.25", "1.5", "2.0"] : Button {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: value == "2.0" ? "2×" : value + "×";
                        selected: root.speed == value.to-float();
                        clicked => root.set-speed(value.to-float());
                    }
                }

                UiText {
                    text: "Выбранные громкость и скорость сохраняются для следующего запуска";
                    variant: TextVariant.caption;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }

                Divider { }

                Rectangle {
                    height: 88px;
                    horizontal-stretch: 1;
                    background: transparent;

                    CompactToggleRow {
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                        width: min(parent.width - Theme.space-4, 280px);
                        height: Theme.space-10;
                        border-radius: Theme.radius-medium;
                        background: Theme.surface-control;
                        title: "Повторять список";
                        checked: root.folder-loop-enabled;
                        toggled(checked) => root.set-folder-loop(checked);
                    }

                    CompactToggleRow {
                        x: (parent.width - self.width) / 2;
                        y: Theme.space-12;
                        width: min(parent.width - Theme.space-4, 280px);
                        height: Theme.space-10;
                        border-radius: Theme.radius-medium;
                        background: Theme.surface-control;
                        title: "Случайный порядок";
                        checked: root.shuffle-enabled;
                        toggled => root.toggle-shuffle();
                    }
                }

                Divider { }

                UiText {
                    text: "История";
                    variant: TextVariant.caption;
                    color: Theme.text-muted;
                }

                Rectangle {
                    height: 156px;
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-large;
                    border-width: 1px;
                    border-color: root.playback-data-cleared
                        ? Theme.accent : Theme.border-default;
                    background: root.playback-data-cleared
                        ? Theme.accent-subtle : Theme.surface-control;

                    VerticalLayout {
                        padding: Theme.space-3;
                        spacing: Theme.space-2;

                        UiText {
                            text: "Недавние файлы";
                            variant: TextVariant.label;
                            horizontal-alignment: center;
                        }

                        UiText {
                            text: root.playback-data-cleared
                                ? "Ранее открытые файлы и места остановки удалены. Новая история появится, когда вы откроете следующий файл."
                                : "Здесь сохраняются недавно открытые файлы и места, на которых вы остановились. Это помогает быстро вернуться к просмотру или прослушиванию.";
                            variant: TextVariant.caption;
                            color: root.playback-data-cleared
                                ? Theme.text-secondary : Theme.text-muted;
                            height: 44px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        if !root.playback-data-cleared : Rectangle {
                            height: Theme.space-10 + Theme.space-1;
                            horizontal-stretch: 1;
                            background: transparent;

                            Button {
                                y: Theme.space-1;
                                width: parent.width;
                                height: Theme.space-10;
                                text: "Очистить историю";
                                clicked => root.request-clear-playback-data();
                            }
                        }

                        if root.playback-data-cleared : Rectangle {
                            height: Theme.space-10 + Theme.space-1;
                            horizontal-stretch: 1;
                            background: transparent;

                            Rectangle {
                                y: Theme.space-1;
                                width: parent.width;
                                height: Theme.space-10;
                                border-radius: Theme.radius-medium;
                                background: Theme.accent-subtle;

                                UiText {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "Готово — история очищена";
                                    variant: TextVariant.label;
                                    color: Theme.accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Divider { }

                UiText {
                    text: "Сброс";
                    variant: TextVariant.caption;
                    color: Theme.text-muted;
                }

                Rectangle {
                    height: 140px;
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-large;
                    border-width: 1px;
                    border-color: root.settings-reset-done
                        ? Theme.accent : Theme.border-default;
                    background: root.settings-reset-done
                        ? Theme.accent-subtle : Theme.surface-control;

                    VerticalLayout {
                        padding: Theme.space-3;
                        spacing: Theme.space-2;

                        UiText {
                            text: root.settings-reset-done
                                ? "Настройки восстановлены" : "Настройки по умолчанию";
                            variant: TextVariant.label;
                            horizontal-alignment: center;
                        }

                        UiText {
                            height: 36px;
                            text: root.settings-reset-done
                                ? "Исходные значения уже применены. История и медиафайлы сохранены."
                                : "Вернуть исходные оформление, воспроизведение и горячие клавиши.";
                            variant: TextVariant.caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        if !root.settings-reset-done : Button {
                            height: Theme.space-10;
                            horizontal-stretch: 1;
                            text: "Сбросить настройки…";
                            clicked => root.request-reset-settings();
                        }

                        if root.settings-reset-done : Rectangle {
                            height: Theme.space-10;
                            horizontal-stretch: 1;
                            border-radius: Theme.radius-medium;
                            background: Theme.accent-subtle;

                            UiText {
                                width: parent.width;
                                height: parent.height;
                                text: "Готово — настройки сброшены";
                                variant: TextVariant.label;
                                color: Theme.accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                }
            }
            }

            video-scroll := ScrollView {
                visible: (root.playback-open && root.settings-page == 2) || root.prewarming;
                x: 0px;
                width: parent.width;
                height: parent.height;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, root.video-content-height);

                video-viewport := Rectangle {
                    width: max(0px, video-scroll.visible-width
                        - Theme.space-8 - Theme.space-1);
                    height: root.video-content-height;
                    y: 0px;
                    background: transparent;
                    clip: true;

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: Theme.space-3;
                        alignment: start;

                        UiText {
                            text: "Параметры видео";
                            variant: TextVariant.caption;
                            color: Theme.text-muted;
                        }

                        if root.chapters.length > 0 : UiText {
                            text: "Главы";
                            variant: TextVariant.label;
                        }

                        if root.chapters.length > 0 : VerticalLayout {
                            spacing: Theme.space-2;

                            for chapter in root.chapters : Button {
                                height: Theme.space-10;
                                text: chapter.label;
                                selected: chapter.index == root.current-chapter-index;
                                clicked => root.select-chapter(chapter.index);
                            }
                        }

                        if root.chapters.length > 0 : Divider { }

                        UiText {
                            text: "Соотношение сторон";
                            variant: TextVariant.label;
                        }

                        VerticalLayout {
                            spacing: Theme.space-2;

                            HorizontalLayout {
                                height: Theme.space-10;
                                spacing: Theme.space-2;

                                for preset[index] in ["Исходное", "16:9", "4:3"] : Button {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    text: preset;
                                    selected: root.aspect-ratio-index == index;
                                    clicked => root.set-aspect-ratio(index);
                                }
                            }

                            HorizontalLayout {
                                height: Theme.space-10;
                                spacing: Theme.space-2;

                                for preset[index] in ["1.85:1", "2.39:1"] : Button {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    text: preset;
                                    selected: root.aspect-ratio-index == index + 3;
                                    clicked => root.set-aspect-ratio(index + 3);
                                }
                            }
                        }

                        Divider { }

                        SettingsRow {
                            height: Theme.space-12;
                            title: "Аппаратное декодирование";
                            description: !root.hardware-decoding-enabled
                                ? "Программное · " + (root.integrated-video-renderer ? "OpenGL" : "HWND")
                                : root.hardware-decoder == "" || root.hardware-decoder == "no"
                                    ? "Автовыбор: программное · " + (root.integrated-video-renderer ? "OpenGL" : "HWND")
                                    : root.hardware-decoder + " · " + (root.integrated-video-renderer ? "OpenGL" : "HWND");
                            Toggle {
                                checked: root.hardware-decoding-enabled;
                                toggled(checked) => root.set-hardware-decoding(checked);
                            }
                        }

                        Divider { }

                        UiText {
                            text: "Покадровая навигация";
                            variant: TextVariant.label;
                        }

                        HorizontalLayout {
                            height: Theme.space-10;
                            spacing: Theme.space-2;

                            Button {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                shortcut: ",";
                                text: "Назад";
                                clicked => root.step-frame(-1);
                            }
                            Button {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                shortcut: ".";
                                text: "Вперёд";
                                clicked => root.step-frame(1);
                            }
                        }

                        Divider { }

                        UiText {
                            text: "Субтитры";
                            variant: TextVariant.label;
                        }

                        VerticalLayout {
                            spacing: Theme.space-2;

                            Button {
                                height: Theme.space-10;
                                text: "Выключены";
                                selected: !root.subtitles-enabled;
                                clicked => root.select-subtitle-track(-1);
                            }

                            for track in root.subtitle-tracks : Button {
                                height: Theme.space-10;
                                text: track.label;
                                selected: track.selected;
                                clicked => root.select-subtitle-track(track.id);
                            }

                            Button {
                                height: Theme.space-10;
                                text: "Загрузить внешний файл…";
                                clicked => root.load-subtitle();
                            }
                        }

                        if root.subtitle-tracks.length > 0 : Divider { }

                        if root.subtitle-tracks.length > 0 : UiText {
                            text: "Синхронизация субтитров";
                            variant: TextVariant.label;
                        }

                        if root.subtitle-tracks.length > 0 : UiText {
                            text: "− раньше  ·  + позже";
                            variant: TextVariant.caption;
                            color: Theme.text-muted;
                        }

                        if root.subtitle-tracks.length > 0 : DelayControl {
                            value: root.subtitle-delay;
                            adjust(delta) => root.adjust-subtitle-delay(delta);
                            reset => root.reset-subtitle-delay();
                        }
                    }
                }
            }

            sound-scroll := ScrollView {
                visible: (root.playback-open && root.settings-page == 1) || root.prewarming;
                x: 0px;
                width: parent.width;
                height: parent.height;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, root.sound-content-height);

                sound-viewport := Rectangle {
                    width: max(0px, sound-scroll.visible-width
                        - Theme.space-8 - Theme.space-1);
                    height: root.sound-content-height;
                    y: 0px;
                    background: transparent;
                    clip: true;

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: Theme.space-4;

                        UiText {
                            text: "Настройки звука";
                            variant: TextVariant.caption;
                            color: Theme.text-muted;
                        }

                        if !root.media-loaded : UiText {
                            text: "Откройте медиафайл, чтобы настроить звук";
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }

                        if root.media-loaded : SettingsRow {
                            height: Theme.space-12;
                            title: "Эквалайзер";
                            description: root.equalizer-enabled
                                ? "Активен · защищён от перегрузки"
                                : "Обход · исходный звук";
                            Toggle {
                                checked: root.equalizer-enabled;
                                toggled(checked) => root.set-equalizer-enabled(checked);
                            }
                        }

                        if root.media-loaded : UiText {
                            text: "Профиль";
                            variant: TextVariant.label;
                        }

                        if root.media-loaded : VerticalLayout {
                            spacing: Theme.space-2;

                            HorizontalLayout {
                                height: Theme.space-10;
                                spacing: Theme.space-2;

                                for preset[index] in ["Ровный", "Бас", "Вокал"] : Button {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    text: preset;
                                    selected: root.equalizer-enabled
                                        && root.equalizer-preset-index == index;
                                    clicked => root.set-equalizer-preset(index);
                                }
                            }

                            HorizontalLayout {
                                height: Theme.space-10;
                                spacing: Theme.space-2;

                                for preset[index] in ["Рок", "Электро", "Свой"] : Button {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    text: preset;
                                    selected: root.equalizer-enabled
                                        && root.equalizer-preset-index == index + 3;
                                    clicked => root.set-equalizer-preset(index + 3);
                                }
                            }
                        }

                        if root.media-loaded : UiText {
                            text: "Предусиление";
                            variant: TextVariant.label;
                        }

                        if root.media-loaded : PreampControl {
                            value: root.equalizer-preamp-db;
                            enabled: root.equalizer-enabled;
                            reset-enabled: root.equalizer-preset-index != 0
                                || root.equalizer-preamp-db != 0;
                            adjust(delta) => root.adjust-equalizer-preamp(delta);
                            reset => root.reset-equalizer();
                        }

                        if root.media-loaded && root.equalizer-preset-index == 5 : UiText {
                            text: "Ручные полосы";
                            variant: TextVariant.label;
                        }

                        if root.media-loaded && root.equalizer-preset-index == 5 : UiText {
                            text: "Шаг 1 дБ · диапазон от −6 до +6 дБ";
                            variant: TextVariant.caption;
                            color: Theme.text-muted;
                        }

                        if root.media-loaded && root.equalizer-preset-index == 5 : VerticalLayout {
                            spacing: Theme.space-2;

                            for band[index] in root.equalizer-bands : EqualizerBandControl {
                                label: band.label;
                                gain-db: band.gain-db;
                                adjust(delta) => root.adjust-equalizer-band(index, delta);
                            }
                        }

                        if root.media-loaded : Divider { }

                        if root.audio-tracks.length > 0 : UiText {
                            text: "Аудиодорожка";
                            variant: TextVariant.label;
                        }

                        if root.audio-tracks.length == 1 : UiText {
                            text: root.audio-tracks[0].label;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }

                        if root.audio-tracks.length > 1 : VerticalLayout {
                            spacing: Theme.space-2;

                            for track in root.audio-tracks : Button {
                                height: Theme.space-10;
                                text: track.label;
                                selected: track.selected;
                                clicked => root.select-audio-track(track.id);
                            }
                        }

                        if root.audio-tracks.length > 0 : Divider { }

                        if root.media-loaded && !root.audio-media : UiText {
                            text: "Синхронизация звука";
                            variant: TextVariant.label;
                        }

                        if root.media-loaded && !root.audio-media : UiText {
                            text: "− раньше  ·  + позже";
                            variant: TextVariant.caption;
                            color: Theme.text-muted;
                        }

                        if root.media-loaded && !root.audio-media : DelayControl {
                            value: root.audio-delay;
                            adjust(delta) => root.adjust-audio-delay(delta);
                            reset => root.reset-audio-delay();
                        }

                        if root.media-loaded && !root.audio-media : Divider { }

                    }
                }
            }
        }
    }
}
