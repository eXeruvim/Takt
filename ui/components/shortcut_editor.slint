import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Button, Divider, UiText, TextVariant } from "../design_system/primitives.slint";

export struct ShortcutEntry {
    action: int,
    title: string,
    shortcut: string,
}

component ShortcutEditRow inherits Rectangle {
    in property <ShortcutEntry> entry;
    in property <bool> capturing;
    callback capture();

    height: 52px;
    border-radius: Theme.radius-medium;
    background: capturing ? Theme.surface-selected : transparent;
    border-width: capturing ? 1px : 0px;
    border-color: Theme.accent;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        alignment: center;

        UiText {
            text: root.entry.title;
            variant: TextVariant.label;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        Button {
            min-width: 156px;
            text: root.capturing ? "Нажмите сочетание…" : root.entry.shortcut;
            selected: root.capturing;
            clicked => root.capture();
        }
    }

    animate background, border-color {
        duration: Theme.motion-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
}

export component ShortcutEditorOverlay inherits Rectangle {
    in property <bool> open;
    in property <[ShortcutEntry]> shortcuts;
    in property <int> capture-action: -1;
    in property <string> error-message;
    callback begin-capture(int);
    callback reset-defaults();
    callback close();

    visible: open || self.opacity > 0.01;
    opacity: open ? 1 : 0;
    background: transparent;

    animate opacity {
        duration: Theme.motion-normal;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => root.close();
    }

    Rectangle {
        width: min(parent.width - Theme.space-8, 520px);
        height: max(0px, parent.height - self.y
            - Theme.player-controls-height - Theme.space-6);
        x: parent.width - self.width - Theme.space-4
            + (root.open ? 0px : Theme.space-8);
        y: Theme.space-4 + Theme.top-bar-height + Theme.space-2;
        border-radius: Theme.radius-xlarge;
        background: Theme.surface-glass-strong;
        border-width: 1px;
        border-color: Theme.border-glass;
        drop-shadow-color: Theme.shadow-high;
        drop-shadow-blur: Theme.elevation-high-blur;
        drop-shadow-offset-y: Theme.elevation-high-y;
        clip: true;

        animate x {
            duration: Theme.motion-normal;
            easing: cubic-bezier(0.16, 1, 0.3, 1);
        }

        TouchArea { width: parent.width; height: parent.height; }

        VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-3;

            UiText { text: "Горячие клавиши"; variant: TextVariant.title; }
            UiText {
                text: root.capture-action >= 0
                    ? "Нажмите новое сочетание. Esc отменяет ввод."
                    : "Выберите действие, затем нажмите новое сочетание клавиш.";
                color: root.capture-action >= 0 ? Theme.accent : Theme.text-secondary;
            }

            Divider { }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Theme.space-1;

                    for shortcut in root.shortcuts : ShortcutEditRow {
                        entry: shortcut;
                        capturing: shortcut.action == root.capture-action;
                        capture => root.begin-capture(shortcut.action);
                    }
                }
            }

            if root.error-message != "" : UiText {
                text: root.error-message;
                variant: TextVariant.caption;
                color: Theme.danger;
                wrap: word-wrap;
            }

            Divider { }

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: end;

                Button { text: "По умолчанию"; clicked => root.reset-defaults(); }
                Button { text: "Готово"; primary: true; clicked => root.close(); }
            }
        }
    }
}
