import { Theme } from "../theme.slint";
import { Button, Divider, Icon, UiText, TextVariant } from "../design_system/primitives.slint";

export component ResumePrompt inherits Rectangle {
    in property <bool> open: false;
    in property <string> file-name;
    in property <string> position-label;
    callback resume();
    callback restart();

    visible: open || self.opacity > 0.01;
    opacity: open ? 1 : 0;
    background: Theme.backdrop;

    animate opacity {
        duration: Theme.motion-normal;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }

    TouchArea { }

    dialog := Rectangle {
        width: min(parent.width - Theme.space-4 * 2, 520px);
        height: Theme.space-12 * 4;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.open ? 0px : Theme.space-3);
        border-radius: Theme.radius-xlarge;
        border-width: 1px;
        border-color: Theme.border-default;
        background: Theme.surface-modal;
        drop-shadow-color: Theme.shadow-high;
        drop-shadow-blur: Theme.elevation-high-blur;
        drop-shadow-offset-y: Theme.elevation-high-y;

        animate y {
            duration: Theme.motion-normal;
            easing: cubic-bezier(0.16, 1, 0.3, 1);
        }

        VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-3;

            HorizontalLayout {
                height: 84px;
                vertical-stretch: 0;
                spacing: Theme.space-4;

                Rectangle {
                    width: Theme.space-12;
                    background: transparent;

                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: Theme.space-12;
                        height: Theme.space-12;
                        border-radius: Theme.radius-large;
                        background: Theme.accent-subtle;
                        border-width: 1px;
                        border-color: Theme.accent;

                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../icons/play.svg");
                            tint: Theme.accent;
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.space-2;
                    alignment: center;

                    UiText {
                        text: "Продолжить воспроизведение?";
                        variant: TextVariant.title;
                        overflow: elide;
                    }

                    UiText {
                        text: root.file-name;
                        color: Theme.text-secondary;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        height: Theme.space-5;
                        vertical-stretch: 0;
                        spacing: Theme.space-1;
                        UiText {
                            text: "Сохранённая позиция";
                            color: Theme.text-muted;
                            variant: TextVariant.caption;
                            vertical-alignment: center;
                        }

                        UiText {
                            text: "· " + root.position-label;
                            color: Theme.accent;
                            variant: TextVariant.label;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                }
            }

            Divider { }

            HorizontalLayout {
                height: Theme.space-10;
                spacing: Theme.space-2;

                Rectangle { horizontal-stretch: 1; background: transparent; }

                Button {
                    width: 152px;
                    text: "Начать заново";
                    clicked => root.restart();
                }

                Button {
                    width: 152px;
                    text: "Продолжить";
                    primary: true;
                    clicked => root.resume();
                }
            }
        }
    }
}
