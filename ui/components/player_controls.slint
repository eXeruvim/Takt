import { Theme } from "../theme.slint";
import { IconButton, Slider } from "../design_system/primitives.slint";
import { Timeline } from "timeline.slint";

export component PlayerControls inherits Rectangle {
    in-out property <bool> is_playing;
    in-out property <string> time_pos;
    in-out property <string> time_duration;
    in-out property <float> progress;
    in-out property <float> volume;
    in-out property <bool> muted;
    in-out property <bool> loop_enabled;

    callback play_pause();
    callback stop();
    callback previous();
    callback next();
    callback seek(float);
    callback set_volume(float);
    callback toggle_mute();
    callback toggle_loop();
    callback open_file();
    callback open_folder();

    height: Theme.panel-height;
    border-radius: Theme.radius-large;
    background: Theme.surface-panel;
    border-width: 1px;
    border-color: Theme.border-default;

    VerticalLayout {
        padding-left: Theme.space-5;
        padding-right: Theme.space-5;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        spacing: Theme.space-3;

        Timeline {
            progress: root.progress;
            seek(value) => {
                root.seek(value);
            }
        }

        HorizontalLayout {
            spacing: Theme.space-3;

            IconButton {
                icon: @image-url("../icons/skip-back.svg");
                accessible-name: "Предыдущее видео";
                circular: true;
                clicked => root.previous();
            }

            IconButton {
                width: 52px;
                height: 52px;
                icon: root.is_playing ? @image-url("../icons/pause.svg") : @image-url("../icons/play.svg");
                accessible-name: root.is_playing ? "Пауза" : "Воспроизведение";
                primary: true;
                circular: true;
                clicked => root.play_pause();
            }

            IconButton {
                icon: @image-url("../icons/stop.svg");
                accessible-name: "Остановить";
                circular: true;
                clicked => root.stop();
            }

            IconButton {
                icon: @image-url("../icons/skip-forward.svg");
                accessible-name: "Следующее видео";
                circular: true;
                clicked => root.next();
            }

            Rectangle {
                width: 2px;
                height: 42px;
                background: Theme.border-subtle;
            }

            Rectangle {
                width: 132px;
                height: 34px;
                border-radius: Theme.radius-medium;
                background: root.loop_enabled ? Theme.accent : Theme.surface-hover;

                TouchArea {
                    clicked => root.toggle_loop();
                }

                Text {
                    text: root.loop_enabled ? "Повтор включен" : "Повтор";
                    color: root.loop_enabled ? Theme.on-accent : Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-small;
                }
            }

            IconButton {
                icon: !root.muted && root.volume > 0.0
                    ? @image-url("../icons/volume.svg")
                    : @image-url("../icons/volume-off.svg");
                accessible-name: root.muted ? "Включить звук" : "Выключить звук";
                circular: true;
                selected: root.muted;
                clicked => root.toggle_mute();
            }

            Rectangle {
                width: 1px;
                height: 34px;
                background: Theme.border-subtle;
            }

            Slider {
                width: 160px;
                value <=> root.volume;
                changed(value) => root.set_volume(value);
            }

            Rectangle {
                width: 1px;
                height: 42px;
                background: Theme.border-subtle;
            }

            IconButton {
                icon: @image-url("../icons/file-video.svg");
                accessible-name: "Открыть видео";
                circular: true;
                clicked => root.open_file();
            }

            IconButton {
                icon: @image-url("../icons/folder-open.svg");
                accessible-name: "Открыть папку";
                circular: true;
                clicked => root.open_folder();
            }

            Rectangle {
                width: 120px;
                background: transparent;

                Text {
                    text: root.time_pos + " / " + root.time_duration;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }
    }
}
