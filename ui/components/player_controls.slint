import { Theme } from "../theme.slint";
import { IconButton, Slider, UiText, TextVariant } from "../design_system/primitives.slint";
import { Timeline } from "timeline.slint";

export component PlayerControls inherits Rectangle {
    in-out property <bool> media_loaded;
    in-out property <bool> is_playing;
    in-out property <string> time_pos;
    in-out property <string> time_duration;
    in property <float> duration_seconds;
    in-out property <float> progress;
    in-out property <float> volume;
    in-out property <bool> muted;
    in property <bool> loop_enabled;
    in property <bool> edge_to_edge;
    in property <bool> fullscreen_active;
    in property <bool> playlist_open;
    in property <bool> info_open;
    in property <bool> settings_open;
    in property <bool> command_palette_open;
    private property <bool> show_remaining_time: true;
    out property <bool> show-volume-slider: self.width >= 1080px;
    out property <bool> show-secondary-actions: self.width >= 900px;
    callback open_file();
    callback open_folder();
    callback toggle_playlist();
    callback toggle_info();
    callback play_pause();
    callback previous();
    callback next();
    callback seek(float);
    callback set_volume(float);
    callback toggle_mute();
    callback toggle_loop();
    callback toggle_settings();
    callback toggle_fullscreen();
    callback show_more();

    height: Theme.player-controls-height;
    border-radius: 0px;
    background: transparent;
    border-width: 0px;

    deck := Rectangle {
        x: root.edge_to_edge ? 0px : Theme.space-3;
        y: 0px;
        width: parent.width - (root.edge_to_edge ? 0px : Theme.space-6);
        height: parent.height - (root.edge_to_edge ? 0px : Theme.space-2);
        border-radius: root.edge_to_edge ? 0px : Theme.radius-xlarge;
        background: Theme.surface-chrome;
        border-width: root.edge_to_edge ? 0px : 1px;
        border-color: Theme.border-glass;
        drop-shadow-color: root.edge_to_edge ? transparent : Theme.shadow-low;
        drop-shadow-blur: root.edge_to_edge ? 0px : Theme.elevation-low-blur;
        drop-shadow-offset-y: root.edge_to_edge ? 0px : Theme.elevation-low-y;

        timeline-row := Rectangle {
            x: Theme.space-3;
            y: 0px;
            width: parent.width - Theme.space-6;
            height: Theme.space-6;
            background: transparent;

            UiText {
                x: 0px;
                y: 0px;
                width: 64px;
                height: parent.height;
                text: root.time_pos;
                variant: TextVariant.caption;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            timeline := Timeline {
                x: 72px;
                y: 0px;
                width: parent.width - 144px;
                value <=> root.progress;
                duration-seconds: root.duration_seconds;
                enabled: root.media_loaded;
                seek(value) => root.seek(value);
            }

            right-time := Rectangle {
                x: parent.width - 64px;
                y: 0px;
                width: 64px;
                height: parent.height;
                background: transparent;
                accessible-role: button;
                accessible-label: root.show_remaining_time
                    ? "Показать полную длительность"
                    : "Показать оставшееся время";
                accessible-action-default => {
                    root.show_remaining_time = !root.show_remaining_time;
                }

                TouchArea {
                    clicked => {
                        root.show_remaining_time = !root.show_remaining_time;
                    }
                }

                UiText {
                    width: parent.width;
                    height: parent.height;
                    text: timeline.preview-visible
                        ? timeline.preview-time
                        : root.show_remaining_time && root.duration_seconds > 0
                            ? "−" + timeline.remaining-time
                            : root.time_duration;
                    variant: TextVariant.caption;
                    color: timeline.preview-visible ? Theme.accent : Theme.text-secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        controls-row := Rectangle {
            x: Theme.space-3;
            y: Theme.space-6;
            width: parent.width - Theme.space-6;
            height: Theme.space-12 - Theme.space-1;
            background: transparent;

            left-actions := Rectangle {
                x: 0px;
                y: 0px;
                width: root.show-secondary-actions ? 184px : 88px;
                height: parent.height;
                background: transparent;

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    spacing: Theme.space-2;
                    alignment: center;

                    IconButton {
                        icon: @image-url("../icons/file-media.svg");
                        accessible-name: "Открыть медиафайл";
                        circular: true;
                        capture-focus: false;
                        clicked => root.open_file();
                    }

                    if root.show-secondary-actions : IconButton {
                        icon: @image-url("../icons/folder-open.svg");
                        accessible-name: "Открыть папку";
                        circular: true;
                        capture-focus: false;
                        clicked => root.open_folder();
                    }

                    IconButton {
                        icon: @image-url("../icons/playlist.svg");
                        accessible-name: "Плейлист";
                        circular: true;
                        selected: root.playlist_open;
                        capture-focus: false;
                        clicked => root.toggle_playlist();
                    }

                    if root.show-secondary-actions : IconButton {
                        icon: @image-url("../icons/info.svg");
                        accessible-name: "Информация о файле";
                        circular: true;
                        selected: root.info_open;
                        capture-focus: false;
                        clicked => root.toggle_info();
                    }
                }
            }

            transport-actions := Rectangle {
                x: (parent.width - self.width) / 2;
                y: 0px;
                width: 152px;
                height: parent.height;
                background: transparent;

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    spacing: Theme.space-2;
                    alignment: center;

                    IconButton {
                        icon: @image-url("../icons/skip-back.svg");
                        accessible-name: "Предыдущий файл";
                        circular: true;
                        enabled: root.media_loaded;
                        capture-focus: false;
                        clicked => root.previous();
                    }

                    IconButton {
                        width: 44px;
                        height: 44px;
                        icon: root.is_playing ? @image-url("../icons/pause.svg") : @image-url("../icons/play.svg");
                        accessible-name: root.is_playing ? "Пауза" : "Воспроизведение";
                        primary: true;
                        circular: true;
                        enabled: root.media_loaded;
                        capture-focus: false;
                        clicked => root.play_pause();
                    }

                    IconButton {
                        icon: @image-url("../icons/skip-forward.svg");
                        accessible-name: "Следующий файл";
                        circular: true;
                        enabled: root.media_loaded;
                        capture-focus: false;
                        clicked => root.next();
                    }
                }
            }

            right-actions := Rectangle {
                width: root.show-volume-slider
                    ? 352px
                    : root.show-secondary-actions ? 232px : 184px;
                height: parent.height;
                x: parent.width - self.width;
                y: 0px;
                background: transparent;

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    spacing: Theme.space-2;
                    alignment: center;

                    IconButton {
                        icon: @image-url("../icons/repeat.svg");
                        accessible-name: root.loop_enabled ? "Выключить повтор" : "Включить повтор";
                        circular: true;
                        selected: root.loop_enabled;
                        capture-focus: false;
                        clicked => root.toggle_loop();
                    }

                    Rectangle {
                        width: root.show-volume-slider ? 160px : 40px;
                        height: Theme.space-10;
                        border-radius: Theme.radius-medium;
                        background: root.show-volume-slider ? Theme.surface-control : transparent;

                        HorizontalLayout {
                            spacing: Theme.space-2;
                            alignment: center;

                            IconButton {
                                icon: !root.muted && root.volume > 0.0
                                    ? @image-url("../icons/volume.svg")
                                    : @image-url("../icons/volume-off.svg");
                                accessible-name: root.muted ? "Включить звук" : "Выключить звук";
                                circular: true;
                                selected: root.muted;
                                capture-focus: false;
                                clicked => root.toggle_mute();
                            }

                            if root.show-volume-slider : Slider {
                                width: 112px;
                                value <=> root.volume;
                                changed(value) => root.set_volume(value);
                            }
                        }
                    }

                    IconButton {
                        icon: @image-url("../icons/settings.svg");
                        accessible-name: "Настройки воспроизведения";
                        circular: true;
                        selected: root.settings_open;
                        capture-focus: false;
                        clicked => root.toggle_settings();
                    }

                    if root.show-secondary-actions : IconButton {
                        icon: @image-url("../icons/maximize.svg");
                        accessible-name: root.fullscreen_active
                            ? "Выйти из полноэкранного режима"
                            : "Полноэкранный режим";
                        circular: true;
                        selected: root.fullscreen_active;
                        capture-focus: false;
                        clicked => root.toggle_fullscreen();
                    }

                    IconButton {
                        icon: @image-url("../icons/more-horizontal.svg");
                        accessible-name: "Другие команды";
                        circular: true;
                        selected: root.command_palette_open;
                        capture-focus: false;
                        clicked => root.show_more();
                    }
                }
            }
        }
    }
}
