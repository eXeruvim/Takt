import { Theme } from "../theme.slint";
import { IconButton, Slider, UiText, TextVariant } from "../design_system/primitives.slint";
import { Timeline } from "timeline.slint";

export component PlayerControls inherits Rectangle {
    in-out property <bool> media_loaded;
    in-out property <bool> is_playing;
    in-out property <string> time_pos;
    in-out property <string> time_duration;
    in property <float> duration_seconds;
    in-out property <float> progress;
    in-out property <float> volume;
    in-out property <bool> muted;
    in-out property <bool> loop_enabled;
    in property <bool> edge_to_edge: false;

    callback play_pause();
    callback stop();
    callback previous();
    callback next();
    callback seek(float);
    callback set_volume(float);
    callback toggle_mute();
    callback toggle_loop();

    height: Theme.player-controls-height;
    border-radius: edge_to_edge ? 0px : Theme.radius-large;
    background: Theme.surface-chrome;
    border-width: edge_to_edge ? 0px : 1px;
    border-color: Theme.border-glass;
    drop-shadow-color: edge_to_edge ? transparent : Theme.shadow-low;
    drop-shadow-blur: Theme.elevation-low-blur;
    drop-shadow-offset-y: Theme.elevation-low-y;

    timeline := Timeline {
        x: Theme.space-4;
        y: Theme.space-2;
        width: parent.width - Theme.space-8;
        value <=> root.progress;
        duration-seconds: root.duration_seconds;
        enabled: root.media_loaded;
        seek(value) => root.seek(value);
    }

    Rectangle {
        x: Theme.space-4;
        y: Theme.space-8;
        width: parent.width - Theme.space-8;
        height: Theme.space-12;
        background: transparent;

        UiText {
            x: 0px;
            width: 150px;
            height: parent.height;
            text: timeline.preview-visible
                ? "Перейти к " + timeline.preview-time
                : root.time_pos + " / " + root.time_duration;
            variant: TextVariant.caption;
            color: timeline.preview-visible ? Theme.accent : Theme.text-secondary;
            vertical-alignment: center;
        }

        HorizontalLayout {
            x: (parent.width - self.width) / 2;
            width: Theme.space-12 * 5;
            height: parent.height;
            spacing: Theme.space-2;
            alignment: center;

            IconButton {
                icon: @image-url("../icons/skip-back.svg");
                accessible-name: "Предыдущий файл";
                circular: true;
                enabled: root.media_loaded;
                capture-focus: false;
                clicked => root.previous();
            }

            IconButton {
                icon: @image-url("../icons/stop.svg");
                accessible-name: "Остановить";
                circular: true;
                enabled: root.media_loaded;
                capture-focus: false;
                clicked => root.stop();
            }

            IconButton {
                width: Theme.space-12;
                height: Theme.space-12;
                icon: root.is_playing ? @image-url("../icons/pause.svg") : @image-url("../icons/play.svg");
                accessible-name: root.is_playing ? "Пауза" : "Воспроизведение";
                primary: true;
                circular: true;
                enabled: root.media_loaded;
                capture-focus: false;
                clicked => root.play_pause();
            }

            IconButton {
                icon: @image-url("../icons/skip-forward.svg");
                accessible-name: "Следующий файл";
                circular: true;
                enabled: root.media_loaded;
                capture-focus: false;
                clicked => root.next();
            }

            IconButton {
                icon: @image-url("../icons/repeat.svg");
                accessible-name: root.loop_enabled ? "Выключить повтор" : "Включить повтор";
                circular: true;
                selected: root.loop_enabled;
                enabled: root.media_loaded;
                capture-focus: false;
                clicked => root.toggle_loop();
            }
        }

        Rectangle {
            width: parent.width > 900px ? 208px : Theme.space-10;
            height: parent.height;
            x: parent.width - self.width;
            background: transparent;

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: center;

                IconButton {
                    icon: !root.muted && root.volume > 0.0
                        ? @image-url("../icons/volume.svg")
                        : @image-url("../icons/volume-off.svg");
                    accessible-name: root.muted ? "Включить звук" : "Выключить звук";
                    circular: true;
                    selected: root.muted;
                    capture-focus: false;
                    clicked => root.toggle_mute();
                }

                if parent.width > 100px : Slider {
                    width: 152px;
                    value <=> root.volume;
                    changed(value) => root.set_volume(value);
                }
            }
        }
    }
}
