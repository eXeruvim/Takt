import { Theme } from "../theme.slint";
import { IconButton, Slider, UiText, TextVariant } from "../design_system/primitives.slint";
import { Timeline } from "timeline.slint";

export component PlayerControls inherits Rectangle {
    in-out property <bool> media_loaded;
    in-out property <bool> is_playing;
    in-out property <string> time_pos;
    in-out property <string> time_duration;
    in property <float> duration_seconds;
    in-out property <float> progress;
    in-out property <float> volume;
    in-out property <bool> muted;
    in property <bool> volume-feedback-visible: false;
    in property <bool> loop_enabled;
    in property <bool> edge_to_edge;
    in property <bool> fullscreen_active;
    in property <bool> playlist_open;
    in property <bool> info_open;
    in property <bool> settings_open;
    in property <bool> command_palette_open;
    in property <bool> converter_open;
    in property <bool> picture_in_picture_active;
    in property <string> next_file;
    private property <bool> show_remaining_time: true;
    out property <bool> show-volume-slider: self.width >= 1080px;
    out property <bool> compact-volume-visible: !show-volume-slider
        && (volume-button.has-hover || compact-volume-hover.has-hover
            || compact-volume-slider.has-hover || compact-volume-slider.is-dragging);
    out property <bool> show-secondary-actions: self.width >= 900px;
    out property <length> group-spacing: self.width >= 1800px
        ? Theme.space-5
        : self.width >= 1100px ? Theme.space-3 : Theme.space-2;
    out property <length> left-actions-width: show-secondary-actions
        ? 200px + group-spacing * 4
        : 120px + group-spacing * 2;
    out property <length> side-zone-width: show-volume-slider
        ? 360px + group-spacing * 5
        : show-secondary-actions
            ? 240px + group-spacing * 5
            : 160px + group-spacing * 3;
    callback open_file();
    callback open_folder();
    callback toggle_playlist();
    callback toggle_info();
    callback play_pause();
    callback previous();
    callback next();
    callback seek(float);
    callback set_volume(float);
    callback toggle_mute();
    callback toggle_loop();
    callback toggle_settings();
    callback toggle_fullscreen();
    callback toggle_picture_in_picture();
    callback show_more();
    callback open_converter();

    height: Theme.player-controls-height;
    border-radius: 0px;
    background: transparent;
    border-width: 0px;

    deck := Rectangle {
        property <length> controls-width: min(
            self.width - Theme.space-6,
            max(min(self.width * 0.52, 1040px), root.side-zone-width * 2 + 192px)
        );
        property <length> timeline-width: min(
            self.width - Theme.space-6,
            max(self.width * 0.8, controls-width + Theme.space-12 * 2)
        );
        property <length> content-height: 68px;
        property <length> content-y: (self.height - content-height) / 2;

        x: root.edge_to_edge ? 0px : Theme.space-3;
        y: 0px;
        width: parent.width - (root.edge_to_edge ? 0px : Theme.space-6);
        height: parent.height - (root.edge_to_edge ? 0px : Theme.space-2);
        border-radius: root.edge_to_edge ? 0px : Theme.radius-xlarge;
        background: Theme.surface-player-controls;
        border-width: root.edge_to_edge ? 0px : 1px;
        border-color: Theme.border-glass;
        drop-shadow-color: root.edge_to_edge ? transparent : Theme.shadow-low;
        drop-shadow-blur: root.edge_to_edge ? 0px : Theme.elevation-low-blur;
        drop-shadow-offset-y: root.edge_to_edge ? 0px : Theme.elevation-low-y;

        timeline-row := Rectangle {
            x: (parent.width - self.width) / 2;
            y: deck.content-y;
            width: deck.timeline-width;
            height: Theme.space-6;
            background: transparent;

            UiText {
                x: 0px;
                y: 0px;
                width: 64px;
                height: parent.height;
                text: root.time_pos;
                variant: TextVariant.caption;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            timeline := Timeline {
                x: 72px;
                y: 0px;
                width: parent.width - 144px;
                value <=> root.progress;
                duration-seconds: root.duration_seconds;
                enabled: root.media_loaded;
                seek(value) => root.seek(value);
            }

            right-time := Rectangle {
                x: parent.width - 64px;
                y: 0px;
                width: 64px;
                height: parent.height;
                background: transparent;
                accessible-role: button;
                accessible-label: root.show_remaining_time
                    ? "Показать полную длительность"
                    : "Показать оставшееся время";
                accessible-action-default => {
                    root.show_remaining_time = !root.show_remaining_time;
                }

                TouchArea {
                    clicked => {
                        root.show_remaining_time = !root.show_remaining_time;
                    }
                }

                UiText {
                    width: parent.width;
                    height: parent.height;
                    text: timeline.preview-visible
                        ? timeline.preview-time
                        : root.show_remaining_time && root.duration_seconds > 0
                            ? "−" + timeline.remaining-time
                            : root.time_duration;
                    variant: TextVariant.caption;
                    color: timeline.preview-visible ? Theme.accent : Theme.text-secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        controls-row := Rectangle {
            x: (parent.width - self.width) / 2;
            y: deck.content-y + Theme.space-6;
            width: deck.controls-width;
            height: Theme.space-12 - Theme.space-1;
            background: transparent;

            left-actions := Rectangle {
                visible: !root.picture_in_picture_active;
                x: 0px;
                y: 0px;
                width: root.side-zone-width;
                height: parent.height;
                background: transparent;

                left-action-items := Rectangle {
                    x: parent.width - self.width;
                    y: 0px;
                    width: root.left-actions-width;
                    height: parent.height;
                    background: transparent;

                    HorizontalLayout {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        spacing: root.group-spacing;
                        alignment: center;

                        IconButton {
                            icon: @image-url("../icons/file-media.svg");
                            accessible-name: "Открыть медиафайл";
                            circular: true;
                            capture-focus: false;
                            clicked => root.open_file();
                        }

                        if root.show-secondary-actions : IconButton {
                            icon: @image-url("../icons/folder-open.svg");
                            accessible-name: "Открыть папку";
                            circular: true;
                            capture-focus: false;
                            clicked => root.open_folder();
                        }

                        IconButton {
                            icon: @image-url("../icons/playlist.svg");
                            accessible-name: "Плейлист";
                            circular: true;
                            selected: root.playlist_open;
                            capture-focus: false;
                            clicked => root.toggle_playlist();
                        }

                        if root.show-secondary-actions : IconButton {
                            icon: @image-url("../icons/info.svg");
                            accessible-name: "Информация о файле";
                            circular: true;
                            selected: root.info_open;
                            capture-focus: false;
                            clicked => root.toggle_info();
                        }

                        IconButton {
                            icon: @image-url("../icons/convert.svg");
                            accessible-name: "Конвертация медиа";
                            circular: true;
                            selected: root.converter_open;
                            capture-focus: false;
                            clicked => root.open_converter();
                        }
                    }
                }
            }

            transport-actions := Rectangle {
                visible: !root.picture_in_picture_active;
                x: (parent.width - self.width) / 2;
                y: 0px;
                width: 124px + root.group-spacing * 2;
                height: parent.height;
                background: transparent;

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    spacing: root.group-spacing;
                    alignment: center;

                    IconButton {
                        icon: @image-url("../icons/skip-back.svg");
                        accessible-name: "Предыдущий файл";
                        circular: true;
                        enabled: root.media_loaded;
                        capture-focus: false;
                        clicked => root.previous();
                    }

                    IconButton {
                        width: 44px;
                        height: 44px;
                        icon: root.is_playing ? @image-url("../icons/pause.svg") : @image-url("../icons/play.svg");
                        accessible-name: root.is_playing ? "Пауза" : "Воспроизведение";
                        primary: true;
                        circular: true;
                        enabled: root.media_loaded;
                        capture-focus: false;
                        clicked => root.play_pause();
                    }

                    next-button := IconButton {
                        icon: @image-url("../icons/skip-forward.svg");
                        accessible-name: root.next_file == ""
                            ? "Следующий файл"
                            : "Следующий файл: " + root.next_file;
                        circular: true;
                        enabled: root.media_loaded;
                        capture-focus: false;
                        clicked => root.next();
                    }
                }

                next-preview := Rectangle {
                    visible: next-button.has-hover || self.opacity > 0.01;
                    opacity: next-button.has-hover && root.next_file != "" ? 1 : 0;
                    x: next-button.x + (next-button.width - self.width) / 2;
                    y: -self.height - Theme.space-2;
                    width: min(300px, root.width - Theme.space-8);
                    height: 52px;
                    border-radius: Theme.radius-large;
                    background: Theme.surface-popover;
                    border-width: 1px;
                    border-color: Theme.border-default;
                    drop-shadow-color: Theme.shadow-high;
                    drop-shadow-blur: Theme.elevation-low-blur;
                    drop-shadow-offset-y: Theme.elevation-low-y;
                    clip: true;

                    UiText {
                        x: Theme.space-3;
                        y: Theme.space-1;
                        width: parent.width - Theme.space-6;
                        height: Theme.space-4;
                        text: "СЛЕДУЮЩИЙ ФАЙЛ";
                        variant: TextVariant.caption;
                        font-size: Theme.text-xs;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }

                    UiText {
                        x: Theme.space-3;
                        y: Theme.space-5;
                        width: parent.width - Theme.space-6;
                        height: Theme.space-6;
                        text: root.next_file;
                        variant: TextVariant.label;
                        color: Theme.text-primary;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    animate opacity {
                        duration: Theme.motion-fast;
                        easing: cubic-bezier(0.2, 0, 0, 1);
                    }
                }
            }

            right-actions := Rectangle {
                visible: !root.picture_in_picture_active;
                width: root.side-zone-width;
                height: parent.height;
                x: parent.width - self.width;
                y: 0px;
                background: transparent;

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    spacing: root.group-spacing;
                    alignment: center;

                    IconButton {
                        icon: @image-url("../icons/repeat.svg");
                        accessible-name: root.loop_enabled ? "Выключить повтор" : "Включить повтор";
                        circular: true;
                        selected: root.loop_enabled;
                        capture-focus: false;
                        clicked => root.toggle_loop();
                    }

                    volume-control := Rectangle {
                        width: root.show-volume-slider ? 160px : 40px;
                        height: Theme.space-10;
                        border-radius: Theme.radius-medium;
                        background: root.show-volume-slider ? Theme.surface-control : transparent;

                        HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            spacing: Theme.space-2;
                            alignment: center;

                            volume-button := IconButton {
                                icon: !root.muted && root.volume > 0.0
                                    ? @image-url("../icons/volume.svg")
                                    : @image-url("../icons/volume-off.svg");
                                accessible-name: root.muted ? "Включить звук" : "Выключить звук";
                                circular: true;
                                selected: root.muted;
                                capture-focus: false;
                                opacity: root.volume-feedback-visible ? 0 : 1;
                                clicked => root.toggle_mute();

                                animate opacity {
                                    duration: Theme.motion-fast;
                                    easing: cubic-bezier(0.2, 0, 0, 1);
                                }
                            }

                            if root.show-volume-slider : Rectangle {
                                width: 112px;
                                height: parent.height;
                                background: transparent;

                                Slider {
                                    x: 0px;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width;
                                    value <=> root.volume;
                                    changed(value) => root.set_volume(value);
                                }
                            }
                        }

                        volume-value := Rectangle {
                            x: 0px;
                            y: 0px;
                            width: Theme.space-10;
                            height: Theme.space-10;
                            visible: root.volume-feedback-visible || self.opacity > 0.01;
                            opacity: root.volume-feedback-visible ? 1 : 0;
                            background: transparent;

                            UiText {
                                width: parent.width;
                                height: parent.height;
                                text: Math.round(root.volume * 100) + "%";
                                font-size: Theme.text-body;
                                font-weight: 600;
                                color: Theme.accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            animate opacity {
                                duration: Theme.motion-normal;
                                easing: cubic-bezier(0.2, 0, 0, 1);
                            }
                        }

                        compact-volume-popover := Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: root.compact-volume-visible ? -self.height : -self.height + 4px;
                            width: 168px;
                            height: 56px;
                            visible: root.compact-volume-visible || self.opacity > 0.01;
                            opacity: root.compact-volume-visible ? 1 : 0;
                            background: transparent;

                            compact-volume-hover := TouchArea {
                                width: parent.width;
                                height: parent.height;
                            }

                            Rectangle {
                                width: parent.width;
                                height: 48px;
                                border-radius: Theme.radius-large;
                                background: Theme.surface-popover;
                                border-width: 1px;
                                border-color: Theme.border-default;
                                drop-shadow-color: Theme.shadow-high;
                                drop-shadow-blur: Theme.elevation-low-blur;
                                drop-shadow-offset-y: Theme.elevation-low-y;
                            }

                            compact-volume-slider := Slider {
                                x: Theme.space-4;
                                y: Theme.space-3;
                                width: parent.width - Theme.space-8;
                                value <=> root.volume;
                                expand-on-hover: true;
                                changed(value) => root.set_volume(value);
                            }

                            animate opacity, y {
                                duration: Theme.motion-normal;
                                easing: cubic-bezier(0.16, 1, 0.3, 1);
                            }
                        }
                    }

                    IconButton {
                        icon: @image-url("../icons/settings.svg");
                        accessible-name: "Настройки воспроизведения";
                        circular: true;
                        selected: root.settings_open;
                        capture-focus: false;
                        clicked => root.toggle_settings();
                    }

                    if root.show-secondary-actions : IconButton {
                        icon: @image-url("../icons/picture-in-picture.svg");
                        accessible-name: "Картинка в картинке";
                        circular: true;
                        selected: root.picture_in_picture_active;
                        capture-focus: false;
                        clicked => root.toggle_picture_in_picture();
                    }

                    if root.show-secondary-actions : IconButton {
                        icon: @image-url("../icons/maximize.svg");
                        accessible-name: root.fullscreen_active
                            ? "Выйти из полноэкранного режима"
                            : "Полноэкранный режим";
                        circular: true;
                        selected: root.fullscreen_active;
                        capture-focus: false;
                        clicked => root.toggle_fullscreen();
                    }

                    IconButton {
                        icon: @image-url("../icons/keyboard.svg");
                        accessible-name: "Команды и горячие клавиши";
                        circular: true;
                        selected: root.command_palette_open;
                        capture-focus: false;
                        clicked => root.show_more();
                    }
                }
            }

            if root.picture_in_picture_active : Rectangle {
                x: (parent.width - self.width) / 2;
                y: 0px;
                width: 172px;
                height: parent.height;
                background: transparent;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: Theme.space-1;
                    alignment: center;

                    IconButton {
                        icon: @image-url("../icons/skip-back.svg");
                        accessible-name: "Предыдущий файл";
                        circular: true;
                        enabled: root.media_loaded;
                        capture-focus: false;
                        clicked => root.previous();
                    }
                    IconButton {
                        width: 44px;
                        height: 44px;
                        icon: root.is_playing
                            ? @image-url("../icons/pause.svg")
                            : @image-url("../icons/play.svg");
                        accessible-name: root.is_playing ? "Пауза" : "Воспроизведение";
                        primary: true;
                        circular: true;
                        enabled: root.media_loaded;
                        capture-focus: false;
                        clicked => root.play_pause();
                    }
                    IconButton {
                        icon: @image-url("../icons/skip-forward.svg");
                        accessible-name: "Следующий файл";
                        circular: true;
                        enabled: root.media_loaded;
                        capture-focus: false;
                        clicked => root.next();
                    }
                    IconButton {
                        icon: @image-url("../icons/picture-in-picture.svg");
                        accessible-name: "Вернуться в основное окно";
                        circular: true;
                        selected: true;
                        capture-focus: false;
                        clicked => root.toggle_picture_in_picture();
                    }
                }
            }
        }
    }
}
