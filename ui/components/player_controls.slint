import { Theme } from "../theme.slint";
import { Timeline } from "timeline.slint";

export component PlayerControls inherits Rectangle {
    in-out property <bool> is_playing;
    in-out property <string> time_pos;
    in-out property <string> time_duration;
    in-out property <float> progress;
    in-out property <float> volume;
    in-out property <bool> muted;
    in-out property <bool> loop_enabled;

    callback play_pause();
    callback stop();
    callback previous();
    callback next();
    callback seek(float);
    callback set_volume(float);
    callback toggle_mute();
    callback toggle_loop();
    callback open_file();
    callback open_folder();

    height: Theme.panel-height;
    border-radius: Theme.radius-large;
    background: Theme.surface-panel;
    border-width: 1px;
    border-color: Theme.border-default;

    VerticalLayout {
        padding-left: Theme.space-5;
        padding-right: Theme.space-5;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        spacing: Theme.space-3;

        Timeline {
            progress: root.progress;
            seek(value) => {
                root.seek(value);
            }
        }

        HorizontalLayout {
            spacing: Theme.space-3;

            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: Theme.radius-full;
                background: Theme.surface-hover;

                TouchArea {
                    clicked => {
                        root.previous();
                    }
                }

                Text {
                    text: "⏮";
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-large;
                }
            }

            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: Theme.radius-full;
                background: Theme.accent;

                TouchArea {
                    clicked => {
                        root.play_pause();
                    }
                }

                Text {
                    text: root.is_playing ? "⏸" : "▶";
                    color: Theme.on-accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-large;
                }
            }

            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: Theme.radius-full;
                background: Theme.surface-hover;

                TouchArea {
                    clicked => {
                        root.stop();
                    }
                }

                Text {
                    text: "⏹";
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-large;
                }
            }

            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: Theme.radius-full;
                background: Theme.surface-hover;

                TouchArea {
                    clicked => {
                        root.next();
                    }
                }

                Text {
                    text: "⏭";
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-large;
                }
            }

            Rectangle {
                width: 2px;
                height: 42px;
                background: Theme.border-subtle;
            }

            Rectangle {
                width: 132px;
                height: 34px;
                border-radius: Theme.radius-medium;
                background: root.loop_enabled ? Theme.accent : Theme.surface-hover;

                TouchArea {
                    clicked => root.toggle_loop();
                }

                Text {
                    text: root.loop_enabled ? "Повтор включен" : "Повтор";
                    color: root.loop_enabled ? Theme.on-accent : Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-small;
                }
            }

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: Theme.radius-full;
                background: Theme.surface-hover;

                TouchArea {
                    clicked => root.toggle_mute();
                }

                Text {
                    text: !root.muted && root.volume > 0.0 ? "🔊" : "🔇";
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-large;
                }
            }

            Rectangle {
                width: 1px;
                height: 34px;
                background: Theme.border-subtle;
            }

            Rectangle {
                width: 160px;
                height: 6px;
                border-radius: Theme.radius-full;
                background: Theme.border-default;

                Rectangle {
                    width: parent.width * root.volume;
                    height: parent.height;
                    border-radius: Theme.radius-full;
                    background: Theme.accent;
                }

                TouchArea {
                    clicked => {
                        root.set_volume(self.mouse-x / self.width);
                    }
                }
            }

            Rectangle {
                width: 1px;
                height: 42px;
                background: Theme.border-subtle;
            }

            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: Theme.radius-full;
                background: Theme.surface-hover;

                TouchArea {
                    clicked => root.open_file();
                }

                Text {
                    text: "📄";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.text-primary;
                    font-size: Theme.text-large;
                }
            }

            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: Theme.radius-full;
                background: Theme.surface-hover;

                TouchArea {
                    clicked => root.open_folder();
                }

                Text {
                    text: "📁";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.text-primary;
                    font-size: Theme.text-large;
                }
            }

            Rectangle {
                width: 120px;
                background: transparent;

                Text {
                    text: root.time_pos + " / " + root.time_duration;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }
    }
}
