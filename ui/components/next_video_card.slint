import { Theme } from "../theme.slint";
import { Icon, UiText, TextVariant } from "../design_system/primitives.slint";

export component NextVideoCard inherits Rectangle {
    in-out property <bool> card_visible;
    in-out property <string> next_file;
    in property <length> parent_width;
    in property <length> parent_height;
    callback play_next();

    width: min(280px, parent_width - Theme.space-8);
    height: 76px;
    x: card_visible
        ? parent_width - self.width - Theme.space-4
        : parent_width + Theme.space-5;
    y: parent_height - self.height - Theme.player-controls-height - Theme.space-8;
    border-radius: Theme.radius-medium;
    background: hit.pressed ? Theme.surface-pressed
        : hit.has-hover ? Theme.surface-glass-hover
        : Theme.surface-glass;
    border-width: 1px;
    border-color: hit.has-hover ? Theme.border-default : Theme.border-glass;
    drop-shadow-color: Theme.shadow-low;
    drop-shadow-blur: Theme.elevation-low-blur;
    drop-shadow-offset-y: Theme.elevation-low-y;
    accessible-role: button;
    accessible-label: "Следующий файл: " + next_file;

    hit := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => root.play_next();
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        alignment: center;

        Icon {
            source: @image-url("../icons/skip-forward.svg");
            size: Theme.icon-medium;
            tint: Theme.text-secondary;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.space-1;

            UiText {
                text: "Далее";
                variant: TextVariant.caption;
                color: Theme.text-muted;
            }
            UiText {
                text: root.next_file;
                variant: TextVariant.label;
                overflow: elide;
            }
        }
    }

    animate x, background, border-color { duration: Theme.motion-normal; easing: ease-out; }
}
