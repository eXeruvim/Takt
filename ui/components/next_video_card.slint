import { Theme } from "../theme.slint";
import { Button } from "../design_system/primitives.slint";

export component NextVideoCard inherits Rectangle {

    in-out property <bool> card_visible;
    in-out property <string> next_file;

    in property <length> parent_width;
    in property <length> parent_height;

    callback play_next();


    width: 320px;
    height: 140px;


    border-radius: Theme.radius-large;


    x: card_visible
        ? parent_width - self.width - 24px
        : parent_width + 40px;


    y: parent_height - self.height - 140px;


    background: Theme.surface-glass-strong;


    border-width: 1px;
    border-color: Theme.border-default;
    drop-shadow-color: Theme.shadow-high;
    drop-shadow-blur: Theme.elevation-high-blur;
    drop-shadow-offset-y: Theme.elevation-high-y;


    animate x {
        duration: Theme.motion-slow;
        easing: ease-in-out;
    }


    VerticalLayout {

        padding: Theme.space-4;
        spacing: Theme.space-2;


        Text {
            text: "Следующий файл";

            color: Theme.text-secondary;
        }


        Text {
            text: next_file;

            color: Theme.text-primary;
        }


        Button {
            text: "Смотреть";
            primary: true;
            clicked => root.play_next();
        }
    }
}
