import { Theme } from "../theme.slint";

export component SettingsDrawer inherits Rectangle {
    in-out property <bool> drawer_visible;
    in-out property <float> speed;
    in-out property <bool> loop_enabled;
    in-out property <bool> folder_loop_enabled;
    in-out property <bool> shuffle_enabled;

    in property <length> parent_width;
    in property <length> parent_height;

    callback set_speed(float);
    callback toggle_loop();
    callback toggle_folder_loop();
    callback toggle_shuffle();

    width: 320px;
    height: parent_height;
    x: drawer_visible ? parent_width - self.width : parent_width + 20px;
    background: Theme.surface-elevated;
    border-width: 1px;
    border-color: Theme.border-default;

    animate x {
        duration: Theme.motion-slow;
        easing: ease-in-out;
    }

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-5;

        Text {
            text: "Настройки";
            color: Theme.text-primary;
            font-size: Theme.text-heading;
            font-weight: 700;
        }

        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        Text {
            text: "Скорость";
            color: Theme.text-secondary;
        }

        HorizontalLayout {
            spacing: Theme.space-2;

            for value in [
                "0.5",
                "0.75",
                "1.0",
                "1.25",
                "1.5",
                "2.0"
            ] : Rectangle {
                height: 34px;
                border-radius: Theme.radius-small;
                background: speed == value.to-float() ? Theme.accent : Theme.surface-hover;

                TouchArea {
                    clicked => {
                        root.set_speed(value.to-float());
                    }
                }

                Text {
                    text: value + "x";
                    color: speed == value.to-float() ? Theme.on-accent : Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        Rectangle {
            height: 44px;
            border-radius: Theme.radius-medium;
            background: loop_enabled ? Theme.accent : Theme.surface-hover;

            TouchArea {
                clicked => {
                    root.toggle_loop();
                }
            }

            Text {
                text: loop_enabled ? "Повтор файла включён" : "Повтор файла";
                color: loop_enabled ? Theme.on-accent : Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            height: 44px;
            border-radius: Theme.radius-medium;
            background: folder_loop_enabled ? Theme.accent : Theme.surface-hover;

            TouchArea {
                clicked => {
                    root.toggle_folder_loop();
                }
            }

            Text {
                text: folder_loop_enabled ? "Повтор папки включён" : "Повтор папки";
                color: folder_loop_enabled ? Theme.on-accent : Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            height: 44px;
            border-radius: Theme.radius-medium;
            background: shuffle_enabled ? Theme.accent : Theme.surface-hover;

            TouchArea {
                clicked => {
                    root.toggle_shuffle();
                }
            }

            Text {
                text: shuffle_enabled ? "Случайный порядок включён" : "Случайный порядок";
                color: shuffle_enabled ? Theme.on-accent : Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}
