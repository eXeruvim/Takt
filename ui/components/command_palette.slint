import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Button, Divider, UiText, TextVariant } from "../design_system/primitives.slint";
import { ShortcutField, ExpandedShortcutEditor } from "command_shortcut_editor.slint";

export enum ShortcutCapturePhase {
    idle,
    recording,
    valid,
    conflict,
}

export struct CommandEntry {
    action: int,
    title: string,
    description: string,
    shortcut: string,
    default-shortcut: string,
    requires-media: bool,
    shortcut-editable: bool,
}

component PaletteHint inherits HorizontalLayout {
    in property <string> key;
    in property <string> description;
    spacing: 6px;
    horizontal-stretch: 0;
    Rectangle {
        width: max(28px, root.key.character-count * 7px + 14px);
        height: 22px;
        border-radius: 4px;
        background: Theme.surface-control;
        border-width: 1px;
        border-color: Theme.border-default;
        UiText {
            text: root.key;
            font-size: Theme.text-small;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    UiText {
        text: root.description;
        variant: TextVariant.caption;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
}

component CommandRow inherits Rectangle {
    in property <CommandEntry> entry;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> can-execute;
    in property <bool> active;
    in property <bool> editing;
    in property <bool> saved;
    in property <bool> blocked;
    in property <bool> recording;
    in property <bool> can-save;
    in property <bool> candidate-valid;
    in property <string> preview;
    in property <string> error-message;
    in property <bool> can-restore;
    in property <int> warning-request;
    callback activate();
    callback edit();
    callback save(bool);
    callback input-focus-changed(bool);
    callback warning-finished();
    callback restore-default();
    callback geometry-changed(length, length);

    private property <length> editor-height: root.editing
        ? (root.error-message != "" ? 92px : 66px) : 0px;
    private property <int> editor-focus-request;
    private property <bool> editor-focus-backward;
    function focus-editor(backward: bool) {
        root.editor-focus-backward = backward;
        root.editor-focus-request += 1;
    }
    height: 56px + root.editor-height;
    clip: true;
    animate editor-height {
        duration: Theme.motion-gentle;
        easing: cubic-bezier(0.16, 1, 0.3, 1);
    }
    changed y => root.geometry-changed(root.y, root.height);
    changed height => root.geometry-changed(root.y, root.height);
    changed selected => { if (selected) { root.geometry-changed(root.y, root.height); } }
    border-radius: Theme.radius-medium;
    background: root.editor-height > 0px ? Theme.surface-control : transparent;
    accessible-role: list-item;
    accessible-label: entry.title + ", сочетание " + entry.shortcut;
    accessible-enabled: !blocked && (enabled || editing);
    accessible-action-default => { if (enabled) { root.activate(); } }
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 56px;
        // Only the outer card clips corners while its editor is expanded.
        border-radius: root.editor-height > 0px ? 0px : Theme.radius-medium;
        background: root.saved ? Theme.success-subtle
            : root.selected ? Theme.accent-subtle
            : hit.pressed ? Theme.surface-pressed
            : hit.has-hover ? Theme.surface-hover : transparent;
        animate background { duration: Theme.motion-normal; }
    }
    hit := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 56px;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => root.activate();
    }
    if root.selected : Rectangle {
        x: 0px;
        y: Theme.space-2;
        width: 3px;
        height: 56px - Theme.space-4;
        background: root.saved ? Theme.success : Theme.surface-selected;

        animate background { duration: Theme.motion-normal; }
    }
    HorizontalLayout {
        // A fixed-height layout otherwise centers itself in the expanded row.
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 56px;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: Theme.space-3;
        VerticalLayout {
            min-width: 0px;
            horizontal-stretch: 1;
            opacity: root.can-execute || root.editing ? 1 : 0.5;
            spacing: Theme.space-1;
            UiText { text: root.entry.title; variant: TextVariant.label; overflow: elide; }
            UiText {
                text: root.entry.description;
                variant: TextVariant.caption;
                font-size: 13px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        shortcut-field := ShortcutField {
            visible: root.entry.shortcut-editable;
            width: root.entry.shortcut-editable ? 320px : 0px;
            shortcut: root.entry.shortcut;
            highlighted: root.selected;
            enabled: (root.enabled || root.editing) && !root.blocked;
            active: root.active;
            editing: root.editing;
            saved: root.saved;
            can-restore: root.can-restore;
            default-shortcut: root.entry.default-shortcut;
            edit => { if (root.editing) { root.activate(); } else { root.edit(); } }
            restore-default => {
                root.restore-default();
                root.focus-editor(true);
            }
            return-to-editor(backward) => root.focus-editor(backward);
        }
    }
    if root.editing : editor := ExpandedShortcutEditor {
        x: 0px;
        y: 56px;
        width: parent.width;
        editing: root.editing;
        blocked: root.blocked;
        active: root.active;
        recording: root.recording;
        can-save: root.can-save;
        candidate-valid: root.candidate-valid;
        can-restore: root.can-restore;
        warning-request: root.warning-request;
        preview: root.preview;
        default-shortcut: root.entry.default-shortcut;
        error-message: root.error-message;
        focus-request: root.editor-focus-request;
        focus-backward: root.editor-focus-backward;
        input-focus-changed(focused) => root.input-focus-changed(focused);
        warning-finished => root.warning-finished();
        save(overwrite) => root.save(overwrite);
        focus-restore(backward) => shortcut-field.focus-restore();
    }
}

export component CommandPaletteOverlay inherits Rectangle {
    in property <bool> open;
    out property <bool> search-focused: search.has-focus;
    in property <float> scale-factor: 1.0;
    in property <bool> window-active: true;
    in-out property <string> query;
    in property <[CommandEntry]> commands;
    in property <bool> media-loaded;
    in property <bool> audio-media;
    in property <int> capture-action: 0;
    in property <bool> capture-active: false;
    in property <int> saved-action: 0;
    in property <bool> saved-visible: false;
    in property <string> error-message;
    in-out property <ShortcutCapturePhase> capture-phase: ShortcutCapturePhase.idle;
    in-out property <bool> close-pending: false;
    in property <float> close-remaining: 3;
    in property <image> close-background;
    in property <bool> close-background-ready;
    in property <string> preview;
    in property <bool> capture-dirty;
    private property <int> selected-index: 0;
    private property <bool> confirming-reset: false;
    private property <bool> editing: capture-active;
    private property <bool> recording: capture-phase == ShortcutCapturePhase.recording;
    private property <bool> can-save: capture-phase == ShortcutCapturePhase.valid;
    private property <bool> capture-has-candidate: capture-phase == ShortcutCapturePhase.valid
        || capture-phase == ShortcutCapturePhase.conflict;
    // A conflict is also an entered candidate and must not be discarded by row selection.
    private property <bool> empty-edit: editing && !capture-has-candidate;
    private property <bool> has-unsaved-edit: editing && capture-dirty;
    private property <int> warning-request;
    // After warning, any other command can discard this draft; the edited command cannot.
    private property <bool> discard-armed: false;
    private property <length> row-spacing: Theme.space-1;
    private property <length> row-height: 56px;
    private property <length> selected-top: 0px;
    private property <length> selected-height: row-height;
    private property <float> reveal-progress: open ? 1 : 0;
    private property <bool> auto-centering: false;
    private property <bool> center-pending: false;
    private property <length> center-start: 0px;
    private property <length> center-end: 0px;
    private property <float> center-progress: 0;
    private property <duration> center-started-at: 0ms;
    private property <bool> can-restore: editing && (
        (selected-command.shortcut != selected-command.default-shortcut && !(selected-command.shortcut == "—" && selected-command.default-shortcut == "не назначено"))
        || (!empty-edit && preview != selected-command.default-shortcut && !(preview == "Не назначено" && selected-command.default-shortcut == "не назначено")));
    private property <CommandEntry> selected-command: commands[selected-index];
    private property <bool> can-execute: commands.length > 0
        && (!selected-command.requires-media || media-loaded)
        && (!(selected-command.action == 25 || selected-command.action == 26) || !audio-media);
    callback query-changed(string);
    callback execute(int);
    callback begin-capture(int);
    callback save(bool);
    callback cancel();
    callback restore-default();
    callback reset-shortcuts();
    callback close();
    callback prepare-close(float, float, float, float);
    callback capture-focus-changed(bool);

    visible: open || reveal-progress > 0.01;
    background: transparent;
    forward-focus: search;
    animate reveal-progress {
        duration: Theme.motion-normal;
        easing: cubic-bezier(0.4, 0, 0.2, 1);
    }
    changed open => {
        root.close-pending = false;
        root.discard-armed = false;
        if (open) {
            root.selected-index = 0;
            root.confirming-reset = false;
            search.focus();
        }
    }
    changed capture-action => {
        root.discard-armed = false;
        root.close-pending = false;
        if (root.editing) { root.request-center(); }
    }
    changed capture-active => {
        root.discard-armed = false;
        root.close-pending = false;
        if (!root.editing && root.open) { search.focus(); }
        root.request-center();
    }
    changed error-message => { if (root.editing) { root.request-center(); } }
    changed preview => { root.discard-armed = false; }
    changed recording => { root.discard-armed = false; }
    changed empty-edit => {
        if (root.editing && !root.empty-edit) { root.request-center(); }
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.open ? Theme.backdrop : transparent;
        animate background {
            duration: Theme.motion-normal;
            easing: cubic-bezier(0.4, 0, 0.2, 1);
        }
    }
    TouchArea {
        enabled: root.open;
        clicked => {
            if (root.editing) { root.request-close(); }
            else if (root.confirming-reset) { root.confirming-reset = false; search.focus(); }
            else { root.close(); }
        }
    }
    center-delay := Timer {
        interval: 16ms;
        running: root.center-pending;
        triggered => {
            root.center-pending = false;
            root.start-centering();
        }
    }
    center-timer := Timer {
        interval: 16ms;
        running: root.auto-centering;
        triggered => {
            root.center-progress = min(1,
                (animation-tick() - root.center-started-at) / Theme.motion-gentle);
            let eased = root.center-progress * root.center-progress
                * (3 - 2 * root.center-progress);
            root.center-end = root.center-target();
            command-list.viewport-y = root.center-start
                + (root.center-end - root.center-start) * eased;
            if (root.center-progress >= 1) {
                root.auto-centering = false;
            }
        }
    }
    panel := Rectangle {
        property <float> safe-scale: max(0.1, root.scale-factor);
        property <length> target-width: min(parent.width - Theme.space-12, 780px);
        property <length> target-height: min(parent.height - Theme.space-12, 580px);
        width: Math.floor(target-width / 1px * safe-scale) / safe-scale * 1px;
        height: Math.floor(target-height / 1px * safe-scale) / safe-scale * 1px;
        x: Math.floor((parent.width - self.width) / 2 / 1px * safe-scale)
            / safe-scale * 1px;
        y: Math.floor((parent.height - self.height) / 2 / 1px * safe-scale)
            / safe-scale * 1px + (1 - root.reveal-progress) * Theme.space-2;
        border-radius: Theme.radius-xlarge;
        background: Theme.surface-modal;
        border-width: 1px;
        border-color: Theme.border-glass;
        clip: true;
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if (root.close-pending && event.text == Key.Escape) {
                    root.close-pending = false;
                    return accept;
                }
                if (root.confirming-reset && event.text == Key.Escape) {
                    root.confirming-reset = false;
                    search.focus();
                    return accept;
                }
                if (event.text == Key.Tab) {
                    if (root.close-pending) {
                        if (close-cancel.has-focus) { close-confirm.focus(); }
                        else { close-cancel.focus(); }
                    } else if (root.confirming-reset) {
                        if (reset-cancel.has-focus) { reset-confirm.focus(); }
                        else { reset-cancel.focus(); }
                    } else if (!root.editing) {
                        if (reset-start.has-focus) { search.focus(); }
                        else { reset-start.focus(); }
                    }
                    return accept;
                }
                return reject;
            }
            browser := Rectangle {
                opacity: root.close-pending ? (root.close-background-ready ? 0 : 0.15) : 1;
                VerticalLayout {
                    padding: Theme.space-4;
                    spacing: Theme.space-3;
                    UiText { text: "Команды и горячие клавиши"; variant: TextVariant.heading; }
                    search := LineEdit {
                        height: Theme.space-10;
                        enabled: browser.visible && !root.editing && !root.confirming-reset;
                        text <=> root.query;
                        placeholder-text: "Найти команду…";
                        edited(text) => {
                            root.selected-index = 0;
                            command-list.viewport-y = 0px;
                            root.query-changed(text);
                        }
                        accepted => root.activate-selected();
                        key-pressed(event) => {
                            if (event.text == Key.DownArrow) { root.move-selection(1); return accept; }
                            if (event.text == Key.UpArrow) { root.move-selection(-1); return accept; }
                            if (event.text == Key.F2) { root.edit-selected(); return accept; }
                            if (event.text == Key.Escape) { root.close(); return accept; }
                            return reject;
                        }
                    }
                    Divider { }
                    command-list := ScrollView {
                        vertical-stretch: 1;
                        enabled: browser.visible && !root.confirming-reset;
                        viewport-width: self.visible-width;
                        changed visible-height => root.reveal-selection();
                        VerticalLayout {
                            spacing: root.row-spacing;
                            for command[index] in root.commands : CommandRow {
                                width: max(0px, command-list.visible-width - Theme.space-5);
                                entry: command;
                                selected: index == root.selected-index;
                                enabled: browser.visible && !root.close-pending
                                    && !root.confirming-reset;
                                blocked: root.close-pending;
                                active: root.open && root.window-active && !root.close-pending;
                                editing: root.editing && command.action == root.capture-action;
                                saved: root.saved-visible && command.action == root.saved-action;
                                recording: root.recording;
                                can-save: root.can-save && root.has-unsaved-edit;
                                candidate-valid: root.can-save;
                                preview: root.preview;
                                error-message: root.error-message;
                                can-restore: root.can-restore;
                                warning-request: root.warning-request;
                                can-execute: (!command.requires-media || root.media-loaded)
                                    && (!(command.action == 25 || command.action == 26) || !root.audio-media);
                                geometry-changed(top, height) => {
                                    if (index == root.selected-index) {
                                        root.selected-top = top;
                                        root.selected-height = height;
                                    }
                                }
                                activate => {
                                    if (root.editing) {
                                        if (root.try-leave-edit(command.action)) {
                                            root.selected-index = index;
                                            search.focus();
                                        }
                                    } else if (index == root.selected-index) { root.activate-selected(); }
                                    else { root.selected-index = index; search.focus(); }
                                }
                                edit => {
                                    if (root.close-pending) { return; }
                                    root.discard-armed = false;
                                    if (root.editing) { root.cancel(); }
                                    root.selected-index = index;
                                    root.edit-selected();
                                }
                                save(overwrite) => root.save(overwrite);
                                input-focus-changed(focused) => {
                                    if (command.action == root.capture-action) { root.capture-focus-changed(focused); }
                                }
                                warning-finished => {
                                    if (command.action == root.capture-action) { root.discard-armed = false; }
                                }
                                restore-default => { root.discard-armed = false; root.restore-default(); }
                            }
                            if root.commands.length == 0 : UiText {
                                height: command-list.visible-height;
                                text: "Команды не найдены";
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Divider { }
                    // Help and reset share one stable footer. Confirmation replaces the
                    // hints in place instead of covering or resizing the command browser.
                    footer := Rectangle {
                        height: 112px;
                        default-footer := Rectangle {
                            opacity: root.confirming-reset ? 0 : 1;
                            visible: self.opacity > 0.01;
                            animate opacity { duration: Theme.motion-fast; }
                            VerticalLayout {
                                spacing: Theme.space-2;
                                alignment: center;
                                UiText {
                                    text: root.editing ? "Введите сочетание; следующее нажатие заменит его."
                                        : root.commands.length == 0 ? "Попробуйте другое название."
                                        : !root.can-execute ? (!root.media-loaded ? "Для выполнения откройте файл. Сочетание можно изменить."
                                            : "Выполнение доступно только для видео. Сочетание можно изменить.")
                                        : "Клик по строке — выбрать, повторный — выполнить. По сочетанию — изменить.";
                                    variant: TextVariant.caption;
                                    font-size: 13px;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 16px;
                                    height: 28px;
                                    alignment: center;
                                    if !root.editing && root.can-execute : PaletteHint {
                                        key: "Enter";
                                        description: "Выполнить";
                                    }
                                    PaletteHint {
                                        key: root.editing ? "Tab" : "F2";
                                        description: root.editing ? "К действиям" : "Изменить";
                                    }
                                    PaletteHint {
                                        key: "Esc";
                                        description: root.editing ? "Отменить ввод" : "Закрыть меню";
                                    }
                                }
                                HorizontalLayout {
                                    height: 30px;
                                    alignment: center;
                                    reset-start := Button {
                                        text: "Сбросить клавиши";
                                        visible: !root.editing;
                                        width: 176px;
                                        height: 30px;
                                        selected: true;
                                        enabled: !root.editing && !root.close-pending;
                                        clicked => {
                                            root.confirming-reset = true;
                                            reset-cancel.focus();
                                        }
                                    }
                                }
                            }
                        }
                        reset-footer := Rectangle {
                            opacity: root.confirming-reset ? 1 : 0;
                            visible: self.opacity > 0.01;
                            border-radius: Theme.radius-medium;
                            background: Theme.surface-control;
                            border-width: 1px;
                            border-color: Theme.border-default;
                            animate opacity { duration: Theme.motion-fast; }
                            VerticalLayout {
                                padding-top: 10px;
                                padding-bottom: 10px;
                                padding-left: Theme.space-4;
                                padding-right: Theme.space-4;
                                spacing: Theme.space-2;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    UiText {
                                        text: "Вернуть стандартные сочетания?";
                                        variant: TextVariant.label;
                                        horizontal-alignment: center;
                                    }
                                    UiText {
                                        text: "Ваши назначения будут удалены.";
                                        variant: TextVariant.caption;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }
                                HorizontalLayout {
                                    height: 36px;
                                    spacing: Theme.space-2;
                                    alignment: center;
                                    reset-cancel := Button {
                                        text: "Отмена";
                                        width: 112px;
                                        height: 36px;
                                        enabled: root.confirming-reset;
                                        clicked => {
                                            root.confirming-reset = false;
                                            search.focus();
                                        }
                                    }
                                    reset-confirm := Button {
                                        text: "Сбросить";
                                        width: 120px;
                                        height: 36px;
                                        primary: true;
                                        enabled: root.confirming-reset;
                                        clicked => {
                                            root.confirming-reset = false;
                                            root.reset-shortcuts();
                                            search.focus();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // One frozen, blurred snapshot of this modal, with an interactive layer above it.
            Rectangle {
                visible: root.close-pending;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.close-background;
                    image-fit: fill;
                    visible: root.close-background-ready;
                }
                Rectangle { background: Theme.surface-modal; opacity: 0.45; }
                TouchArea { }
                Rectangle {
                    property <length> target-width: min(parent.width - 48px, 420px);
                    width: Math.floor(target-width / 1px * panel.safe-scale)
                        / panel.safe-scale * 1px;
                    height: 208px;
                    x: Math.floor((parent.width - self.width) / 2 / 1px * panel.safe-scale)
                        / panel.safe-scale * 1px;
                    y: Math.floor((parent.height - self.height) / 2 / 1px * panel.safe-scale)
                        / panel.safe-scale * 1px;
                    border-radius: Theme.radius-medium;
                    background: Theme.surface-modal;
                    border-width: 1px;
                    border-color: Theme.border-default;
                    clip: true;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        UiText {
                            text: "Закрыть меню без сохранения?";
                            variant: TextVariant.heading;
                            horizontal-alignment: center;
                        }
                        UiText {
                            text: "Новое сочетание не сохранено.\nЗакрытие отменит изменения.";
                            horizontal-alignment: center;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            close-cancel := Button {
                                text: "Отменить закрытие";
                                width: 184px;
                                height: 40px;
                                enabled: root.close-pending;
                                clicked => { root.close-pending = false; }
                            }
                            close-confirm := Button {
                                text: "Закрыть меню";
                                width: 136px;
                                height: 40px;
                                enabled: root.close-pending;
                                clicked => root.finish-close();
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 3px;
                        height: 3px;
                        width: parent.width * max(0, root.close-remaining) / 3;
                        background: Theme.accent;
                    }
                }
            }
        }
    }
    function move-selection(delta: int) {
        if (commands.length > 0) {
            selected-index = Math.mod(selected-index + delta + commands.length, commands.length);
            reveal-selection();
        }
    }
    function try-leave-edit(target: int) -> bool {
        if (root.close-pending) { return false; }
        if (root.has-unsaved-edit) {
            if (root.discard-armed && target >= 0 && target != root.capture-action) {
                root.discard-armed = false;
                root.cancel();
                return true;
            }
            root.discard-armed = true;
            root.warning-request += 1;
            root.reveal-selection();
            return false;
        }
        root.discard-armed = false;
        if (root.editing) { root.cancel(); }
        return true;
    }
    function request-close() {
        if (!root.has-unsaved-edit) {
            root.finish-close();
            return;
        }
        if (!root.close-pending) {
            root.prepare-close(panel.absolute-position.x / 1px, panel.absolute-position.y / 1px,
                panel.width / 1px, panel.height / 1px);
            root.discard-armed = false;
            close-cancel.focus();
        }
    }
    public function finish-close() {
        root.close-pending = false;
        root.cancel();
        root.close();
    }
    public function edit-query(action: int) {
        if (!root.search-focused) { return; }
        if (action == 0) { search.select-all(); }
        else if (action == 1) { search.copy(); }
        else if (action == 2) { search.cut(); }
        else if (action == 3) { search.paste(); }
    }
    function reveal-selection() {
        if (commands.length > 0) {
            let top = root.selected-top;
            let height = min(root.selected-height, command-list.visible-height);
            if (top < -command-list.viewport-y) { command-list.viewport-y = -top; }
            else if (top + height > -command-list.viewport-y + command-list.visible-height) {
                command-list.viewport-y = min(0px, command-list.visible-height - top - height);
            }
        }
    }
    function center-target() -> length {
        let content-height = max(command-list.visible-height, command-list.viewport-height);
        let minimum-offset = min(0px, command-list.visible-height - content-height);
        let centered-offset = command-list.visible-height / 2
            - root.selected-height / 2 - root.selected-top;
        return max(minimum-offset, min(0px, centered-offset));
    }
    function request-center() {
        if (root.open && root.commands.length > 0) {
            root.auto-centering = false;
            root.center-pending = true;
        }
    }
    function start-centering() {
        if (root.open && root.commands.length > 0 && command-list.visible-height > 0px) {
            root.center-start = command-list.viewport-y;
            root.center-end = root.center-target();
            root.center-progress = 0;
            if (Theme.reduce-motion || abs(root.center-end - root.center-start) < 0.5px) {
                command-list.viewport-y = root.center-end;
                root.auto-centering = false;
            } else {
                root.center-started-at = animation-tick();
                root.auto-centering = true;
            }
        }
    }
    function edit-selected() {
        if (commands.length > 0 && selected-command.shortcut-editable) {
            begin-capture(selected-command.action);
        }
    }
    function activate-selected() {
        if (!editing && can-execute) {
            execute(selected-command.action);
        }
    }
}
