import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Button, Divider, Icon, IconButton, ProgressBar, UiText, TextVariant } from "../design_system/primitives.slint";

export struct ConversionPresetEntry {
    index: int,
    category: string,
    show-category: bool,
    title: string,
    description: string,
    summary: string,
    size-note: string,
}

component MarqueeText inherits Rectangle {
    in property <string> text;
    in property <TextVariant> variant: TextVariant.body;
    in property <color> text-color: Theme.text-primary;
    in property <length> text-size: Theme.text-body;
    in property <bool> hovered: false;
    private property <length> estimated-text-width:
        max(root.width, root.text.character-count * root.text-size * 0.58);
    private property <bool> text-overflows:
        estimated-text-width > root.width + Theme.space-1;

    min-width: 0px;
    background: transparent;
    clip: true;

    label := UiText {
        x: root.text-overflows && root.hovered
            ? parent.width - root.estimated-text-width
            : 0px;
        width: root.text-overflows ? root.estimated-text-width : parent.width;
        height: parent.height;
        text: root.text;
        variant: root.variant;
        color: root.text-color;
        font-size: root.text-size;
        overflow: elide;
        vertical-alignment: center;

        animate x {
            duration: 2200ms;
            easing: linear;
        }
    }
}

component ChoiceChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback activated();

    min-width: 44px;
    height: Theme.space-8;
    border-radius: Theme.radius-medium;
    background: selected ? Theme.surface-selected
        : hit.pressed ? Theme.surface-pressed
        : hit.has-hover ? Theme.surface-hover
        : transparent;
    border-width: selected ? 1px : 0px;
    border-color: Theme.accent;
    opacity: enabled ? 1 : 0.45;
    accessible-role: radio-button;
    accessible-label: text;
    accessible-checked: selected;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.activated(); } }

    hit := TouchArea {
        enabled: root.enabled;
        clicked => root.activated();
    }

    UiText {
        width: parent.width;
        height: parent.height;
        text: root.text;
        variant: TextVariant.label;
        color: root.selected ? Theme.accent : Theme.text-secondary;
        font-size: Theme.text-small + 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    animate background, opacity {
        duration: Theme.motion-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
}

component VideoOptionsHelp inherits Rectangle {
    out property <bool> hovered: hit.has-hover;
    callback hover-changed(bool);

    width: Theme.space-6;
    height: Theme.space-5;
    background: transparent;
    accessible-role: button;
    accessible-label: "Справка о разрешении и качестве";

    changed hovered => root.hover-changed(hovered);

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.space-5;
        height: Theme.space-5;
        border-radius: Theme.radius-full;
        background: hit.has-hover ? Theme.surface-hover : Theme.surface-control;
        border-width: 1px;
        border-color: hit.has-hover ? Theme.accent : Theme.border-default;

        UiText {
            width: parent.width;
            height: parent.height;
            text: "?";
            variant: TextVariant.label;
            color: hit.has-hover ? Theme.accent : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    hit := TouchArea { }
}

component HelpRow inherits Rectangle {
    in property <string> title;
    in property <string> description;

    background: transparent;

    HorizontalLayout {
        spacing: Theme.space-3;

        Rectangle {
            width: 96px;
            height: Theme.space-7;
            border-radius: Theme.radius-medium;
            background: Theme.accent-subtle;

            UiText {
                width: parent.width;
                height: parent.height;
                text: root.title;
                variant: TextVariant.label;
                color: Theme.accent;
                font-size: Theme.text-small + 1px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        UiText {
            horizontal-stretch: 1;
            text: root.description;
            variant: TextVariant.body;
            color: Theme.text-secondary;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }
}

component PresetRow inherits Rectangle {
    in property <ConversionPresetEntry> entry;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback activated();

    height: 60px;
    border-radius: Theme.radius-medium;
    background: selected ? Theme.surface-selected
        : hit.pressed ? Theme.surface-pressed
        : hit.has-hover ? Theme.surface-hover
        : transparent;
    opacity: enabled ? 1 : 0.45;
    accessible-role: radio-button;
    accessible-checked: selected;
    accessible-label: entry.title;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.activated(); } }

    hit := TouchArea {
        enabled: root.enabled;
        clicked => root.activated();
    }

    if selected : Rectangle {
        x: 0px;
        y: Theme.space-2;
        width: 3px;
        height: parent.height - Theme.space-4;
        border-radius: Theme.radius-full;
        background: Theme.accent;
    }

    VerticalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        spacing: Theme.space-1;

        MarqueeText {
            height: Theme.space-5;
            vertical-stretch: 0;
            text: root.entry.title;
            variant: TextVariant.label;
            text-color: root.selected ? Theme.accent : Theme.text-primary;
            text-size: Theme.text-body + 1px;
            hovered: hit.has-hover;
        }

        MarqueeText {
            height: Theme.space-5;
            vertical-stretch: 0;
            text: root.entry.summary;
            variant: TextVariant.caption;
            text-color: Theme.text-secondary;
            text-size: Theme.text-small + 1px;
            hovered: hit.has-hover;
        }
    }

    animate background, opacity {
        duration: Theme.motion-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
}

export component ConverterOverlay inherits Rectangle {
    in property <bool> open;
    in property <string> source-name;
    in property <string> source-size;
    in property <string> source-duration;
    in property <string> source-format;
    in property <bool> audio-media: false;
    in property <[ConversionPresetEntry]> presets;
    in-out property <string> output-path;
    in-out property <int> preset-index: 0;
    in-out property <string> preset-title;
    in-out property <string> preset-description;
    in-out property <string> preset-summary;
    in-out property <string> preset-size-note;
    in-out property <int> resolution-index: 0;
    in-out property <int> bitrate-index: 0;
    in-out property <int> encoding-speed-index: 0;
    in property <string> size-status;
    in property <bool> ffmpeg-available: false;
    in property <string> ffmpeg-details;
    in property <bool> running: false;
    in property <float> progress: 0;
    in property <string> status-text;
    private property <length> body-height: audio-media ? 304px : 460px;
    private property <length> desired-panel-height: body-height + 201px;
    private property <bool> video-options-available:
        !audio-media && preset-index != 3 && preset-index != 5;
    private property <bool> video-help-visible: false;
    private property <bool> status-area-visible:
        ffmpeg-available && status-text != "" && status-text != "Готово к запуску";
    private property <string> resolution-help-title:
        resolution-index == 0 ? "Исходное"
        : resolution-index == 1 ? "2160p"
        : resolution-index == 2 ? "1440p"
        : resolution-index == 3 ? "1080p"
        : resolution-index == 4 ? "720p"
        : "480p";
    private property <string> resolution-help-description:
        resolution-index == 0
            ? "Разрешение не изменится: видео не будет ни уменьшено, ни увеличено."
            : "Видео станет не выше " + resolution-help-title
                + ". Если оно уже меньше, Oxide не будет его растягивать.";
    private property <string> bitrate-help-description:
        bitrate-index == 0
            ? "Качество подбирается автоматически. Обычно это лучший выбор без лишних настроек."
        : bitrate-index == 1
            ? "Сильное сжатие: файл будет меньше, но мелкие детали могут потеряться."
        : bitrate-index == 2
            ? "Компактный файл с умеренным качеством изображения."
        : bitrate-index == 3
            ? "Хороший баланс качества и размера для большинства видео."
        : bitrate-index == 4
            ? "Высокое качество, но файл получится заметно больше."
            : "Самое высокое качество среди вариантов и самый большой файл.";
    private property <string> encoding-speed-help-description:
        encoding-speed-index == 1
            ? "Конвертация закончится быстрее, но сжатие будет менее эффективным."
        : encoding-speed-index == 2
            ? "Разумный баланс между временем ожидания и качеством результата."
        : encoding-speed-index == 3
            ? "Конвертация займёт больше времени, зато кодек лучше сохранит детали."
            : "Oxide использует скорость, которая лучше всего подходит выбранному профилю.";
    private property <int> recommended-bitrate-index:
        resolution-index == 1 ? 5
        : resolution-index == 2 ? 4
        : resolution-index == 3 ? 3
        : resolution-index == 4 ? 2
        : resolution-index == 5 ? 1
        : 0;
    private property <string> recommended-bitrate-label:
        recommended-bitrate-index == 1 ? "2 Мбит/с"
        : recommended-bitrate-index == 2 ? "4 Мбит/с"
        : recommended-bitrate-index == 3 ? "8 Мбит/с"
        : recommended-bitrate-index == 4 ? "12 Мбит/с"
        : recommended-bitrate-index == 5 ? "20 Мбит/с"
        : "Авто";
    private property <string> recommendation-help-description:
        bitrate-index == 0
            ? "Хороший выбор: Oxide сам подберёт качество. Итоговый размер файла заранее не фиксирован."
        : resolution-index == 0
            ? "Если вам не нужен заданный размер файла, выберите «Авто» — так проще сохранить качество."
        : bitrate-index < recommended-bitrate-index
            ? "Для " + resolution-help-title + " этого мало. Выберите «Авто» или хотя бы "
                + recommended-bitrate-label + ", иначе изображение может потерять чёткость."
        : bitrate-index == recommended-bitrate-index
            ? "Настройки хорошо сочетаются: разумный баланс качества и размера файла."
            : "Это больше, чем обычно нужно для " + resolution-help-title
                + ". Качество будет высоким, но файл заметно увеличится.";
    callback choose-output(int);
    callback start(int);
    callback cancel();
    callback close();

    visible: open || self.opacity > 0.01;
    opacity: open ? 1 : 0;
    background: Theme.backdrop;

    animate opacity {
        duration: Theme.motion-normal;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { if (!root.running) { root.close(); } }
    }

    panel := Rectangle {
        width: min(parent.width - Theme.space-4, 960px);
        height: min(parent.height - Theme.space-3, root.desired-panel-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-xlarge;
        background: Theme.surface-modal;
        border-width: 1px;
        border-color: Theme.border-glass;
        drop-shadow-color: Theme.shadow-high;
        drop-shadow-blur: Theme.elevation-high-blur;
        drop-shadow-offset-y: Theme.elevation-high-y;
        clip: true;

        TouchArea { width: parent.width; height: parent.height; }

        VerticalLayout {
            padding: Theme.space-4;
            spacing: Theme.space-2;

            HorizontalLayout {
                height: Theme.space-10;
                vertical-stretch: 0;
                spacing: Theme.space-3;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.space-1;
                    UiText { text: "Конвертировать"; variant: TextVariant.title; }
                    UiText {
                        text: root.audio-media
                            ? "Создайте копию в другом аудиоформате"
                            : "Выберите профиль для нового файла";
                        variant: TextVariant.caption;
                        color: Theme.text-secondary;
                        font-size: Theme.text-small + 1px;
                    }
                }

                IconButton {
                    icon: @image-url("../icons/window-close.svg");
                    accessible-name: "Закрыть конвертацию";
                    enabled: !root.running;
                    clicked => root.close();
                }
            }

            source := Rectangle {
                height: 56px;
                vertical-stretch: 0;
                border-radius: Theme.radius-large;
                background: Theme.surface-control;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-3;

                    Rectangle {
                        width: Theme.space-10;
                        background: transparent;

                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: Theme.space-10;
                            height: Theme.space-10;
                            border-radius: Theme.radius-medium;
                            background: Theme.accent-subtle;

                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: root.audio-media
                                    ? @image-url("../icons/file-media.svg")
                                    : @image-url("../icons/file-video.svg");
                                tint: Theme.accent;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.space-1;
                        alignment: center;
                        MarqueeText {
                            height: Theme.space-5;
                            vertical-stretch: 0;
                            text: root.source-name;
                            variant: TextVariant.label;
                            text-size: Theme.text-body + 1px;
                            hovered: source-hover.has-hover;
                        }
                        MarqueeText {
                            height: Theme.space-5;
                            vertical-stretch: 0;
                            text: root.source-format + "  ·  " + root.source-duration;
                            variant: TextVariant.caption;
                            text-color: Theme.text-secondary;
                            text-size: Theme.text-small + 1px;
                            hovered: source-hover.has-hover;
                        }
                    }

                    UiText {
                        text: root.source-size;
                        variant: TextVariant.label;
                        color: Theme.text-secondary;
                        font-size: Theme.text-body + 1px;
                        vertical-alignment: center;
                    }

                }

                source-hover := TouchArea { }
            }

            HorizontalLayout {
                height: min(root.body-height, panel.height - 201px);
                vertical-stretch: 0;
                spacing: Theme.space-4;

                catalog := Rectangle {
                    width: max(224px, min(252px, parent.width * 0.29));
                    border-radius: Theme.radius-large;
                    background: Theme.surface-control;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    VerticalLayout {
                        padding: Theme.space-2;
                        spacing: Theme.space-2;

                        UiText {
                            height: Theme.space-7;
                            vertical-stretch: 0;
                            text: root.audio-media ? "Аудиоформат" : "Профиль";
                            variant: TextVariant.label;
                            color: Theme.text-secondary;
                            font-size: Theme.text-body + 1px;
                            vertical-alignment: center;
                        }

                        profile-scroll := ScrollView {
                            vertical-stretch: 1;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                            VerticalLayout {
                                spacing: Theme.space-1;

                                for preset in root.presets : PresetRow {
                                    entry: preset;
                                    selected: preset.index == root.preset-index;
                                    enabled: !root.running;
                                    activated => {
                                        root.preset-index = preset.index;
                                        root.preset-title = preset.title;
                                        root.preset-description = preset.description;
                                        root.preset-summary = preset.summary;
                                        root.preset-size-note = preset.size-note;
                                        root.output-path = "";
                                    }
                                }
                            }
                        }
                    }

                    if profile-scroll.viewport-height > profile-scroll.visible-height : Rectangle {
                        private property <length> thumb-height: max(
                            Theme.space-7,
                            profile-scroll.visible-height * profile-scroll.visible-height
                                / profile-scroll.viewport-height
                        );
                        private property <float> scroll-ratio:
                            profile-scroll.viewport-height > profile-scroll.visible-height
                                ? max(0, min(1,
                                    -profile-scroll.viewport-y
                                        / (profile-scroll.viewport-height - profile-scroll.visible-height)
                                ))
                                : 0;

                        x: parent.width - Theme.space-2;
                        y: profile-scroll.y
                            + scroll-ratio * (profile-scroll.visible-height - thumb-height);
                        width: 2px;
                        height: thumb-height;
                        border-radius: Theme.radius-full;
                        background: Theme.text-muted;
                        opacity: 0.6;
                    }
                }

                details := Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;

                    VerticalLayout {
                        padding: Theme.space-1;
                        spacing: Theme.space-2;

                        HorizontalLayout {
                            height: Theme.space-7;
                            vertical-stretch: 0;
                            spacing: Theme.space-3;

                            UiText {
                                horizontal-stretch: 1;
                                text: root.preset-title;
                                variant: TextVariant.heading;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            summary-line := Rectangle {
                                width: 224px;
                                background: transparent;

                                MarqueeText {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.preset-summary;
                                    variant: TextVariant.label;
                                    text-color: Theme.accent;
                                    text-size: Theme.text-body + 1px;
                                    hovered: summary-hover.has-hover;
                                }

                                summary-hover := TouchArea { }
                            }
                        }

                        if !root.status-area-visible : UiText {
                            height: 36px;
                            vertical-stretch: 0;
                            text: root.preset-description;
                            variant: TextVariant.body;
                            color: Theme.text-secondary;
                            font-size: Theme.text-body + 1px;
                            wrap: word-wrap;
                        }

                        if !root.status-area-visible : UiText {
                            height: Theme.space-8;
                            vertical-stretch: 0;
                            text: root.preset-size-note;
                            variant: TextVariant.caption;
                            color: Theme.text-secondary;
                            font-size: Theme.text-small + 1px;
                            wrap: word-wrap;
                        }

                        Divider { }

                        if root.video-options-available : Rectangle {
                            height: 216px;
                            vertical-stretch: 0;
                            border-radius: Theme.radius-medium;
                            background: Theme.surface-hover;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: Theme.space-2;
                                spacing: Theme.space-1;

                                HorizontalLayout {
                                    height: Theme.space-5;
                                    vertical-stretch: 0;
                                    spacing: Theme.space-2;
                                    UiText {
                                        text: "Параметры видео";
                                        variant: TextVariant.label;
                                    }
                                    VideoOptionsHelp {
                                        hover-changed(visible) => {
                                            root.video-help-visible = visible;
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: transparent;
                                    }
                                }

                                UiText {
                                    height: Theme.space-5;
                                    vertical-stretch: 0;
                                    text: "Разрешение · выбранное значение — максимум";
                                    variant: TextVariant.caption;
                                    color: Theme.text-secondary;
                                    font-size: Theme.text-small + 1px;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    height: Theme.space-8;
                                    vertical-stretch: 0;
                                    spacing: Theme.space-1;
                                    for option[index] in ["Исходное", "2160p", "1440p", "1080p", "720p", "480p"] : ChoiceChip {
                                        text: option;
                                        selected: root.resolution-index == index;
                                        enabled: !root.running;
                                        activated => { root.resolution-index = index; }
                                    }
                                }

                                UiText {
                                    height: Theme.space-5;
                                    vertical-stretch: 0;
                                    text: "Качество и размер файла · Авто рекомендуется";
                                    variant: TextVariant.caption;
                                    color: Theme.text-secondary;
                                    font-size: Theme.text-small + 1px;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    height: Theme.space-8;
                                    vertical-stretch: 0;
                                    spacing: Theme.space-1;
                                    for option[index] in ["Авто", "2", "4", "8", "12", "20"] : ChoiceChip {
                                        text: index == 0 ? option : option + " М";
                                        selected: root.bitrate-index == index;
                                        enabled: !root.running;
                                        activated => { root.bitrate-index = index; }
                                    }
                                }

                                UiText {
                                    height: Theme.space-5;
                                    vertical-stretch: 0;
                                    text: "Скорость кодирования · влияет на время ожидания";
                                    variant: TextVariant.caption;
                                    color: Theme.text-secondary;
                                    font-size: Theme.text-small + 1px;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    height: Theme.space-8;
                                    vertical-stretch: 0;
                                    spacing: Theme.space-1;
                                    for option[index] in ["По профилю", "Быстро", "Баланс", "Тщательно"] : ChoiceChip {
                                        text: option;
                                        selected: root.encoding-speed-index == index;
                                        enabled: !root.running;
                                        activated => { root.encoding-speed-index = index; }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        destination := Rectangle {
                            height: 56px;
                            vertical-stretch: 0;
                            border-radius: Theme.radius-medium;
                            background: Theme.surface-hover;
                            border-width: 1px;
                            border-color: Theme.border-default;

                            HorizontalLayout {
                                padding-left: Theme.space-3;
                                padding-right: Theme.space-2;
                                spacing: Theme.space-2;

                                path-area := Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    VerticalLayout {
                                        spacing: Theme.space-1;
                                        alignment: center;
                                        UiText {
                                            text: "Сохранить как";
                                            variant: TextVariant.caption;
                                            color: Theme.text-secondary;
                                            font-size: Theme.text-small + 1px;
                                        }
                                        MarqueeText {
                                            height: Theme.space-5;
                                            vertical-stretch: 0;
                                            text: root.output-path == ""
                                                ? "Выберите имя и папку"
                                                : root.output-path;
                                            text-color: root.output-path == ""
                                                ? Theme.text-secondary
                                                : Theme.text-primary;
                                            text-size: Theme.text-small + 1px;
                                            hovered: path-hover.has-hover;
                                        }
                                    }

                                    path-hover := TouchArea { }
                                }

                                Rectangle {
                                    width: 112px;
                                    background: transparent;

                                    Button {
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        text: root.output-path == "" ? "Выбрать…" : "Изменить…";
                                        enabled: !root.running;
                                        clicked => root.choose-output(root.preset-index);
                                    }
                                }
                            }
                        }

                        if root.status-area-visible : VerticalLayout {
                            height: 44px;
                            vertical-stretch: 0;
                            spacing: Theme.space-2;
                            HorizontalLayout {
                                UiText {
                                    horizontal-stretch: 1;
                                    text: root.status-text;
                                    variant: TextVariant.caption;
                                    color: Theme.text-secondary;
                                    overflow: elide;
                                }
                                if root.size-status != "" : UiText {
                                    text: root.size-status;
                                    variant: TextVariant.caption;
                                    color: Theme.text-muted;
                                    overflow: elide;
                                }
                            }
                            if root.running || root.progress > 0 : ProgressBar { value: root.progress; }
                        }
                    }
                }
            }

            Divider { }

            HorizontalLayout {
                height: Theme.space-10;
                vertical-stretch: 0;
                spacing: Theme.space-3;

                if root.ffmpeg-available : UiText {
                    horizontal-stretch: 1;
                    text: "Оригинальный файл останется без изменений";
                    variant: TextVariant.caption;
                    color: Theme.text-secondary;
                    font-size: Theme.text-small + 1px;
                    vertical-alignment: center;
                }

                if !root.ffmpeg-available : Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;

                    HorizontalLayout {
                        spacing: Theme.space-2;

                        UiText {
                            text: "Конвертация недоступна";
                            variant: TextVariant.label;
                            color: Theme.danger;
                            vertical-alignment: center;
                        }

                        ffmpeg-details-area := Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;

                            MarqueeText {
                                width: parent.width;
                                height: parent.height;
                                text: root.ffmpeg-details;
                                variant: TextVariant.caption;
                                text-color: Theme.text-secondary;
                                text-size: Theme.text-small + 1px;
                                hovered: footer-ffmpeg-hover.has-hover;
                            }

                            footer-ffmpeg-hover := TouchArea { }
                        }
                    }
                }

                if root.running : Button {
                    text: "Отменить";
                    clicked => root.cancel();
                }

                if root.ffmpeg-available && !root.running : Button {
                    width: 164px;
                    text: "Конвертировать";
                    primary: true;
                    enabled: root.ffmpeg-available && root.output-path != "";
                    clicked => {
                        root.video-help-visible = false;
                        root.start(root.preset-index);
                    }
                }
            }
        }

        if root.video-help-visible : Rectangle {
            z: 1000;
            x: parent.width - self.width - Theme.space-4;
            y: 48px;
            width: min(456px, parent.width - Theme.space-8);
            height: 308px;
            border-radius: Theme.radius-large;
            background: Theme.surface-canvas-opaque;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-color: Theme.shadow-high;
            drop-shadow-blur: Theme.elevation-high-blur;
            drop-shadow-offset-y: Theme.elevation-high-y;

            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-2;

                UiText {
                    height: Theme.space-6;
                    vertical-stretch: 0;
                    text: "Что дадут выбранные параметры";
                    variant: TextVariant.heading;
                }

                HelpRow {
                    height: 48px;
                    vertical-stretch: 0;
                    title: "Разрешение";
                    description: root.resolution-help-description;
                }

                HelpRow {
                    height: 56px;
                    vertical-stretch: 0;
                    title: "Качество";
                    description: root.bitrate-help-description;
                }

                HelpRow {
                    height: 56px;
                    vertical-stretch: 0;
                    title: "Скорость";
                    description: root.encoding-speed-help-description;
                }

                HelpRow {
                    height: 56px;
                    vertical-stretch: 0;
                    title: "Совет";
                    description: root.recommendation-help-description;
                }
            }
        }
    }
}
