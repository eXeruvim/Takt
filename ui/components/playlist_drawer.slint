import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Divider, UiText, TextVariant } from "../design_system/primitives.slint";
import { MediaListItem } from "../design_system/composites.slint";

export component PlaylistDrawer inherits Rectangle {
    in-out property <bool> drawer-visible;
    in property <[string]> items;
    in property <int> current-index: -1;
    in property <length> parent-width;
    in property <length> parent-height;
    callback play-index(int);
    callback close();

    private property <length> swipe-offset: 0px;

    width: min(340px, parent-width - Theme.space-8);
    height: max(0px, parent-height - self.y
        - Theme.player-controls-height - Theme.space-6);
    x: -self.width - Theme.space-12;
    y: Theme.space-4 + Theme.top-bar-height + Theme.space-2;
    border-radius: Theme.radius-xlarge;
    background: Theme.surface-glass-strong;
    border-width: 1px;
    border-color: Theme.border-glass;
    drop-shadow-color: Theme.shadow-high;
    drop-shadow-blur: Theme.elevation-high-blur;
    drop-shadow-offset-y: Theme.elevation-high-y;
    clip: true;

    states [
        open when root.drawer-visible : {
            root.x: Theme.space-4 + root.swipe-offset;
            in {
                animate x {
                    duration: Theme.motion-slow;
                    easing: cubic-bezier(0.16, 1, 0.3, 1);
                }
            }
            out {
                animate x {
                    duration: Theme.motion-normal;
                    easing: cubic-bezier(0.4, 0, 1, 1);
                }
            }
        }
    ]

    TouchArea { width: parent.width; height: parent.height; }

    VerticalLayout {
        padding: Theme.space-5;
        spacing: Theme.space-3;

        UiText { text: "Плейлист"; variant: TextVariant.title; }
        UiText {
            text: root.items.length == 0
                ? "Очередь пока пуста"
                : root.items.length + (root.items.length == 1 ? " файл" : " файлов в очереди");
            variant: TextVariant.caption;
            color: Theme.text-secondary;
        }
        Divider { }

        if root.items.length == 0 : UiText {
            text: "Откройте файл или папку, чтобы сформировать очередь";
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        if root.items.length > 0 : ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: Theme.space-1;

                for item[index] in root.items : MediaListItem {
                    title: item;
                    subtitle: index == root.current-index ? "Сейчас воспроизводится" : "Открыть";
                    selected: index == root.current-index;
                    activated => root.play-index(index);
                }
            }
        }

        Rectangle { vertical-stretch: root.items.length == 0 ? 1 : 0; background: transparent; }
        UiText {
            text: "Выберите файл, чтобы перейти к нему";
            variant: TextVariant.caption;
            color: Theme.text-muted;
        }
    }

    swipe := TouchArea {
        width: parent.width;
        height: Theme.top-bar-height;
        mouse-cursor: MouseCursor.grab;

        moved => {
            if (self.pressed) {
                root.swipe-offset = min(0px, self.mouse-x - self.pressed-x);
            }
        }

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                if (self.mouse-x - self.pressed-x < -72px) {
                    root.close();
                }
                root.swipe-offset = 0px;
            }
        }
    }
}
