import { Theme } from "theme.slint";
import { PlayerControls } from "components/player_controls.slint";
import { AudioCanvas } from "components/audio_canvas.slint";
import { CommandEntry, CommandPaletteOverlay } from "components/command_palette.slint";
import { AudioTrackEntry, MediaInspector, SubtitleTrackEntry } from "components/media_inspector.slint";
import { ShortcutEditorOverlay, ShortcutEntry } from "components/shortcut_editor.slint";
import { Toast } from "design_system/composites.slint";
import { CaptionButton, EmptyState, Icon, Spinner, UiText, TextVariant } from "design_system/primitives.slint";

export enum PlayerPhase {
    empty,
    loading,
    playing,
    paused,
    finished,
    error,
}

export component AppWindow inherits Window {
    forward-focus: keyboard;
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 520px;
    background: transparent;
    default-font-family: "Segoe UI Variable";
    no-frame: true;
    resize-border-width: self.edge_to_edge ? 0px : 6px;
    title: "Oxide";
    icon: @image-url("icons/oxide.svg");

    in-out property <string> file_name: "Не выбран файл";
    in-out property <string> codec: "—";
    in-out property <string> audio_codec: "—";
    in-out property <string> track_title: "";
    in-out property <string> track_artist: "";
    in-out property <string> album_title: "";
    in property <[AudioTrackEntry]> audio_tracks;
    in property <[SubtitleTrackEntry]> subtitle_tracks;
    in-out property <bool> subtitles_enabled: false;
    in-out property <float> audio_delay: 0;
    in-out property <float> subtitle_delay: 0;
    in-out property <image> album_art;
    in-out property <bool> album_art_available: false;
    in-out property <bool> audio_visualization_enabled: true;
    out property <bool> dark_theme: Theme.is-dark;
    in-out property <string> resolution: "—";
    in-out property <string> fps: "—";
    in-out property <string> current_time: "00:00";
    in-out property <string> total_time: "00:00";
    in-out property <float> duration_seconds: 0.0;
    in-out property <float> progress: 0.0;
    in-out property <bool> is_playing: false;
    in-out property <bool> media_loaded: false;
    in-out property <bool> media_transitioning: false;
    in-out property <bool> waiting_for_video_surface: false;
    in-out property <bool> integrated_video_renderer: false;
    in-out property <bool> audio_media: false;
    in-out property <PlayerPhase> player_phase: PlayerPhase.empty;
    out property <string> player_phase_label: media_transitioning ? "Переключение"
        : player_phase == PlayerPhase.loading ? "Загрузка"
        : player_phase == PlayerPhase.playing ? "Воспроизведение"
        : player_phase == PlayerPhase.paused ? "Пауза"
        : player_phase == PlayerPhase.finished ? "Завершено"
        : player_phase == PlayerPhase.error ? "Ошибка"
        : "";
    in-out property <float> volume: 0.65;
    in-out property <bool> muted: false;
    in-out property <float> speed: 1.0;
    in-out property <bool> loop_enabled: false;
    in-out property <bool> folder_loop_enabled: false;
    in-out property <bool> shuffle_enabled: false;
    in-out property <string> next_file: "";
    in-out property <bool> next_card_visible: false;
    in-out property <bool> info_drawer_visible: false;
    in-out property <bool> playlist_drawer_visible: false;
    in-out property <bool> settings_drawer_visible: false;
    in-out property <bool> inspector_reserved: false;
    in-out property <bool> shortcut_editor_visible: false;
    in-out property <bool> fullscreen_mode: false;
    in-out property <bool> window_active: true;
    out property <bool> edge_to_edge: self.maximized || self.fullscreen_mode;
    in-out property <int> shortcut_capture_action: -1;
    in-out property <string> shortcut_editor_error: "";
    in property <[ShortcutEntry]> shortcut_items;
    in-out property <bool> command_palette_visible: false;
    in-out property <string> command_query: "";
    in property <[CommandEntry]> command_items;
    in-out property <bool> controls_visible: true;
    in-out property <bool> controls_pointer_over: false;
    out property <bool> inspector_visible: info_drawer_visible
        || playlist_drawer_visible || settings_drawer_visible;
    out property <bool> media_presented: media_loaded
        && (media_transitioning
            || player_phase == PlayerPhase.playing || player_phase == PlayerPhase.paused);
    out property <bool> controls_can_hide: media_presented && is_playing
        && !controls_pointer_over
        && !inspector_visible
        && !shortcut_editor_visible && !command_palette_visible
        && !error_visible && !drop_target_visible;
    out property <length> controls_top_zone: Theme.top-bar-height + Theme.space-2;
    out property <length> controls_bottom_zone: media_presented
        ? Theme.player-controls-height
        : 0px;
    out property <length> video_top_inset: media_presented && !integrated_video_renderer
        ? Theme.top-bar-height : 0px;
    out property <length> video_bottom_inset: media_presented && !integrated_video_renderer
        ? Theme.player-controls-height : 0px;
    out property <length> audio_top_inset: video_top_inset;
    out property <length> audio_bottom_inset: video_bottom_inset;
    out property <length> player_controls_slide_offset: controls_visible
        ? 0px
        : Theme.space-3;
    in-out property <bool> error_visible: false;
    in-out property <string> error_message: "";
    in-out property <bool> drop_target_visible: false;
    in property <[string]> playlist_items;
    in-out property <int> playlist_current_index: -1;
    out property <length> shortcut_editor_right_inset: shortcut_editor_visible
        || shortcut-editor.opacity > 0.01
        ? min(self.width - Theme.space-8, 520px) + Theme.space-6
        : 0px;
    out property <length> video_left_panel_inset: 0px;
    out property <length> video_right_panel_inset: integrated_video_renderer ? 0px
        : shortcut_editor_right_inset > 0px
        ? shortcut_editor_right_inset
        : inspector_reserved ? 416px : 0px;
    out property <length> audio_left_panel_inset: edge_to_edge ? 0px : Theme.space-4;
    out property <length> audio_right_panel_inset: shortcut_editor_right_inset > 0px
        ? shortcut_editor_right_inset
        : inspector_reserved
            ? 416px
            : edge_to_edge ? 0px : Theme.space-4;
    out property <bool> modal_overlay_active: command-palette.visible || drop-overlay.visible;

    callback open_file();
    callback open_folder();
    callback play_pause();
    callback stop();
    callback previous_video();
    callback next_video();
    callback seek(float);
    callback set_volume(float);
    callback set_speed(float);
    callback select_audio_track(int);
    callback select_subtitle_track(int);
    callback load_subtitle();
    callback adjust_audio_delay(float);
    callback adjust_subtitle_delay(float);
    callback reset_audio_delay();
    callback reset_subtitle_delay();
    callback toggle_loop();
    callback toggle_folder_loop();
    callback toggle_shuffle();
    callback request_media_info();
    callback toggle_fullscreen();
    callback toggle_info();
    callback toggle_playlist();
    callback toggle_settings();
    callback toggle_shortcuts();
    callback reset_shortcuts();
    callback toggle_command_palette();
    callback command_query_changed(string);
    callback seek_relative(float);
    callback adjust_volume(float);
    callback toggle_mute();
    callback play_playlist_index(int);
    callback drag_window();

    animate player_controls_slide_offset {
        duration: Theme.motion-gentle;
        easing: cubic-bezier(0.16, 1, 0.3, 1);
    }

    // Audio is fully composed by Slint and can transition smoothly. Native mpv
    // fallback geometry must snap to its final bounds instead of resizing an
    // HWND on every animation frame.
    animate audio_left_panel_inset, audio_right_panel_inset {
        duration: Theme.motion-slow;
        easing: cubic-bezier(0.16, 1, 0.3, 1);
    }

    changed controls_can_hide => {
        if (root.controls_can_hide) {
            root.reveal-controls();
        } else {
            root.reveal-controls();
            controls-hide-timer.stop();
        }
    }

    controls-hide-timer := Timer {
        interval: 5000ms;
        running: false;
        triggered => {
            if (root.controls_can_hide) {
                root.controls_visible = false;
                self.stop();
            }
        }
    }

    public function reveal-controls() {
        root.controls_visible = true;
        if (root.controls_can_hide) {
            controls-hide-timer.start();
            controls-hide-timer.restart();
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.media_presented && root.audio_media
            ? Theme.audio-canvas-background
            : root.media_presented && root.integrated_video_renderer
                ? transparent
                : root.fullscreen_mode
                    ? Theme.canvas-background-opaque
                    : root.maximized
                        ? Theme.canvas-background-maximized
                        : Theme.canvas-background;
        border-radius: root.edge_to_edge ? 0px : Theme.radius-large;
        border-width: root.edge_to_edge ? 0px : 1px;
        border-color: Theme.border-default;
        clip: true;

        keyboard := FocusScope {
            width: parent.width;
            height: parent.height;
            focus-on-click: true;

            media-backdrop := Rectangle {
                x: root.video_left_panel_inset;
                y: root.video_top_inset;
                width: max(0px, parent.width - self.x - root.video_right_panel_inset);
                height: max(0px, parent.height - self.y - root.video_bottom_inset);
                background: root.media_presented
                    ? root.audio_media
                        ? Theme.surface-media-glass
                        : root.integrated_video_renderer ? transparent : Theme.surface-media
                    : transparent;

                animate background {
                    duration: Theme.motion-normal;
                    easing: cubic-bezier(0.2, 0, 0, 1);
                }
            }

            if root.integrated_video_renderer && root.media_presented
                && !root.audio_media : TouchArea {
                x: root.video_left_panel_inset;
                y: root.video_top_inset;
                width: max(0px, parent.width - self.x - root.video_right_panel_inset);
                height: max(0px, parent.height - self.y - root.video_bottom_inset);
                double-clicked => root.toggle_fullscreen();
            }

            AudioCanvas {
                x: root.audio_left_panel_inset;
                y: root.audio_top_inset;
                width: max(0px, parent.width - self.x - root.audio_right_panel_inset);
                height: max(0px, parent.height - self.y - root.audio_bottom_inset);
                shown: root.media_presented && root.audio_media;
                expanded: root.maximized || root.fullscreen_mode;
                controls-visible: root.controls_visible;
                visualization-enabled: root.audio_visualization_enabled;
                file-name: root.file_name;
                audio-codec: root.audio_codec;
                track-title: root.track_title;
                track-artist: root.track_artist;
                album-title: root.album_title;
                album-art: root.album_art;
                album-art-available: root.album_art_available;
                is-playing: root.is_playing;
                fullscreen => root.toggle_fullscreen();
            }

            outside-drawer-dismiss := TouchArea {
                enabled: root.inspector_visible;
                width: parent.width;
                height: parent.height;
                clicked => {
                    if (root.info_drawer_visible) { root.toggle_info(); }
                    if (root.playlist_drawer_visible) { root.toggle_playlist(); }
                    if (root.settings_drawer_visible) { root.toggle_settings(); }
                }
            }

            if root.player_phase == PlayerPhase.empty : EmptyState {
                x: (parent.width - self.width) / 2;
                y: Theme.top-bar-height;
                width: min(parent.width - Theme.space-8 * 2, 440px);
                height: parent.height - Theme.top-bar-height;
                title: "Откройте медиафайл";
                description: "Перетащите видео, аудио или папку в окно либо выберите их вручную";
                action-text: "Открыть файл";
                secondary-action-text: "Открыть папку";
                action => root.open_file();
                secondary-action => root.open_folder();
            }

            if root.player_phase == PlayerPhase.loading : Rectangle {
                x: (parent.width - self.width) / 2;
                y: Theme.top-bar-height;
                width: min(parent.width - Theme.space-8 * 2, 440px);
                height: parent.height - Theme.top-bar-height;
                background: transparent;

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-3;

                    Spinner { spinner-color: Theme.accent; }
                    UiText {
                        text: "Открываем медиафайл";
                        variant: TextVariant.heading;
                        horizontal-alignment: center;
                    }
                    UiText {
                        text: root.file_name;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }

            if root.player_phase == PlayerPhase.finished : EmptyState {
                x: (parent.width - self.width) / 2;
                y: Theme.top-bar-height;
                width: min(parent.width - Theme.space-8 * 2, 440px);
                height: parent.height - Theme.top-bar-height;
                title: "Воспроизведение завершено";
                description: "Выберите медиафайл в плейлисте или откройте новый";
                action-text: "Открыть файл";
                action => root.open_file();
            }

            if root.player_phase == PlayerPhase.error : EmptyState {
                x: (parent.width - self.width) / 2;
                y: Theme.top-bar-height;
                width: min(parent.width - Theme.space-8 * 2, 440px);
                height: parent.height - Theme.top-bar-height;
                title: "Не удалось воспроизвести медиафайл";
                description: root.error_message;
                action-text: "Выбрать другой файл";
                action => root.open_file();
            }

            top-bar := Rectangle {
                x: 0px;
                y: !root.fullscreen_mode || root.controls_visible ? 0px : -Theme.space-2;
                width: parent.width;
                height: Theme.top-bar-height;
                opacity: !root.fullscreen_mode || root.controls_visible ? 1 : 0;
                visible: !root.fullscreen_mode || root.controls_visible || self.opacity > 0.01;
                border-radius: 0px;
                background: Theme.surface-chrome;
                border-width: 0px;
                title-drag := TouchArea {
                    enabled: !root.fullscreen_mode;
                    x: 132px;
                    width: max(0px, parent.width - self.x
                        - Theme.caption-button-width * 3 - Theme.space-4);
                    height: parent.height;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.drag_window();
                        }
                    }
                    double-clicked => { root.maximized = !root.maximized; }
                }

                HorizontalLayout {
                    x: Theme.space-4;
                    width: 116px;
                    height: parent.height;
                    spacing: Theme.space-2;
                    alignment: center;

                    Icon {
                        source: @image-url("icons/oxide.svg");
                        size: Theme.icon-small;
                        tint: Theme.text-primary;
                    }

                    UiText {
                        text: "Oxide";
                        variant: TextVariant.label;
                        vertical-alignment: center;
                    }
                }

                UiText {
                    x: 140px;
                    width: max(0px, parent.width - self.x
                        - Theme.caption-button-width * 3 - Theme.space-6);
                    height: parent.height;
                    text: root.player_phase != PlayerPhase.empty
                        ? root.file_name + "  ·  " + root.player_phase_label
                        : "";
                    variant: TextVariant.caption;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }

                HorizontalLayout {
                    visible: !root.fullscreen_mode;
                    x: parent.width - self.width;
                    width: Theme.caption-button-width * 3;
                    height: parent.height;
                    spacing: 0px;
                    alignment: center;

                    CaptionButton {
                        icon: @image-url("icons/window-minimize.svg");
                        accessible-name: "Свернуть окно";
                        window-active: root.window_active;
                        clicked => { root.minimized = true; }
                    }

                    CaptionButton {
                        icon: root.maximized
                            ? @image-url("icons/window-restore.svg")
                            : @image-url("icons/window-maximize.svg");
                        accessible-name: root.maximized ? "Восстановить окно" : "Развернуть окно";
                        window-active: root.window_active;
                        clicked => { root.maximized = !root.maximized; }
                    }

                    CaptionButton {
                        icon: @image-url("icons/window-close.svg");
                        accessible-name: "Закрыть окно";
                        danger: true;
                        window-active: root.window_active;
                        clicked => { root.close(); }
                    }
                }

                animate y, opacity {
                    duration: Theme.motion-dismiss;
                    easing: cubic-bezier(0.16, 1, 0.3, 1);
                }
            }

            player-controls := PlayerControls {
                x: 0px;
                y: parent.height - self.height + root.player_controls_slide_offset;
                width: parent.width;
                opacity: root.media_presented && root.controls_visible ? 1 : 0;
                visible: root.media_presented && (root.controls_visible || self.opacity > 0.01);
                media_loaded: root.media_loaded;
                is_playing: root.is_playing;
                progress <=> root.progress;
                time_pos: root.current_time;
                time_duration: root.total_time;
                duration_seconds: root.duration_seconds;
                volume: root.volume;
                muted: root.muted;
                loop_enabled: root.loop_enabled;
                edge_to_edge: root.edge_to_edge;
                fullscreen_active: root.fullscreen_mode;
                playlist_open: root.playlist_drawer_visible;
                info_open: root.info_drawer_visible;
                settings_open: root.settings_drawer_visible;
                command_palette_open: root.command_palette_visible;
                next_file: root.next_card_visible ? root.next_file : "";
                open_file => root.open_file();
                open_folder => root.open_folder();
                toggle_playlist => root.toggle_playlist();
                toggle_info => root.toggle_info();
                play_pause => root.play_pause();
                previous => root.previous_video();
                next => root.next_video();
                seek(value) => root.seek(value);
                set_volume(value) => root.set_volume(value);
                toggle_mute => root.toggle_mute();
                toggle_loop => root.toggle_loop();
                toggle_settings => root.toggle_settings();
                toggle_fullscreen => root.toggle_fullscreen();
                show_more => root.toggle_command_palette();

                animate opacity {
                    duration: Theme.motion-dismiss;
                    easing: cubic-bezier(0.16, 1, 0.3, 1);
                }
            }

            inspector := MediaInspector {
                open: root.inspector_visible;
                playlist-open: root.playlist_drawer_visible;
                info-open: root.info_drawer_visible;
                playback-open: root.settings_drawer_visible;
                items: root.playlist_items;
                current-index: root.playlist_current_index;
                file-name: root.file_name;
                codec: root.codec;
                audio-codec: root.audio_codec;
                resolution: root.resolution;
                fps: root.fps;
                audio-media: root.audio_media;
                media-loaded: root.media_loaded;
                audio-tracks: root.audio_tracks;
                subtitle-tracks: root.subtitle_tracks;
                subtitles-enabled: root.subtitles_enabled;
                audio-delay: root.audio_delay;
                subtitle-delay: root.subtitle_delay;
                speed: root.speed;
                folder-loop-enabled: root.folder_loop_enabled;
                shuffle-enabled: root.shuffle_enabled;
                audio-visualization-enabled: root.audio_visualization_enabled;
                parent-width: parent.width;
                parent-height: parent.height;
                show-playlist => root.toggle_playlist();
                show-info => root.toggle_info();
                show-playback => root.toggle_settings();
                close => {
                    if (root.playlist_drawer_visible) { root.toggle_playlist(); }
                    else if (root.info_drawer_visible) { root.toggle_info(); }
                    else if (root.settings_drawer_visible) { root.toggle_settings(); }
                }
                play-index(index) => root.play_playlist_index(index);
                set-speed(value) => root.set_speed(value);
                select-audio-track(id) => root.select_audio_track(id);
                select-subtitle-track(id) => root.select_subtitle_track(id);
                load-subtitle => root.load_subtitle();
                adjust-audio-delay(delta) => root.adjust_audio_delay(delta);
                adjust-subtitle-delay(delta) => root.adjust_subtitle_delay(delta);
                reset-audio-delay => root.reset_audio_delay();
                reset-subtitle-delay => root.reset_subtitle_delay();
                toggle-folder-loop => root.toggle_folder_loop();
                toggle-shuffle => root.toggle_shuffle();
                toggle-audio-visualization => {
                    root.audio_visualization_enabled = !root.audio_visualization_enabled;
                }
                edit-shortcuts => root.toggle_shortcuts();
            }

            shortcut-editor := ShortcutEditorOverlay {
                open: root.shortcut_editor_visible;
                shortcuts: root.shortcut_items;
                capture-action: root.shortcut_capture_action;
                error-message: root.shortcut_editor_error;
                begin-capture(action) => {
                    root.shortcut_capture_action = action;
                    root.shortcut_editor_error = "";
                }
                reset-defaults => root.reset_shortcuts();
                close => {
                    root.shortcut_editor_visible = false;
                    root.shortcut_capture_action = -1;
                    root.shortcut_editor_error = "";
                }
            }

            command-palette := CommandPaletteOverlay {
                open: root.command_palette_visible;
                query <=> root.command_query;
                commands: root.command_items;
                media-loaded: root.media_loaded;
                query-changed(query) => root.command_query_changed(query);
                close => {
                    root.command_palette_visible = false;
                    root.command_query = "";
                    root.command_query_changed("");
                }
                execute(action) => root.run-palette-command(action);
            }

            drop-overlay := Rectangle {
                visible: root.drop_target_visible || self.opacity > 0.01;
                opacity: root.drop_target_visible ? 1 : 0;
                width: parent.width;
                height: parent.height;
                background: Theme.backdrop;
                border-width: 2px;
                border-color: Theme.accent;

                animate opacity {
                    duration: Theme.motion-normal;
                    easing: cubic-bezier(0.2, 0, 0, 1);
                }

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-3;

                    UiText {
                        text: "Перетащите сюда видео, аудио или папку";
                        variant: TextVariant.title;
                        horizontal-alignment: center;
                    }
                    UiText {
                        text: "Отпустите, чтобы начать воспроизведение";
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }
            }

            Toast {
                shown: root.error_visible;
                message: root.error_message;
                danger: true;
                x: parent.width - self.width - Theme.space-6;
                y: Theme.space-12 + Theme.space-8;
                dismissed => { root.error_visible = false; }
            }
        }
    }

    function run-palette-command(action: int) {
        command_palette_visible = false;
        command_query = "";
        command_query_changed("");
        if (action == 0) { open_file(); }
        else if (action == 1) { open_folder(); }
        else if (action == 2) { play_pause(); }
        else if (action == 3) { previous_video(); }
        else if (action == 4) { next_video(); }
        else if (action == 5) { toggle_mute(); }
        else if (action == 6) { toggle_loop(); }
        else if (action == 7) { toggle_playlist(); }
        else if (action == 8) { toggle_info(); }
        else if (action == 9) { toggle_settings(); }
        else if (action == 10) { toggle_shortcuts(); }
        else if (action == 11) { toggle_fullscreen(); }
        else if (action == 12) { stop(); }
        else if (action == 13) { seek_relative(-10.0); }
        else if (action == 14) { seek_relative(10.0); }
        else if (action == 15) { adjust_volume(-5.0); }
        else if (action == 16) { adjust_volume(5.0); }
    }
}
