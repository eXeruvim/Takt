import { Theme } from "theme.slint";
import { PlayerControls } from "components/player_controls.slint";
import { InfoDrawer } from "components/info_drawer.slint";
import { PlaylistDrawer } from "components/playlist_drawer.slint";
import { SettingsDrawer } from "components/settings_drawer.slint";
import { NextVideoCard } from "components/next_video_card.slint";
import { ShortcutOverlay } from "components/shortcut_overlay.slint";
import { Toast } from "design_system/composites.slint";
import { EmptyState, Icon, IconButton, UiText, TextVariant } from "design_system/primitives.slint";

export component AppWindow inherits Window {
    forward-focus: keyboard;
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.surface-canvas;
    no-frame: true;
    resize-border-width: 6px;
    title: "Oxide";
    icon: @image-url("icons/oxide.svg");

    in-out property <string> file_name: "Не выбран файл";
    in-out property <string> codec: "—";
    in-out property <string> audio_codec: "—";
    in-out property <string> resolution: "—";
    in-out property <string> fps: "—";
    in-out property <string> current_time: "00:00";
    in-out property <string> total_time: "00:00";
    in-out property <float> duration_seconds: 0.0;
    in-out property <float> progress: 0.0;
    in-out property <bool> is_playing: false;
    in-out property <bool> media_loaded: false;
    in-out property <float> volume: 0.65;
    in-out property <bool> muted: false;
    in-out property <float> speed: 1.0;
    in-out property <bool> loop_enabled: false;
    in-out property <bool> folder_loop_enabled: false;
    in-out property <bool> shuffle_enabled: false;
    in-out property <string> next_file: "";
    in-out property <bool> next_card_visible: false;
    in-out property <bool> info_drawer_visible: false;
    in-out property <bool> playlist_drawer_visible: false;
    in-out property <bool> settings_drawer_visible: false;
    in-out property <bool> info_drawer_reserved: false;
    in-out property <bool> playlist_drawer_reserved: false;
    in-out property <bool> settings_drawer_reserved: false;
    in-out property <bool> shortcut_overlay_visible: false;
    in-out property <bool> error_visible: false;
    in-out property <string> error_message: "";
    in-out property <bool> drop_target_visible: false;
    in property <[string]> playlist_items;
    in-out property <int> playlist_current_index: -1;

    callback open_file();
    callback open_folder();
    callback play_pause();
    callback stop();
    callback previous_video();
    callback next_video();
    callback seek(float);
    callback set_volume(float);
    callback set_speed(float);
    callback toggle_loop();
    callback toggle_folder_loop();
    callback toggle_shuffle();
    callback request_media_info();
    callback toggle_fullscreen();
    callback toggle_info();
    callback toggle_playlist();
    callback toggle_settings();
    callback toggle_shortcuts();
    callback seek_relative(float);
    callback adjust_volume(float);
    callback toggle_mute();
    callback play_next();
    callback play_playlist_index(int);
    callback drag_window();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.surface-canvas;
        border-radius: 0px;
        border-width: 0px;
        clip: true;

        Rectangle {
            x: -140px;
            y: -180px;
            width: 520px;
            height: 520px;
            border-radius: Theme.radius-full;
            background: Theme.accent-subtle;
            opacity: 0.42;
        }

        Rectangle {
            x: parent.width - 360px;
            y: parent.height - 320px;
            width: 460px;
            height: 460px;
            border-radius: Theme.radius-full;
            background: Theme.surface-selected;
            opacity: 0.32;
        }

        keyboard := FocusScope {
            width: parent.width;
            height: parent.height;
            focus-on-click: true;

            KeyBinding { keys: @keys(Space); activated => root.play_pause(); }
            KeyBinding { keys: @keys(K); activated => root.play_pause(); }
            KeyBinding { keys: @keys(N); activated => root.next_video(); }
            KeyBinding { keys: @keys(P); activated => root.previous_video(); }
            KeyBinding { keys: @keys(J); activated => root.seek_relative(-10.0); }
            KeyBinding { keys: @keys(L); activated => root.seek_relative(10.0); }
            KeyBinding { keys: @keys(LeftArrow); activated => root.seek_relative(-5.0); }
            KeyBinding { keys: @keys(RightArrow); activated => root.seek_relative(5.0); }
            KeyBinding { keys: @keys(UpArrow); activated => root.adjust_volume(5.0); }
            KeyBinding { keys: @keys(DownArrow); activated => root.adjust_volume(-5.0); }
            KeyBinding { keys: @keys(M); activated => root.toggle_mute(); }
            KeyBinding { keys: @keys(F); activated => root.toggle_fullscreen(); }
            KeyBinding { keys: @keys(I); activated => root.toggle_info(); }
            KeyBinding { keys: @keys(H); activated => root.toggle_shortcuts(); }
            KeyBinding { keys: @keys(O); activated => root.open_file(); }

            Rectangle {
                x: Theme.space-3;
                y: Theme.space-3;
                width: parent.width - Theme.space-6;
                height: parent.height - Theme.space-6;
                border-radius: Theme.radius-xlarge;
                background: root.media_loaded ? Theme.surface-media : transparent;
                border-width: 1px;
                border-color: Theme.border-subtle;
            }

            if !root.media_loaded : EmptyState {
                x: (parent.width - self.width) / 2;
                y: Theme.space-12 * 2;
                width: min(parent.width - Theme.space-12 * 2, Theme.space-12 * 9);
                height: parent.height - Theme.space-12 * 4;
                title: "Откройте видео";
                description: "Перетащите файл или папку в окно либо выберите их вручную";
                action-text: "Выбрать видео";
                action => root.open_file();
            }

            Rectangle {
                x: Theme.space-4;
                y: Theme.space-4;
                width: parent.width - Theme.space-8;
                height: Theme.top-bar-height;
                border-radius: Theme.radius-large;
                background: Theme.surface-glass;
                border-width: 1px;
                border-color: Theme.border-glass;
                drop-shadow-color: Theme.shadow-low;
                drop-shadow-blur: Theme.elevation-low-blur;
                drop-shadow-offset-y: Theme.elevation-low-y;
                title-drag-left := TouchArea {
                    x: 132px;
                    width: max(0px, (parent.width - 328px) / 2 - self.x);
                    height: parent.height;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.drag_window();
                        }
                    }
                    double-clicked => { root.maximized = !root.maximized; }
                }

                title-drag-right := TouchArea {
                    x: (parent.width + 328px) / 2;
                    width: max(0px, parent.width - self.x - 128px);
                    height: parent.height;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.drag_window();
                        }
                    }
                    double-clicked => { root.maximized = !root.maximized; }
                }

                HorizontalLayout {
                    x: Theme.space-3;
                    width: 112px;
                    height: parent.height;
                    spacing: Theme.space-2;
                    alignment: center;

                    Icon {
                        source: @image-url("icons/oxide.svg");
                        size: Theme.icon-large;
                        tint: Theme.accent;
                    }

                    UiText {
                        text: "Oxide";
                        variant: TextVariant.label;
                        vertical-alignment: center;
                    }
                }

                UiText {
                    x: 108px;
                    width: max(0px, (parent.width - 328px) / 2 - self.x - Theme.space-2);
                    height: parent.height;
                    text: root.media_loaded
                        ? root.file_name + "  ·  " + (root.is_playing ? "Воспроизведение" : "Пауза")
                        : "";
                    variant: TextVariant.caption;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }

                HorizontalLayout {
                    x: (parent.width - self.width) / 2;
                    width: 328px;
                    height: parent.height;
                    spacing: Theme.space-2;
                    alignment: center;

                    IconButton {
                        icon: @image-url("icons/file-video.svg");
                        accessible-name: "Открыть видео";
                        clicked => root.open_file();
                    }

                    IconButton {
                        icon: @image-url("icons/folder-open.svg");
                        accessible-name: "Открыть папку";
                        clicked => root.open_folder();
                    }

                    IconButton {
                        icon: @image-url("icons/playlist.svg");
                        accessible-name: "Плейлист";
                        selected: root.playlist_drawer_visible;
                        clicked => root.toggle_playlist();
                    }

                    IconButton {
                        icon: @image-url("icons/info.svg");
                        accessible-name: "Информация о файле";
                        selected: root.info_drawer_visible;
                        clicked => root.toggle_info();
                    }

                    IconButton {
                        icon: @image-url("icons/settings.svg");
                        accessible-name: "Настройки";
                        selected: root.settings_drawer_visible;
                        clicked => root.toggle_settings();
                    }

                    IconButton {
                        icon: @image-url("icons/help.svg");
                        accessible-name: "Горячие клавиши";
                        selected: root.shortcut_overlay_visible;
                        clicked => root.toggle_shortcuts();
                    }

                    IconButton {
                        icon: @image-url("icons/maximize.svg");
                        accessible-name: "Полноэкранный режим";
                        clicked => root.toggle_fullscreen();
                    }

                }

                HorizontalLayout {
                    x: parent.width - self.width - Theme.space-2;
                    width: Theme.space-10 * 3;
                    height: parent.height;
                    spacing: Theme.space-0;
                    alignment: center;

                    IconButton {
                        icon: @image-url("icons/window-minimize.svg");
                        accessible-name: "Свернуть окно";
                        capture-focus: false;
                        clicked => { root.minimized = true; }
                    }

                    IconButton {
                        icon: @image-url("icons/window-maximize.svg");
                        accessible-name: root.maximized ? "Восстановить окно" : "Развернуть окно";
                        capture-focus: false;
                        clicked => { root.maximized = !root.maximized; }
                    }

                    IconButton {
                        icon: @image-url("icons/window-close.svg");
                        accessible-name: "Закрыть окно";
                        danger: true;
                        capture-focus: false;
                        clicked => { root.close(); }
                    }
                }
            }

            PlayerControls {
                x: Theme.space-4;
                y: parent.height - self.height - Theme.space-4;
                width: parent.width - Theme.space-8;
                media_loaded: root.media_loaded;
                is_playing: root.is_playing;
                progress <=> root.progress;
                time_pos: root.current_time;
                time_duration: root.total_time;
                duration_seconds: root.duration_seconds;
                volume: root.volume;
                muted: root.muted;
                loop_enabled: root.loop_enabled;
                play_pause => root.play_pause();
                stop => root.stop();
                previous => root.previous_video();
                next => root.next_video();
                seek(value) => root.seek(value);
                set_volume(value) => root.set_volume(value);
                toggle_mute => root.toggle_mute();
                toggle_loop => root.toggle_loop();
            }

            NextVideoCard {
                card_visible: root.next_card_visible;
                next_file: root.next_file;
                parent_width: parent.width;
                parent_height: parent.height;
                play_next => root.play_next();
            }

            InfoDrawer {
                drawer_visible: root.info_drawer_visible;
                file_name: root.file_name;
                codec: root.codec;
                audio_codec: root.audio_codec;
                resolution: root.resolution;
                fps: root.fps;
                parent_width: parent.width;
                parent_height: parent.height;
            }

            PlaylistDrawer {
                drawer-visible: root.playlist_drawer_visible;
                items: root.playlist_items;
                current-index: root.playlist_current_index;
                parent-width: parent.width;
                parent-height: parent.height;
                play-index(index) => root.play_playlist_index(index);
            }

            SettingsDrawer {
                drawer_visible: root.settings_drawer_visible;
                speed: root.speed;
                loop_enabled: root.loop_enabled;
                folder_loop_enabled: root.folder_loop_enabled;
                shuffle_enabled: root.shuffle_enabled;
                parent_width: parent.width;
                parent_height: parent.height;
                set_speed(value) => root.set_speed(value);
                toggle_loop => root.toggle_loop();
                toggle_folder_loop => root.toggle_folder_loop();
                toggle_shuffle => root.toggle_shuffle();
            }

            ShortcutOverlay { overlay_visible: root.shortcut_overlay_visible; }

            Rectangle {
                visible: root.drop_target_visible;
                width: parent.width;
                height: parent.height;
                background: Theme.backdrop;
                border-width: 2px;
                border-color: Theme.accent;

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-3;

                    UiText {
                        text: "Перетащите сюда видео или папку";
                        variant: TextVariant.title;
                        horizontal-alignment: center;
                    }
                    UiText {
                        text: "Отпустите, чтобы начать воспроизведение";
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }
            }

            Toast {
                shown: root.error_visible;
                message: root.error_message;
                danger: true;
                x: parent.width - self.width - Theme.space-6;
                y: Theme.space-12 + Theme.space-8;
                dismissed => { root.error_visible = false; }
            }
        }
    }
}
