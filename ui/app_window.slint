import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { PlayerControls } from "components/player_controls.slint";
import { UtilityDock } from "components/utility_dock.slint";
import { AudioCanvas } from "components/audio_canvas.slint";
import { CommandEntry, CommandPaletteOverlay, ShortcutCapturePhase } from "components/command_palette.slint";
import { ConversionHistoryEntry, ConversionPresetEntry, ConverterOverlay } from "components/converter_overlay.slint";
import { AudioTrackEntry, ChapterEntry, EqualizerBandEntry, MediaInspector, RecentFileEntry, SubtitleTrackEntry } from "components/media_inspector.slint";
import { ResumePrompt } from "components/resume_prompt.slint";
import { ClearPlaybackDataPrompt } from "components/clear_playback_data_prompt.slint";
import { ResetSettingsPrompt } from "components/reset_settings_prompt.slint";
import { MediaListItem, Toast } from "design_system/composites.slint";
import { CaptionButton, EmptyState, FocusTouchArea, Icon, IconButton, Spinner, UiText, TextVariant } from "design_system/primitives.slint";

export enum PlayerPhase {
    empty,
    loading,
    playing,
    paused,
    finished,
    error,
}

export component AppWindow inherits Window {
    forward-focus: keyboard;
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: self.picture_in_picture ? 360px : 760px;
    min-height: self.picture_in_picture ? 240px : 520px;
    background: transparent;
    default-font-family: "Segoe UI Variable";
    no-frame: true;
    always-on-top: self.picture_in_picture;
    resize-border-width: self.edge_to_edge ? 0px : 6px;
    title: "Oxide";
    icon: @image-url("icons/oxide.svg");

    in-out property <string> file_name: "Не выбран файл";
    in-out property <string> audio_display_name: "Не выбран файл";
    in-out property <string> current_media_path: "";
    in-out property <string> codec: "—";
    in-out property <string> audio_codec: "—";
    in-out property <string> container_format: "—";
    in-out property <string> file_size_label: "—";
    in-out property <string> media_duration_label: "—";
    in-out property <string> media_bitrate_label: "—";
    in-out property <string> track_summary: "—";
    in property <string> app_version: "";
    in-out property <int> update_status: 0;
    in-out property <string> update_version: "";
    in-out property <string> update_message: "Канал обновлений ещё не подключён к этой сборке";
    in-out property <string> update_notes: "";
    in-out property <float> update_progress: 0;
    in-out property <string> track_title: "";
    in-out property <string> track_artist: "";
    in-out property <string> album_title: "";
    in property <[AudioTrackEntry]> audio_tracks;
    in property <[RecentFileEntry]> recent_files;
    in property <[SubtitleTrackEntry]> subtitle_tracks;
    in-out property <bool> subtitles_enabled: false;
    in-out property <float> audio_delay: 0;
    in-out property <float> subtitle_delay: 0;
    in property <[ChapterEntry]> chapters;
    in-out property <int> current_chapter_index: -1;
    in-out property <int> aspect_ratio_index: 0;
    in-out property <bool> hardware_decoding_enabled: false;
    in-out property <string> hardware_decoder: "no";
    in-out property <bool> equalizer_enabled: false;
    in-out property <int> equalizer_preset_index: 0;
    in-out property <float> equalizer_preamp_db: 0;
    in property <[EqualizerBandEntry]> equalizer_bands;
    in-out property <image> album_art;
    in-out property <bool> album_art_available: false;
    out property <bool> dark_theme: theme_mode == 1
        || (theme_mode == 0 && system_dark_theme);
    in-out property <int> theme_mode: 0;
    in-out property <bool> system_dark_theme: false;
    in-out property <int> accent_mode: 0;
    in-out property <string> resolution: "—";
    in-out property <string> fps: "—";
    in-out property <string> current_time: "00:00";
    in-out property <string> total_time: "00:00";
    in-out property <float> duration_seconds: 0.0;
    in-out property <float> progress: 0.0;
    in-out property <bool> is_playing: false;
    in-out property <bool> media_loaded: false;
    in-out property <bool> media_transitioning: false;
    in-out property <bool> waiting_for_video_surface: false;
    in-out property <bool> integrated_video_renderer: false;
    in-out property <bool> audio_media: false;
    in-out property <PlayerPhase> player_phase: PlayerPhase.empty;
    in-out property <string> loading_title: "Открываем медиафайл";
    out property <string> player_phase_label: media_transitioning ? "Переключение"
        : player_phase == PlayerPhase.loading ? "Загрузка"
        : player_phase == PlayerPhase.playing ? "Воспроизведение"
        : player_phase == PlayerPhase.paused ? "Пауза"
        : player_phase == PlayerPhase.finished ? "Завершено"
        : player_phase == PlayerPhase.error ? "Ошибка"
        : "";
    in-out property <float> volume: 0.65;
    in-out property <bool> muted: false;
    private property <bool> volume_feedback_armed: false;
    private property <bool> volume_feedback_visible: false;
    in-out property <float> speed: 1.0;
    in-out property <bool> loop_enabled: false;
    in-out property <bool> folder_loop_enabled: false;
    in-out property <bool> shuffle_enabled: false;
    in-out property <string> next_file: "";
    in-out property <bool> next_card_visible: false;
    in-out property <bool> info_drawer_visible: false;
    in-out property <bool> playlist_drawer_visible: false;
    in-out property <bool> settings_drawer_visible: false;
    in-out property <bool> inspector_audio_reserved: false;
    in-out property <bool> inspector_left_aligned: true;
    in-out property <bool> inspector_side_switching: false;
    in-out property <bool> fullscreen_mode: false;
    in-out property <bool> picture_in_picture: false;
    in-out property <bool> window_active: true;
    in-out property <float> window_scale_factor: 1.0;
    out property <bool> window_minimized: self.minimized;
    out property <bool> window_maximized: self.maximized;
    out property <bool> edge_to_edge: self.maximized || self.fullscreen_mode;
    in-out property <int> shortcut_capture_action: 0;
    in-out property <bool> shortcut_capture_active: false;
    in-out property <string> shortcut_capture_error: "";
    in-out property <ShortcutCapturePhase> shortcut_capture_phase: ShortcutCapturePhase.idle;
    in-out property <bool> shortcut_capture_focused: false;
    in-out property <bool> shortcut_close_pending: false;
    in-out property <float> shortcut_close_remaining: 3;
    in-out property <image> shortcut_close_background;
    in-out property <bool> shortcut_close_background_ready: false;
    callback prepare_shortcut_close(float, float, float, float);
    callback shortcut_close_state_changed(bool);
    callback finish_shortcut_close();
    changed shortcut_close_pending => root.shortcut_close_state_changed(root.shortcut_close_pending);
    finish_shortcut_close => command-palette.finish-close();
    edit_command_query(action) => command-palette.edit-query(action);
    in-out property <bool> shortcut_capture_dirty: false;
    in-out property <string> shortcut_capture_preview: "";
    in-out property <int> shortcut_saved_action: 0;
    in-out property <bool> shortcut_saved_visible: false;
    in-out property <bool> command_palette_visible: false;
    in-out property <string> command_query: "";
    out property <bool> command_query_focused: command-palette.search-focused;
    in property <[CommandEntry]> command_items;
    in-out property <bool> converter_visible: false;
    in-out property <string> conversion_output_path: "";
    in-out property <int> conversion_preset_index: 0;
    in property <[ConversionPresetEntry]> conversion_presets;
    in-out property <string> conversion_preset_title: "";
    in-out property <string> conversion_preset_description: "";
    in-out property <string> conversion_preset_summary: "";
    in-out property <string> conversion_preset_size_note: "";
    in-out property <int> conversion_resolution_index: 0;
    in-out property <int> conversion_bitrate_index: 0;
    in-out property <int> conversion_encoding_speed_index: 0;
    in-out property <bool> conversion_keep_audio_tracks: true;
    in-out property <bool> conversion_keep_subtitle_tracks: true;
    in-out property <string> conversion_source_size: "—";
    in-out property <string> conversion_source_path: "";
    in-out property <string> conversion_source_name: "Выберите исходный файл";
    in-out property <string> conversion_source_duration: "—";
    in-out property <string> conversion_source_format: "—";
    in-out property <float> conversion_source_duration_seconds: 0;
    in-out property <bool> conversion_audio_media: false;
    in-out property <bool> conversion_source_loading: false;
    in-out property <string> conversion_source_error: "";
    in-out property <string> conversion_size_status: "";
    in-out property <bool> ffmpeg_available: false;
    in-out property <string> ffmpeg_details: "Проверка FFmpeg…";
    in-out property <bool> conversion_running: false;
    in-out property <int> conversion_queue_count: 0;
    in property <[ConversionHistoryEntry]> conversion_history;
    in-out property <float> conversion_progress: 0;
    in-out property <string> conversion_status: "";
    in-out property <bool> resume_prompt_visible: false;
    in-out property <bool> clear_playback_data_prompt_visible: false;
    in-out property <bool> reset_settings_prompt_visible: false;
    in-out property <string> resume_position_label: "00:00";
    in-out property <bool> controls_visible: true;
    in-out property <bool> controls_pointer_over: false;
    out property <bool> inspector_visible: info_drawer_visible
        || playlist_drawer_visible || settings_drawer_visible;
    out property <bool> media_presented: media_loaded
        && (media_transitioning
            || player_phase == PlayerPhase.playing || player_phase == PlayerPhase.paused);
    out property <bool> controls_can_hide: media_presented && is_playing
        && !controls_pointer_over
        && !inspector_visible
        && !command_palette_visible && !converter_visible
        && !resume_prompt_visible
        && !clear_playback_data_prompt_visible
        && !reset_settings_prompt_visible
        && !error_visible && !drop_target_visible;
    out property <length> controls_top_zone: Theme.top-bar-height + Theme.space-2;
    out property <length> controls_bottom_zone: media_presented
        ? Theme.player-controls-height + (self.width < 1080px ? Theme.space-6 : 0px)
        : 0px;
    // AudioCanvas is always composed by Slint and can safely remain beneath
    // both translucent chrome overlays.
    out property <length> audio_top_inset: 0px;
    out property <length> audio_bottom_inset: 0px;
    out property <length> player_controls_slide_offset: controls_visible
        || volume_feedback_visible
        ? 0px
        : Theme.space-3;
    in-out property <bool> error_visible: false;
    in-out property <string> error_message: "";
    in-out property <bool> notice_visible: false;
    in-out property <string> notice_message: "";
    in-out property <bool> playback_data_cleared: false;
    in-out property <bool> settings_reset_done: false;
    in-out property <bool> drop_target_visible: false;
    in property <[string]> playlist_items;
    in-out property <int> playlist_current_index: -1;
    in-out property <int> playlist_focus_revision: 0;
    out property <length> inspector_media_inset: self.width >= 1100px ? 464px : 416px;
    out property <length> audio_left_panel_inset: inspector_audio_reserved && inspector_left_aligned
        ? inspector_media_inset : edge_to_edge ? 0px : Theme.space-4;
    out property <length> audio_right_panel_inset: inspector_audio_reserved && !inspector_left_aligned
            ? inspector_media_inset
            : edge_to_edge ? 0px : Theme.space-4;
    out property <bool> modal_overlay_active: command-palette.visible || converter-overlay.visible
        || resume-prompt.visible || clear-data-prompt.visible
        || reset-settings-prompt.visible || drop-overlay.visible;

    callback open_file();
    callback open_folder();
    callback play_pause();
    callback stop();
    callback previous_video();
    callback next_video();
    callback seek(float);
    callback set_volume(float);
    callback set_speed(float);
    callback persist_playback_defaults(float, float);
    callback persist_muted(bool);
    callback persist_shuffle(bool);
    callback select_audio_track(int);
    callback select_subtitle_track(int);
    callback load_subtitle();
    callback adjust_audio_delay(float);
    callback adjust_subtitle_delay(float);
    callback reset_audio_delay();
    callback reset_subtitle_delay();
    callback select_chapter(int);
    callback set_aspect_ratio(int);
    callback set_hardware_decoding(bool);
    callback choose_theme(int);
    callback choose_accent(int);
    callback set_equalizer_enabled(bool);
    callback set_equalizer_preset(int);
    callback adjust_equalizer_preamp(float);
    callback adjust_equalizer_band(int, float);
    callback reset_equalizer();
    callback toggle_loop();
    callback set_folder_loop(bool);
    callback toggle_shuffle();
    callback request_media_info();
    callback toggle_fullscreen();
    callback toggle_picture_in_picture();
    callback toggle_info();
    callback toggle_playlist();
    callback toggle_settings();
    callback reset_shortcuts();
    callback begin_shortcut_edit(int);
    callback save_shortcut_edit(bool);
    callback preview_default_shortcut();
    callback toggle_command_palette();
    callback command_query_changed(string);
    callback edit_command_query(int);
    callback open_converter();
    callback choose_conversion_source();
    callback choose_conversion_output(int);
    callback start_conversion(int);
    callback cancel_conversion();
    callback clear_conversion_queue();
    callback seek_relative(float);
    callback step_frame(int);
    callback adjust_volume(float);
    callback toggle_mute();
    callback play_playlist_index(int);
    callback remove_playlist_index(int);
    callback open_recent(string);
    callback resume_saved_playback();
    callback restart_saved_playback();
    callback clear_playback_data();
    callback reset_settings();
    callback check_update();
    callback download_update();
    callback pause_update();
    callback resume_update();
    callback cancel_update();
    callback skip_update();
    callback install_update();
    callback drag_window();

    animate player_controls_slide_offset {
        duration: Theme.motion-gentle;
        easing: cubic-bezier(0.16, 1, 0.3, 1);
    }

    // Audio is fully composed by Slint and can transition smoothly.
    animate audio_left_panel_inset, audio_right_panel_inset {
        duration: Theme.motion-slow;
        easing: cubic-bezier(0.4, 0, 0.2, 1);
    }

    changed controls_can_hide => {
        if (root.controls_can_hide) {
            root.reveal-controls();
        } else {
            root.reveal-controls();
            controls-hide-timer.stop();
        }
    }

    controls-hide-timer := Timer {
        interval: 5000ms;
        running: false;
        triggered => {
            if (root.controls_can_hide) {
                root.controls_visible = false;
                self.stop();
            }
        }
    }

    playback-defaults-save-timer := Timer {
        interval: 650ms;
        running: false;
        triggered => {
            root.persist_playback_defaults(root.volume, root.speed);
            self.stop();
        }
    }

    volume-feedback-arm-timer := Timer {
        interval: 750ms;
        running: true;
        triggered => {
            root.volume_feedback_armed = true;
            self.stop();
        }
    }

    volume-feedback-hide-timer := Timer {
        interval: 800ms;
        running: false;
        triggered => {
            root.volume_feedback_visible = false;
            self.stop();
        }
    }

    public function reveal-controls() {
        root.controls_visible = true;
        if (root.controls_can_hide) {
            controls-hide-timer.start();
            controls-hide-timer.restart();
        }
    }

    public function schedule-playback-defaults-save() {
        playback-defaults-save-timer.start();
        playback-defaults-save-timer.restart();
    }

    public function reveal-volume-feedback() {
        if (root.volume_feedback_armed) {
            root.volume_feedback_visible = true;
            volume-feedback-hide-timer.start();
            volume-feedback-hide-timer.restart();
        }
    }

    changed volume => root.reveal-volume-feedback();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.media_presented && root.audio_media
            ? root.edge_to_edge
                ? Theme.media-canvas-background-opaque
                : Theme.media-canvas-background
            : root.media_presented && root.integrated_video_renderer
                ? transparent
                : root.edge_to_edge
                    ? Theme.canvas-background-opaque
                    : Theme.canvas-background;
        border-radius: root.edge_to_edge
            ? 0px
            : Theme.is-dark ? Theme.radius-large : Theme.radius-medium;
        // A contrasting one-pixel stroke showed up mainly in the antialiased
        // corners. The rounded canvas already separates itself from the desktop.
        border-width: 0px;
        border-color: transparent;
        clip: true;

        keyboard := FocusScope {
            width: parent.width;
            height: parent.height;
            focus-on-click: true;

            media-backdrop := Rectangle {
                // Audio's translucent gradient already belongs to the outer canvas.
                // Keep this rectangle full-size for stable transitions, but avoid a
                // second tint that would make audio darker than the video surround.
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: root.media_presented
                    ? root.audio_media
                        ? transparent
                        : root.integrated_video_renderer ? transparent : Theme.surface-media
                    : transparent;

                animate background {
                    duration: Theme.motion-normal;
                    easing: cubic-bezier(0.2, 0, 0, 1);
                }
            }

            if root.integrated_video_renderer && root.media_presented
                && !root.audio_media : TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                double-clicked => root.toggle_fullscreen();
            }

            AudioCanvas {
                x: root.audio_left_panel_inset;
                y: root.audio_top_inset;
                width: max(0px, parent.width - self.x - root.audio_right_panel_inset);
                height: max(0px, parent.height - self.y - root.audio_bottom_inset);
                // Keep the old media surface alive until mpv presents the next
                // frame, but never show stale artwork as if it belonged to the
                // file currently being opened. AudioCanvas owns the fade-out.
                shown: root.media_presented && root.audio_media
                    && !root.media_transitioning;
                animation-enabled: !root.window_minimized;
                expanded: root.maximized || root.fullscreen_mode;
                file-name: root.audio_display_name;
                audio-codec: root.audio_codec;
                track-title: root.track_title;
                track-artist: root.track_artist;
                album-title: root.album_title;
                album-art: root.album_art;
                album-art-available: root.album_art_available;
                is-playing: root.is_playing;
                fullscreen => root.toggle_fullscreen();
            }

            outside-drawer-dismiss := TouchArea {
                enabled: root.inspector_visible;
                width: parent.width;
                height: parent.height;
                clicked => {
                    if (root.info_drawer_visible) { root.toggle_info(); }
                    if (root.playlist_drawer_visible) { root.toggle_playlist(); }
                    if (root.settings_drawer_visible) { root.toggle_settings(); }
                }
            }

            if root.player_phase == PlayerPhase.empty
                || root.player_phase == PlayerPhase.finished : empty-stage := Rectangle {
                private property <float> safe-scale: max(0.1, root.window_scale_factor);
                private property <length> target-width:
                    min(parent.width - Theme.space-8 * 2, 520px);
                private property <bool> compact-content:
                    root.recent_files.length > 0 || root.playback_data_cleared;
                private property <length> recent-panel-height: Theme.space-12
                    + min(root.recent_files.length, 3)
                        * (Theme.space-12 + Theme.space-1)
                    + Theme.space-4;
                private property <length> stack-height: 180px + 72px + Theme.space-4
                    + (compact-content
                        ? Theme.space-4 + (root.playback_data_cleared
                            ? Theme.space-12 : recent-panel-height)
                        : 0px);

                // Center the complete empty-state stack on physical pixels.
                // A half-pixel layout origin made the small recent-file text
                // and its clear action look softer at fractional DPI scales.
                width: Math.floor(target-width / 1px * safe-scale)
                    / safe-scale * 1px;
                x: Math.round((parent.width - self.width) / 2 / 1px * safe-scale)
                    / safe-scale * 1px;
                y: Theme.top-bar-height;
                height: parent.height - Theme.top-bar-height;
                background: transparent;

                VerticalLayout {
                    y: Math.round((parent.height - empty-stage.stack-height)
                        / 2 / 1px * empty-stage.safe-scale)
                        / empty-stage.safe-scale * 1px;
                    width: parent.width;
                    height: empty-stage.stack-height;
                    alignment: center;
                    spacing: Theme.space-4;

                    EmptyState {
                        width: parent.width;
                        height: 180px;
                        title: root.player_phase == PlayerPhase.finished
                            ? "Воспроизведение завершено" : "Откройте медиафайл";
                        description: root.player_phase == PlayerPhase.finished
                            ? "Выберите другой файл, папку или недавнее медиа"
                            : "Перетащите видео, аудио или папку в окно либо выберите их вручную";
                        action-text: "Открыть файл";
                        secondary-action-text: "Открыть папку";
                        action => root.open_file();
                        secondary-action => root.open_folder();
                    }

                    UtilityDock {
                        width: parent.width;
                        volume <=> root.volume;
                        muted <=> root.muted;
                        volume-feedback-visible: root.volume_feedback_visible;
                        settings-open: root.settings_drawer_visible;
                        command-palette-open: root.command_palette_visible;
                        converter-open: root.converter_visible;
                        set-volume(value) => {
                            root.volume = value;
                            root.set_volume(value);
                            root.schedule-playback-defaults-save();
                        }
                        toggle-mute => root.toggle_mute();
                        toggle-settings => root.toggle_settings();
                        show-commands => root.toggle_command_palette();
                        open-converter => root.open_converter();
                    }

                    if root.playback_data_cleared : HorizontalLayout {
                        width: parent.width;
                        height: Theme.space-12;
                        alignment: center;

                        Rectangle {
                            width: min(parent.width, 360px);
                            height: parent.height;
                            border-radius: Theme.radius-medium;
                            border-width: 1px;
                            border-color: Theme.accent;
                            background: Theme.accent-subtle;

                            UiText {
                                width: parent.width;
                                height: parent.height;
                                text: "История и позиции очищены";
                                variant: TextVariant.label;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.recent_files.length > 0 : Rectangle {
                        width: parent.width;
                        height: empty-stage.recent-panel-height;
                        border-radius: Theme.radius-large;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        background: Theme.surface-control;
                        clip: true;

                        VerticalLayout {
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-3;
                            padding-top: Theme.space-2;
                            padding-bottom: Theme.space-2;
                            spacing: Theme.space-1;

                            Rectangle {
                                height: Theme.space-10;
                                background: transparent;

                                UiText {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "Недавние файлы";
                                    variant: TextVariant.label;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                clear-history-action := Rectangle {
                                    width: 108px;
                                    height: Theme.space-8;
                                    x: parent.width - self.width + Theme.space-1;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Theme.radius-medium;
                                    background: clear-history-hit.pressed
                                        ? Theme.surface-pressed
                                        : clear-history-hit.has-hover
                                            ? Theme.surface-hover : transparent;
                                    border-width: clear-history-hit.has-focus ? Theme.focus-ring-width : 1px;
                                    border-color: clear-history-hit.has-focus
                                        ? Theme.focus-ring
                                        : clear-history-hit.has-hover
                                            ? Theme.accent : Theme.border-default;
                                    accessible-role: button;
                                    accessible-label: "Очистить историю";
                                    accessible-action-default => {
                                        root.clear_playback_data_prompt_visible = true;
                                    }

                                    clear-history-hit := FocusTouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        clicked => {
                                            root.clear_playback_data_prompt_visible = true;
                                        }
                                    }

                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        spacing: Theme.space-1;
                                        alignment: center;

                                        Rectangle {
                                            width: 16px;
                                            height: parent.height;
                                            background: transparent;

                                            Icon {
                                                y: (parent.height - self.height) / 2;
                                                width: 16px;
                                                height: 16px;
                                                source: @image-url("icons/trash.svg");
                                                tint: clear-history-hit.has-hover
                                                    ? Theme.accent : Theme.text-muted;
                                            }
                                        }

                                        UiText {
                                            width: 56px;
                                            height: parent.height;
                                            text: "Очистить";
                                            variant: TextVariant.caption;
                                            color: clear-history-hit.has-hover
                                                ? Theme.accent : Theme.text-secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    animate background, border-color {
                                        duration: Theme.motion-fast;
                                        easing: cubic-bezier(0.2, 0, 0, 1);
                                    }
                                }
                            }

                            ListView {
                                height: min(root.recent_files.length, 3)
                                    * (Theme.space-12 + Theme.space-1);

                                for entry in root.recent_files : Rectangle {
                                    width: parent.width;
                                    height: Theme.space-12 + Theme.space-1;
                                    background: transparent;

                                    MediaListItem {
                                        width: parent.width;
                                        title: entry.name;
                                        subtitle: entry.location;
                                        activated => root.open_recent(entry.path);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.player_phase == PlayerPhase.loading : Rectangle {
                x: (parent.width - self.width) / 2;
                y: Theme.top-bar-height;
                width: min(parent.width - Theme.space-8 * 2, 440px);
                height: parent.height - Theme.top-bar-height;
                background: transparent;

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-3;

                    Spinner { spinner-color: Theme.accent; }
                    UiText {
                        text: root.loading_title;
                        variant: TextVariant.heading;
                        horizontal-alignment: center;
                    }
                    UiText {
                        text: root.file_name;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }

            if root.player_phase == PlayerPhase.error : EmptyState {
                x: (parent.width - self.width) / 2;
                y: Theme.top-bar-height;
                width: min(parent.width - Theme.space-8 * 2, 440px);
                height: parent.height - Theme.top-bar-height;
                title: "Не удалось воспроизвести медиафайл";
                description: root.error_message;
                action-text: "Выбрать другой файл";
                action => root.open_file();
            }

            top-bar := Rectangle {
                property <bool> show-converter: root.media_loaded
                    && !root.media_presented && !root.picture_in_picture;
                property <length> converter-space: show-converter ? Theme.space-12 : 0px;
                x: 0px;
                y: root.fullscreen_mode ? -self.height
                    : !root.picture_in_picture || root.controls_visible
                        ? 0px : -Theme.space-2;
                width: parent.width;
                height: Theme.top-bar-height;
                opacity: root.fullscreen_mode ? 0
                    : !root.picture_in_picture || root.controls_visible ? 1 : 0;
                visible: !root.fullscreen_mode || self.opacity > 0.01;
                border-top-left-radius: root.edge_to_edge
                    ? 0px
                    : Theme.is-dark ? Theme.radius-large : Theme.radius-medium;
                border-top-right-radius: self.border-top-left-radius;
                clip: true;
                background: Theme.surface-chrome;
                border-width: 0px;
                title-drag := TouchArea {
                    enabled: !root.fullscreen_mode;
                    x: 132px;
                    width: max(0px, parent.width - self.x
                        - Theme.caption-button-width * 3 - Theme.space-4 - top-bar.converter-space);
                    height: parent.height;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.drag_window();
                        }
                    }
                    double-clicked => {
                        if (root.picture_in_picture) { root.toggle_picture_in_picture(); }
                        else { root.maximized = !root.maximized; }
                    }
                }

                Rectangle {
                    x: Theme.space-4;
                    width: 116px;
                    height: parent.height;
                    background: transparent;

                    Image {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("icons/oxide.svg");
                        width: Theme.icon-small;
                        height: Theme.icon-small;
                        image-fit: contain;
                    }

                    UiText {
                        x: Theme.space-6;
                        width: parent.width - self.x;
                        height: parent.height;
                        text: "Oxide";
                        variant: TextVariant.label;
                        vertical-alignment: center;
                    }
                }

                UiText {
                    x: 140px;
                    width: max(0px, parent.width - self.x
                        - Theme.caption-button-width * 3 - Theme.space-6 - top-bar.converter-space);
                    height: parent.height;
                    text: root.player_phase != PlayerPhase.empty
                        ? root.file_name + "  ·  " + root.player_phase_label
                        : "";
                    variant: TextVariant.caption;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if top-bar.show-converter : IconButton {
                    x: parent.width - Theme.caption-button-width * 3 - Theme.space-12;
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/convert.svg");
                    accessible-name: "Конвертация медиа";
                    selected: root.converter_visible;
                    capture-focus: false;
                    clicked => root.open_converter();
                }

                HorizontalLayout {
                    visible: !root.fullscreen_mode;
                    x: parent.width - self.width;
                    width: Theme.caption-button-width * 3;
                    height: parent.height;
                    spacing: 0px;
                    alignment: center;

                    CaptionButton {
                        icon: @image-url("icons/window-minimize.svg");
                        accessible-name: "Свернуть окно";
                        window-active: root.window_active;
                        clicked => { root.minimized = true; }
                    }

                    CaptionButton {
                        icon: root.maximized
                            ? @image-url("icons/window-restore.svg")
                            : @image-url("icons/window-maximize.svg");
                        accessible-name: root.maximized ? "Восстановить окно" : "Развернуть окно";
                        window-active: root.window_active;
                        clicked => {
                            if (root.picture_in_picture) { root.toggle_picture_in_picture(); }
                            else { root.maximized = !root.maximized; }
                        }
                    }

                    CaptionButton {
                        icon: @image-url("icons/window-close.svg");
                        accessible-name: "Закрыть окно";
                        danger: true;
                        window-active: root.window_active;
                        top-right-radius: root.edge_to_edge
                            ? 0px
                            : Theme.is-dark ? Theme.radius-large : Theme.radius-medium;
                        clicked => { root.close(); }
                    }
                }

                animate y, opacity {
                    duration: root.fullscreen_mode
                        ? Theme.motion-fast : Theme.motion-normal;
                    easing: cubic-bezier(0.16, 1, 0.3, 1);
                }
            }

            player-controls := PlayerControls {
                x: 0px;
                y: parent.height - self.height + root.player_controls_slide_offset;
                width: parent.width;
                opacity: root.media_presented
                    && (root.controls_visible || root.volume_feedback_visible) ? 1 : 0;
                visible: root.media_presented
                    && (root.controls_visible || root.volume_feedback_visible
                        || self.opacity > 0.01);
                media_loaded: root.media_loaded;
                is_playing: root.is_playing;
                progress <=> root.progress;
                time_pos: root.current_time;
                time_duration: root.total_time;
                duration_seconds: root.duration_seconds;
                volume <=> root.volume;
                muted <=> root.muted;
                volume-feedback-visible: root.volume_feedback_visible;
                loop_enabled: root.loop_enabled;
                edge_to_edge: root.edge_to_edge;
                fullscreen_active: root.fullscreen_mode;
                playlist_open: root.playlist_drawer_visible;
                info_open: root.info_drawer_visible;
                settings_open: root.settings_drawer_visible;
                command_palette_open: root.command_palette_visible;
                converter_open: root.converter_visible;
                picture_in_picture_active: root.picture_in_picture;
                next_file: root.next_card_visible ? root.next_file : "";
                scale-factor: root.window_scale_factor;
                open_file => root.open_file();
                open_folder => root.open_folder();
                toggle_playlist => root.toggle_playlist();
                toggle_info => root.toggle_info();
                play_pause => root.play_pause();
                previous => root.previous_video();
                next => root.next_video();
                seek(value) => root.seek(value);
                set_volume(value) => {
                    root.volume = value;
                    root.set_volume(value);
                    root.schedule-playback-defaults-save();
                }
                toggle_mute => root.toggle_mute();
                toggle_loop => root.toggle_loop();
                toggle_settings => root.toggle_settings();
                toggle_fullscreen => root.toggle_fullscreen();
                toggle_picture_in_picture => root.toggle_picture_in_picture();
                show_more => root.toggle_command_palette();
                open_converter => root.open_converter();

                animate opacity {
                    duration: Theme.motion-dismiss;
                    easing: cubic-bezier(0.16, 1, 0.3, 1);
                }
            }

            settings-modal-backdrop := Rectangle {
                width: parent.width;
                height: parent.height;
                opacity: root.settings_drawer_visible && !root.media_presented ? 1 : 0;
                visible: (root.settings_drawer_visible && !root.media_presented)
                    || self.opacity > 0.01;
                background: Theme.backdrop;

                TouchArea {
                    enabled: root.settings_drawer_visible && !root.media_presented;
                    clicked => root.toggle_settings();
                }

                animate opacity {
                    duration: Theme.motion-normal;
                    easing: cubic-bezier(0.2, 0, 0, 1);
                }
            }

            inspector := MediaInspector {
                open: root.inspector_visible;
                left-aligned: root.inspector_left_aligned;
                playlist-open: root.playlist_drawer_visible;
                info-open: root.info_drawer_visible;
                playback-open: root.settings_drawer_visible;
                items: root.playlist_items;
                recent-files: root.recent_files;
                playback-data-cleared: root.playback_data_cleared;
                settings-reset-done: root.settings_reset_done;
                current-index: root.playlist_current_index;
                playlist-focus-revision: root.playlist_focus_revision;
                file-name: root.file_name;
                codec: root.codec;
                audio-codec: root.audio_codec;
                container-format: root.container_format;
                file-size-label: root.file_size_label;
                media-duration-label: root.media_duration_label;
                media-bitrate-label: root.media_bitrate_label;
                track-summary: root.track_summary;
                app-version: root.app_version;
                update-status: root.update_status;
                update-version: root.update_version;
                update-message: root.update_message;
                update-notes: root.update_notes;
                update-progress: root.update_progress;
                resolution: root.resolution;
                fps: root.fps;
                audio-media: root.audio_media;
                media-loaded: root.media_loaded;
                audio-tracks: root.audio_tracks;
                subtitle-tracks: root.subtitle_tracks;
                subtitles-enabled: root.subtitles_enabled;
                audio-delay: root.audio_delay;
                subtitle-delay: root.subtitle_delay;
                chapters: root.chapters;
                current-chapter-index: root.current_chapter_index;
                aspect-ratio-index: root.aspect_ratio_index;
                hardware-decoding-enabled: root.hardware_decoding_enabled;
                hardware-decoder: root.hardware_decoder;
                integrated-video-renderer: root.integrated_video_renderer;
                theme-mode: root.theme_mode;
                accent-mode: root.accent_mode;
                equalizer-enabled: root.equalizer_enabled;
                equalizer-preset-index: root.equalizer_preset_index;
                equalizer-preamp-db: root.equalizer_preamp_db;
                equalizer-bands: root.equalizer_bands;
                speed: root.speed;
                folder-loop-enabled: root.folder_loop_enabled;
                shuffle-enabled: root.shuffle_enabled;
                parent-width: parent.width;
                parent-height: parent.height;
                scale-factor: root.window_scale_factor;
                fullscreen-active: root.fullscreen_mode;
                media-presented: root.media_presented;
                modal-mode: root.settings_drawer_visible && !root.media_presented;
                side-switching: root.inspector_side_switching;
                show-playlist => root.toggle_playlist();
                show-info => root.toggle_info();
                show-playback => root.toggle_settings();
                close => {
                    if (root.playlist_drawer_visible) { root.toggle_playlist(); }
                    else if (root.info_drawer_visible) { root.toggle_info(); }
                    else if (root.settings_drawer_visible) { root.toggle_settings(); }
                }
                play-index(index) => root.play_playlist_index(index);
                remove-index(index) => root.remove_playlist_index(index);
                open-recent(path) => root.open_recent(path);
                set-speed(value) => {
                    root.speed = value;
                    root.set_speed(value);
                    root.schedule-playback-defaults-save();
                }
                select-audio-track(id) => root.select_audio_track(id);
                select-subtitle-track(id) => root.select_subtitle_track(id);
                load-subtitle => root.load_subtitle();
                adjust-audio-delay(delta) => root.adjust_audio_delay(delta);
                adjust-subtitle-delay(delta) => root.adjust_subtitle_delay(delta);
                reset-audio-delay => root.reset_audio_delay();
                reset-subtitle-delay => root.reset_subtitle_delay();
                select-chapter(index) => root.select_chapter(index);
                set-aspect-ratio(index) => root.set_aspect_ratio(index);
                set-hardware-decoding(enabled) => root.set_hardware_decoding(enabled);
                choose-theme(mode) => root.choose_theme(mode);
                choose-accent(mode) => root.choose_accent(mode);
                step-frame(direction) => root.step_frame(direction);
                set-equalizer-enabled(enabled) => root.set_equalizer_enabled(enabled);
                set-equalizer-preset(index) => root.set_equalizer_preset(index);
                adjust-equalizer-preamp(delta) => root.adjust_equalizer_preamp(delta);
                adjust-equalizer-band(index, delta) => root.adjust_equalizer_band(index, delta);
                reset-equalizer => root.reset_equalizer();
                set-folder-loop(enabled) => root.set_folder_loop(enabled);
                toggle-shuffle => root.toggle_shuffle();
                request-clear-playback-data => {
                    root.clear_playback_data_prompt_visible = true;
                }
                request-reset-settings => {
                    root.reset_settings_prompt_visible = true;
                }
                check-update => root.check_update();
                download-update => root.download_update();
                pause-update => root.pause_update();
                resume-update => root.resume_update();
                cancel-update => root.cancel_update();
                skip-update => root.skip_update();
                install-update => root.install_update();
            }

            command-palette := CommandPaletteOverlay {
                open: root.command_palette_visible;
                scale-factor: root.window_scale_factor;
                query <=> root.command_query;
                commands: root.command_items;
                media-loaded: root.media_loaded;
                audio-media: root.audio_media;
                capture-action: root.shortcut_capture_action;
                capture-active: root.shortcut_capture_active;
                saved-action: root.shortcut_saved_action;
                saved-visible: root.shortcut_saved_visible;
                window-active: root.window_active;
                error-message: root.shortcut_capture_error;
                capture-phase <=> root.shortcut_capture_phase;
                close-pending <=> root.shortcut_close_pending;
                close-remaining: root.shortcut_close_remaining;
                close-background: root.shortcut_close_background;
                close-background-ready: root.shortcut_close_background_ready;
                prepare-close(x, y, width, height) => root.prepare_shortcut_close(x, y, width, height);
                capture-focus-changed(focused) => { root.shortcut_capture_focused = focused; }
                preview: root.shortcut_capture_preview;
                capture-dirty: root.shortcut_capture_dirty;
                query-changed(query) => root.command_query_changed(query);
                begin-capture(action) => {
                    root.begin_shortcut_edit(action);
                }
                save(overwrite) => root.save_shortcut_edit(overwrite);
                restore-default => root.preview_default_shortcut();
                reset-shortcuts => root.reset_shortcuts();
                cancel => {
                    root.shortcut_capture_active = false;
                    root.shortcut_capture_phase = ShortcutCapturePhase.idle;
                    root.shortcut_capture_focused = false;
                    root.shortcut_capture_dirty = false;
                    root.shortcut_capture_preview = "";
                    root.shortcut_capture_error = "";
                }
                close => {
                    root.command_palette_visible = false;
                    root.command_query = "";
                    root.shortcut_capture_active = false;
                    root.shortcut_capture_phase = ShortcutCapturePhase.idle;
                    root.shortcut_capture_focused = false;
                    root.shortcut_capture_dirty = false;
                    root.shortcut_capture_preview = "";
                    root.shortcut_capture_error = "";
                    root.command_query_changed("");
                }
                execute(action) => root.run-palette-command(action);
            }

            converter-overlay := ConverterOverlay {
                open: root.converter_visible;
                scale-factor: root.window_scale_factor;
                source-name: root.conversion_source_name;
                source-selected: root.conversion_source_path != "";
                source-loading: root.conversion_source_loading;
                source-error: root.conversion_source_error;
                audio-media: root.conversion_audio_media;
                presets: root.conversion_presets;
                output-path <=> root.conversion_output_path;
                preset-index <=> root.conversion_preset_index;
                preset-title <=> root.conversion_preset_title;
                preset-description <=> root.conversion_preset_description;
                preset-summary <=> root.conversion_preset_summary;
                preset-size-note <=> root.conversion_preset_size_note;
                resolution-index <=> root.conversion_resolution_index;
                bitrate-index <=> root.conversion_bitrate_index;
                encoding-speed-index <=> root.conversion_encoding_speed_index;
                keep-audio-tracks <=> root.conversion_keep_audio_tracks;
                keep-subtitle-tracks <=> root.conversion_keep_subtitle_tracks;
                source-size: root.conversion_source_size;
                source-duration: root.conversion_source_duration;
                source-format: root.conversion_source_format;
                size-status: root.conversion_size_status;
                ffmpeg-available: root.ffmpeg_available;
                ffmpeg-details: root.ffmpeg_details;
                running: root.conversion_running;
                pending-jobs: root.conversion_queue_count;
                history: root.conversion_history;
                progress: root.conversion_progress;
                status-text: root.conversion_status;
                choose-source => root.choose_conversion_source();
                choose-output(index) => root.choose_conversion_output(index);
                start(index) => root.start_conversion(index);
                cancel => root.cancel_conversion();
                clear-queue => root.clear_conversion_queue();
                close => { root.converter_visible = false; }
            }

            resume-prompt := ResumePrompt {
                open: root.resume_prompt_visible;
                file-name: root.file_name;
                position-label: root.resume_position_label;
                resume => root.resume_saved_playback();
                restart => root.restart_saved_playback();
            }

            clear-data-prompt := ClearPlaybackDataPrompt {
                open: root.clear_playback_data_prompt_visible;
                cancel => { root.clear_playback_data_prompt_visible = false; }
                confirm => {
                    root.clear_playback_data_prompt_visible = false;
                    root.clear_playback_data();
                }
            }

            reset-settings-prompt := ResetSettingsPrompt {
                open: root.reset_settings_prompt_visible;
                cancel => { root.reset_settings_prompt_visible = false; }
                confirm => {
                    root.reset_settings_prompt_visible = false;
                    root.reset_settings();
                }
            }

            drop-overlay := Rectangle {
                visible: root.drop_target_visible || self.opacity > 0.01;
                opacity: root.drop_target_visible ? 1 : 0;
                width: parent.width;
                height: parent.height;
                background: Theme.backdrop;
                border-width: 2px;
                border-color: Theme.accent;

                animate opacity {
                    duration: Theme.motion-normal;
                    easing: cubic-bezier(0.2, 0, 0, 1);
                }

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-3;

                    UiText {
                        text: "Перетащите сюда видео, аудио или папку";
                        variant: TextVariant.title;
                        horizontal-alignment: center;
                    }
                    UiText {
                        text: "Отпустите, чтобы начать воспроизведение";
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }
            }

            notice-toast := Toast {
                shown: root.notice_visible;
                message: root.notice_message;
                width: min(parent.width - Theme.space-12, Theme.space-12 * 8);
                x: parent.width - self.width - Theme.space-6;
                y: Theme.space-12 + Theme.space-8;
                dismissed => { root.notice_visible = false; }
            }

            error-toast := Toast {
                shown: root.error_visible;
                message: root.error_message;
                danger: true;
                width: min(parent.width - Theme.space-12, Theme.space-12 * 8);
                x: parent.width - self.width - Theme.space-6;
                y: Theme.space-12 + Theme.space-8
                    + (root.notice_visible ? notice-toast.height + Theme.space-2 : 0px);
                dismissed => { root.error_visible = false; }
            }
        }
    }

    init => {
        Theme.color-scheme = root.dark_theme ? ColorScheme.dark : ColorScheme.light;
        Theme.accent-mode = root.accent_mode;
    }

    changed theme_mode => {
        Theme.color-scheme = root.dark_theme ? ColorScheme.dark : ColorScheme.light;
    }

    changed system_dark_theme => {
        if (root.theme_mode == 0) {
            Theme.color-scheme = root.system_dark_theme
                ? ColorScheme.dark : ColorScheme.light;
        }
    }

    changed accent_mode => {
        Theme.accent-mode = root.accent_mode;
    }

    function run-palette-command(action: int) {
        shortcut_capture_active = false;
        shortcut_capture_phase = ShortcutCapturePhase.idle;
        shortcut_capture_focused = false;
        shortcut_capture_dirty = false;
        shortcut_capture_preview = "";
        shortcut_capture_error = "";
        command_palette_visible = false;
        command_query = "";
        command_query_changed("");
        if (action == 0) { open_file(); }
        else if (action == 1) { open_folder(); }
        else if (action == 2) { play_pause(); }
        else if (action == 3) { previous_video(); }
        else if (action == 4) { next_video(); }
        else if (action == 5) { toggle_mute(); }
        else if (action == 6) { toggle_loop(); }
        else if (action == 7) { toggle_playlist(); }
        else if (action == 8) { toggle_info(); }
        else if (action == 9) { toggle_settings(); }
        else if (action == 11) { toggle_fullscreen(); }
        else if (action == 12) { stop(); }
        else if (action == 13) { seek_relative(-10.0); }
        else if (action == 14) { seek_relative(10.0); }
        else if (action == 15) { adjust_volume(-5.0); }
        else if (action == 16) { adjust_volume(5.0); }
        else if (action == 22) { seek_relative(-5.0); }
        else if (action == 23) { seek_relative(5.0); }
        else if (action == 25) { step_frame(-1); }
        else if (action == 26) { step_frame(1); }
        else if (action == 27) { toggle_picture_in_picture(); }
        else if (action == 28) { open_converter(); }
    }
}
