import { Theme } from "../theme.slint";

export enum TextVariant {
    caption,
    body,
    label,
    heading,
    title,
}

export component UiText inherits Text {
    in property <TextVariant> variant: TextVariant.body;

    font-family: "Segoe UI Variable";
    color: Theme.text-primary;
    font-size: variant == TextVariant.caption ? Theme.text-small
        : variant == TextVariant.heading ? Theme.text-heading
        : variant == TextVariant.title ? Theme.text-title
        : Theme.text-body;
    font-weight: variant == TextVariant.label ? 600
        : variant == TextVariant.heading || variant == TextVariant.title ? 700
        : 400;
}

export component Icon inherits Image {
    in property <length> size: Theme.icon-medium;
    in property <color> tint: Theme.text-primary;

    width: size;
    height: size;
    colorize: tint;
    image-fit: contain;
}

export component FocusTouchArea {
    in property <bool> enabled: true;
    in property <bool> capture-focus: true;
    out property <bool> pressed <=> pointer.pressed;
    out property <bool> has-hover <=> pointer.has-hover;
    out property <bool> has-focus <=> focus.has-focus;
    callback clicked();

    forward-focus: focus;

    pointer := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => {
            if (root.capture-focus) {
                focus.focus();
            }
            root.clicked();
        }
    }

    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component Spinner inherits Rectangle {
    in property <bool> running: true;
    in property <color> spinner-color: Theme.text-secondary;
    private property <int> current-step: 0;

    width: Theme.icon-medium;
    height: Theme.icon-medium;
    background: transparent;

    Timer {
        interval: Theme.motion-fast;
        running: root.running;
        triggered => {
            root.current-step = Math.mod(root.current-step + 1, 3);
        }
    }

    HorizontalLayout {
        spacing: Theme.space-1;
        alignment: center;

        for dot[index] in [0, 1, 2] : Rectangle {
            width: Theme.space-1;
            height: Theme.space-1;
            border-radius: Theme.radius-full;
            background: root.spinner-color;
            opacity: root.current-step == index ? 1 : 0.35;
            animate opacity {
                duration: Theme.motion-fast;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }
        }
    }
}

export component ShortcutBadge inherits Rectangle {
    in property <string> shortcut;

    min-width: Theme.space-8;
    preferred-width: max(
        Theme.space-8,
        root.shortcut.character-count * 8px + Theme.space-4
    );
    max-width: 160px;
    min-height: Theme.space-6;
    vertical-stretch: 1;
    background: transparent;

    badge := Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: Theme.space-6;
        border-radius: Theme.radius-small;
        background: Theme.surface-control;
        border-width: 1px;
        border-color: Theme.border-default;

        UiText {
            width: parent.width;
            height: parent.height;
            text: root.shortcut;
            variant: TextVariant.label;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> loading: false;
    out property <bool> has-focus: interaction.has-focus;
    callback clicked();

    min-width: Theme.space-12 * 2;
    height: Theme.space-10;
    border-radius: Theme.radius-medium;
    background: !enabled ? Theme.surface-control
        : interaction.pressed ? (primary ? Theme.accent-pressed : Theme.surface-pressed)
        : interaction.has-hover ? (primary ? Theme.accent-hover : Theme.surface-hover)
        : primary ? Theme.accent
        : selected ? Theme.surface-selected
        : Theme.surface-control;
    border-width: interaction.has-focus ? Theme.focus-ring-width : 1px;
    border-color: interaction.has-focus ? Theme.focus-ring
        : primary ? transparent
        : selected ? Theme.accent
        : Theme.border-default;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-enabled: enabled;
    accessible-label: text;
    accessible-action-default => { if (enabled && !loading) { root.clicked(); } }
    forward-focus: interaction;

    interaction := FocusTouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled && !root.loading;
        clicked => root.clicked();
    }

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;
        alignment: center;

        if root.loading : Spinner {
            spinner-color: root.primary ? Theme.on-accent : Theme.text-secondary;
        }

        if root.shortcut != "" : ShortcutBadge {
            shortcut: root.shortcut;
        }

        UiText {
            text: root.text;
            variant: TextVariant.label;
            color: root.primary ? Theme.on-accent : Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    animate background, border-color, opacity {
        duration: Theme.motion-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> accessible-name;
    in property <bool> primary: false;
    in property <bool> circular: false;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> loading: false;
    in property <bool> danger: false;
    in property <bool> capture-focus: true;
    out property <bool> has-hover: interaction.has-hover;
    callback clicked();

    width: Theme.space-10;
    height: Theme.space-10;
    border-radius: circular ? Theme.radius-full : Theme.radius-medium;
    background: interaction.pressed ? (danger ? Theme.danger : primary ? Theme.accent-pressed : Theme.surface-pressed)
        : interaction.has-hover ? (danger ? Theme.danger : primary ? Theme.accent-hover : Theme.surface-hover)
        : primary ? Theme.accent
        : selected ? Theme.surface-selected
        : transparent;
    border-width: interaction.has-focus ? Theme.focus-ring-width : 1px;
    border-color: interaction.has-focus ? Theme.focus-ring
        : primary ? transparent
        : selected ? Theme.accent
        : transparent;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: accessible-name;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled && !loading) { root.clicked(); } }
    forward-focus: interaction;

    interaction := FocusTouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled && !root.loading;
        capture-focus: root.capture-focus;
        clicked => root.clicked();
    }

    if root.loading : Spinner {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if !root.loading : Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        tint: root.primary || (root.danger && (interaction.has-hover || interaction.pressed))
            ? Theme.on-accent
            : root.selected ? Theme.accent
            : Theme.text-primary;
    }

    animate background, border-color, opacity {
        duration: Theme.motion-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
}

export component CaptionButton inherits Rectangle {
    in property <image> icon;
    in property <string> accessible-name;
    in property <bool> danger: false;
    in property <bool> window-active: true;
    in property <length> top-right-radius: 0px;
    callback clicked();

    width: Theme.caption-button-width;
    height: Theme.top-bar-height;
    border-top-right-radius: root.top-right-radius;
    background: hit.pressed
        ? (danger ? Theme.danger : Theme.surface-pressed)
        : hit.has-hover
            ? (danger ? Theme.danger : Theme.surface-hover)
            : transparent;
    accessible-role: button;
    accessible-label: accessible-name;
    accessible-action-default => root.clicked();

    hit := TouchArea {
        clicked => root.clicked();
    }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        size: Theme.icon-small;
        tint: root.danger && (hit.has-hover || hit.pressed)
            ? Theme.on-accent
            : root.window-active ? Theme.text-primary : Theme.text-muted;
    }

    animate background {
        duration: Theme.motion-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    horizontal-stretch: 1;
    background: Theme.border-subtle;
}

export component ProgressBar inherits Rectangle {
    in property <float> value: 0;

    height: Theme.space-1;
    border-radius: Theme.radius-full;
    background: Theme.border-default;

    Rectangle {
        width: parent.width * max(0, min(1, root.value));
        height: parent.height;
        border-radius: Theme.radius-full;
        background: Theme.accent;
        animate width {
            duration: Theme.motion-fast;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
    }
}

export component Slider inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> enabled: true;
    in property <bool> expand-on-hover: false;
    out property <bool> has-hover <=> touch.has-hover;
    out property <bool> is-dragging <=> touch.pressed;
    out property <float> pointer-ratio: self.width > 0px
        ? max(0, min(1, touch.mouse-x / self.width))
        : 0;
    callback changed(float);
    private property <float> ratio: maximum > minimum ? (value - minimum) / (maximum - minimum) : 0;
    private property <length> last-pointer-position: 0px;

    height: Theme.space-6;
    background: transparent;
    opacity: enabled ? 1 : 0.45;
    forward-focus: focus;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: root.expand-on-hover
            ? touch.has-hover || touch.pressed ? 6px : 3px
            : Theme.space-1;
        border-radius: Theme.radius-full;
        background: touch.pressed ? Theme.border-strong
            : touch.has-hover ? Theme.surface-hover
            : Theme.border-default;

        Rectangle {
            x: 0px;
            width: parent.width * max(0, min(1, root.ratio));
            height: parent.height;
            border-radius: Theme.radius-full;
            background: Theme.accent;
        }

        animate height, y {
            duration: Theme.motion-fast;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
    }

    Rectangle {
        x: (parent.width - self.width) * max(0, min(1, root.ratio));
        y: (parent.height - self.height) / 2;
        width: touch.pressed ? Theme.icon-medium : Theme.icon-small;
        height: touch.pressed ? Theme.icon-medium : Theme.icon-small;
        border-radius: Theme.radius-full;
        background: Theme.text-primary;
        border-width: focus.has-focus ? Theme.focus-ring-width : 1px;
        border-color: focus.has-focus ? Theme.focus-ring : Theme.surface-canvas;
        animate width, height, background {
            duration: Theme.motion-fast;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left
                && event.kind == PointerEventKind.down) {
                focus.focus();
                root.last-pointer-position = self.mouse-x;
                root.update-value(self.mouse-x);
            }
        }
        // Press already applies a click. Applying it again on release repeats
        // a seek (and its audio). Only horizontal drag movement needs updates.
        moved => {
            if (self.pressed && self.mouse-x != root.last-pointer-position) {
                root.last-pointer-position = self.mouse-x;
                root.update-value(self.mouse-x);
            }
        }
    }

    focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.set-value(root.value - (root.maximum - root.minimum) / 20);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.set-value(root.value + (root.maximum - root.minimum) / 20);
                return accept;
            }
            return reject;
        }
    }

    function set-value(next: float) {
        value = max(minimum, min(maximum, next));
        changed(value);
    }

    function update-value(position: length) {
        if (self.width > 0px) {
            set-value(minimum + max(0, min(1, position / self.width)) * (maximum - minimum));
        }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 44px;
    height: 26px;
    border-radius: Theme.radius-medium;
    background: checked
        ? interaction.pressed ? Theme.surface-pressed : Theme.accent-subtle
        : interaction.pressed ? Theme.surface-pressed : Theme.surface-control;
    border-width: 1px;
    border-color: checked ? Theme.accent
        : interaction.has-hover ? Theme.border-strong : Theme.border-default;
    opacity: enabled ? 1 : 0.45;
    forward-focus: interaction;
    accessible-role: switch;
    accessible-checked: checked;
    accessible-enabled: enabled;

    interaction := FocusTouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        capture-focus: false;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-large;
        background: transparent;
        border-width: interaction.has-focus ? Theme.focus-ring-width : 0px;
        border-color: Theme.focus-ring;
    }

    Rectangle {
        x: Theme.space-2;
        y: (parent.height - self.height) / 2;
        width: parent.width - Theme.space-4;
        height: 2px;
        border-radius: 1px;
        background: root.checked ? Theme.accent : Theme.border-strong;
        opacity: root.checked ? 0.55 : 0.7;

        animate background, opacity {
            duration: Theme.motion-normal;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
    }

    thumb := Rectangle {
        x: root.checked ? parent.width - self.width - 5px : 5px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 5px;
        background: root.checked ? Theme.accent : Theme.surface-chrome;
        border-width: 1px;
        border-color: root.checked ? Theme.accent-hover : Theme.border-strong;
        drop-shadow-color: Theme.shadow-low;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: root.checked ? Theme.on-accent : Theme.text-muted;
        }

        animate x {
            duration: Theme.motion-gentle;
            easing: cubic-bezier(0.22, 1, 0.36, 1);
        }

        animate background, border-color {
            duration: Theme.motion-normal;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
    }

    animate background, border-color, opacity {
        duration: Theme.motion-normal;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
}

export component Tooltip inherits Rectangle {
    in property <string> text;
    in property <bool> shown: false;

    visible: shown;
    min-width: Theme.space-12;
    max-width: 360px;
    height: Theme.space-8;
    border-radius: Theme.radius-small;
    background: Theme.surface-popover;
    border-width: 1px;
    border-color: Theme.border-default;
    drop-shadow-color: Theme.shadow-low;
    drop-shadow-blur: Theme.elevation-low-blur;
    drop-shadow-offset-y: Theme.elevation-low-y;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;

        UiText {
            text: root.text;
            variant: TextVariant.caption;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> action-text;
    in property <string> secondary-action-text;
    callback action();
    callback secondary-action();

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;

        UiText {
            text: root.title;
            variant: TextVariant.heading;
            horizontal-alignment: center;
        }

        UiText {
            text: root.description;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.action-text != "" || root.secondary-action-text != "" : HorizontalLayout {
            height: Theme.space-10;
            spacing: Theme.space-2;
            alignment: center;

            if root.action-text != "" : Button {
                width: 148px;
                text: root.action-text;
                primary: true;
                clicked => root.action();
            }

            if root.secondary-action-text != "" : Button {
                width: 148px;
                text: root.secondary-action-text;
                clicked => root.secondary-action();
            }
        }
    }
}
