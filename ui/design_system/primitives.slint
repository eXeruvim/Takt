import { Theme } from "../theme.slint";

export enum TextVariant {
    caption,
    body,
    label,
    heading,
    title,
}

export component UiText inherits Text {
    in property <TextVariant> variant: TextVariant.body;

    color: Theme.text-primary;
    font-size: variant == TextVariant.caption ? Theme.text-small
        : variant == TextVariant.heading ? Theme.text-heading
        : variant == TextVariant.title ? Theme.text-title
        : Theme.text-body;
    font-weight: variant == TextVariant.label ? 600
        : variant == TextVariant.heading || variant == TextVariant.title ? 700
        : 400;
}

export component Icon inherits Image {
    in property <length> size: Theme.icon-medium;
    in property <color> tint: Theme.text-primary;

    width: size;
    height: size;
    colorize: tint;
    image-fit: contain;
}

component FocusTouchArea {
    in property <bool> enabled: true;
    in property <bool> capture-focus: true;
    out property <bool> pressed <=> pointer.pressed;
    out property <bool> has-hover <=> pointer.has-hover;
    out property <bool> has-focus <=> focus.has-focus;
    callback clicked();

    forward-focus: focus;

    pointer := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => {
            if (root.capture-focus) {
                focus.focus();
            }
            root.clicked();
        }
    }

    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component Spinner inherits Rectangle {
    in property <bool> running: true;
    in property <color> spinner-color: Theme.text-secondary;
    private property <int> current-step: 0;

    width: Theme.icon-medium;
    height: Theme.icon-medium;
    background: transparent;

    Timer {
        interval: Theme.motion-fast;
        running: root.running;
        triggered => {
            root.current-step = Math.mod(root.current-step + 1, 3);
        }
    }

    HorizontalLayout {
        spacing: Theme.space-1;
        alignment: center;

        for dot[index] in [0, 1, 2] : Rectangle {
            width: Theme.space-1;
            height: Theme.space-1;
            border-radius: Theme.radius-full;
            background: root.spinner-color;
            opacity: root.current-step == index ? 1 : 0.35;
            animate opacity { duration: Theme.motion-fast; }
        }
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> loading: false;
    callback clicked();

    min-width: Theme.space-12 * 2;
    height: Theme.space-10;
    border-radius: Theme.radius-medium;
    background: !enabled ? Theme.surface-panel
        : interaction.pressed ? (primary ? Theme.accent-pressed : Theme.surface-pressed)
        : interaction.has-hover ? (primary ? Theme.accent-hover : Theme.surface-hover)
        : primary ? Theme.accent
        : selected ? Theme.surface-selected
        : Theme.surface-panel;
    border-width: interaction.has-focus ? Theme.focus-ring-width : 1px;
    border-color: interaction.has-focus ? Theme.focus-ring
        : primary ? transparent
        : selected ? Theme.accent
        : Theme.border-default;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-enabled: enabled;
    accessible-label: text;
    accessible-action-default => { if (enabled && !loading) { root.clicked(); } }
    forward-focus: interaction;

    interaction := FocusTouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled && !root.loading;
        clicked => root.clicked();
    }

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;
        alignment: center;

        if root.loading : Spinner {
            spinner-color: root.primary ? Theme.on-accent : Theme.text-secondary;
        }

        UiText {
            text: root.text;
            variant: TextVariant.label;
            color: root.primary ? Theme.on-accent : Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    animate background, border-color, opacity { duration: Theme.motion-fast; }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> accessible-name;
    in property <bool> primary: false;
    in property <bool> circular: false;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> loading: false;
    in property <bool> danger: false;
    in property <bool> capture-focus: true;
    callback clicked();

    width: Theme.space-10;
    height: Theme.space-10;
    border-radius: circular ? Theme.radius-full : Theme.radius-medium;
    background: interaction.pressed ? (danger ? Theme.danger : primary ? Theme.accent-pressed : Theme.surface-pressed)
        : interaction.has-hover ? (danger ? Theme.danger : primary ? Theme.accent-hover : Theme.surface-hover)
        : primary ? Theme.accent
        : selected ? Theme.surface-selected
        : transparent;
    border-width: interaction.has-focus ? Theme.focus-ring-width : 1px;
    border-color: interaction.has-focus ? Theme.focus-ring
        : primary ? transparent
        : selected ? Theme.accent
        : transparent;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: accessible-name;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled && !loading) { root.clicked(); } }
    forward-focus: interaction;

    interaction := FocusTouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled && !root.loading;
        capture-focus: root.capture-focus;
        clicked => root.clicked();
    }

    if root.loading : Spinner {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if !root.loading : Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        tint: root.primary || (root.danger && (interaction.has-hover || interaction.pressed))
            ? Theme.on-accent
            : root.selected ? Theme.accent
            : Theme.text-primary;
    }

    animate background, border-color, opacity { duration: Theme.motion-fast; }
}

export component Divider inherits Rectangle {
    height: 1px;
    horizontal-stretch: 1;
    background: Theme.border-subtle;
}

export component ProgressBar inherits Rectangle {
    in property <float> value: 0;

    height: Theme.space-1;
    border-radius: Theme.radius-full;
    background: Theme.border-default;

    Rectangle {
        width: parent.width * max(0, min(1, root.value));
        height: parent.height;
        border-radius: Theme.radius-full;
        background: Theme.accent;
        animate width { duration: Theme.motion-fast; }
    }
}

export component Slider inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> enabled: true;
    callback changed(float);
    private property <float> ratio: maximum > minimum ? (value - minimum) / (maximum - minimum) : 0;

    height: Theme.space-6;
    background: transparent;
    opacity: enabled ? 1 : 0.45;
    forward-focus: focus;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: Theme.space-1;
        border-radius: Theme.radius-full;
        background: touch.pressed ? Theme.border-strong
            : touch.has-hover ? Theme.surface-hover
            : Theme.border-default;

        Rectangle {
            width: parent.width * max(0, min(1, root.ratio));
            height: parent.height;
            border-radius: Theme.radius-full;
            background: Theme.accent;
        }
    }

    Rectangle {
        x: (parent.width - self.width) * max(0, min(1, root.ratio));
        y: (parent.height - self.height) / 2;
        width: touch.pressed ? Theme.icon-medium : Theme.icon-small;
        height: touch.pressed ? Theme.icon-medium : Theme.icon-small;
        border-radius: Theme.radius-full;
        background: Theme.text-primary;
        border-width: focus.has-focus ? Theme.focus-ring-width : 1px;
        border-color: focus.has-focus ? Theme.focus-ring : Theme.surface-canvas;
        animate width, height, background { duration: Theme.motion-fast; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => root.update-value(self.mouse-x);
        moved => root.update-value(self.mouse-x);
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.set-value(root.value - (root.maximum - root.minimum) / 20);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.set-value(root.value + (root.maximum - root.minimum) / 20);
                return accept;
            }
            return reject;
        }
    }

    function set-value(next: float) {
        value = max(minimum, min(maximum, next));
        changed(value);
    }

    function update-value(position: length) {
        set-value(minimum + max(0, min(1, position / self.width)) * (maximum - minimum));
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: Theme.space-10;
    height: Theme.space-6;
    border-radius: Theme.radius-full;
    background: checked
        ? interaction.pressed ? Theme.accent-pressed
            : interaction.has-hover ? Theme.accent-hover
            : Theme.accent
        : interaction.pressed ? Theme.surface-pressed
            : interaction.has-hover ? Theme.border-strong
            : Theme.border-default;
    border-width: interaction.has-focus ? Theme.focus-ring-width : 0px;
    border-color: Theme.focus-ring;
    opacity: enabled ? 1 : 0.45;
    forward-focus: interaction;
    accessible-role: switch;
    accessible-checked: checked;
    accessible-enabled: enabled;

    interaction := FocusTouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    Rectangle {
        x: root.checked ? parent.width - self.width - Theme.space-1 : Theme.space-1;
        y: Theme.space-1;
        width: Theme.space-4;
        height: Theme.space-4;
        border-radius: Theme.radius-full;
        background: root.checked ? Theme.on-accent : Theme.text-secondary;
        animate x { duration: Theme.motion-normal; easing: ease-in-out; }
    }

    animate background, opacity { duration: Theme.motion-fast; }
}

export component ShortcutBadge inherits Rectangle {
    in property <string> shortcut;

    min-width: Theme.space-8;
    height: Theme.space-6;
    border-radius: Theme.radius-small;
    background: Theme.surface-hover;
    border-width: 1px;
    border-color: Theme.border-default;

    UiText {
        text: root.shortcut;
        variant: TextVariant.label;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Tooltip inherits Rectangle {
    in property <string> text;
    in property <bool> shown: false;

    visible: shown;
    min-width: Theme.space-12;
    height: Theme.space-8;
    border-radius: Theme.radius-small;
    background: Theme.surface-elevated;
    border-width: 1px;
    border-color: Theme.border-default;
    drop-shadow-color: Theme.shadow-low;
    drop-shadow-blur: Theme.elevation-low-blur;
    drop-shadow-offset-y: Theme.elevation-low-y;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;

        UiText {
            text: root.text;
            variant: TextVariant.caption;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> action-text;
    callback action();

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;

        UiText {
            text: root.title;
            variant: TextVariant.heading;
            horizontal-alignment: center;
        }

        UiText {
            text: root.description;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.action-text != "" : Button {
            text: root.action-text;
            primary: true;
            clicked => root.action();
        }
    }
}
