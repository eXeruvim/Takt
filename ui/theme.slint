import { Palette } from "std-widgets.slint";

export global Theme {
    // Color mode. `unknown` follows the system setting through Slint's palette.
    in-out property <ColorScheme> color-scheme <=> Palette.color-scheme;
    out property <bool> is-dark: color-scheme == ColorScheme.dark;

    // Semantic surfaces. Canvas may reveal the desktop in a regular window;
    // focused surfaces become progressively more opaque with their elevation.
    out property <color> surface-canvas: is-dark ? #101014d9 : #f6f6f8e3;
    out property <color> surface-canvas-opaque: is-dark ? #101014 : #f6f6f8;
    out property <color> surface-media: #060608;
    out property <color> surface-media-glass: is-dark ? #08080acc : #f4f4f6d9;
    out property <color> surface-chrome: is-dark ? #151519e6 : #fafafbe8;
    out property <color> surface-inspector: is-dark ? #18181de8 : #fcfcfdea;
    out property <color> surface-popover: is-dark ? #1c1c21f5 : #fffffff7;
    out property <color> surface-modal: is-dark ? #19191ef7 : #fffffff9;
    out property <color> surface-control: is-dark ? #ffffff0d : #0000000a;
    out property <color> surface-hover: is-dark ? #ffffff16 : #00000010;
    out property <color> surface-pressed: is-dark ? #ffffff21 : #0000001a;
    out property <color> surface-selected: is-dark ? #e07a4f26 : #c85f381a;
    out property <color> backdrop: is-dark ? #0000008f : #16161a57;
    out property <brush> canvas-background: is-dark
        ? @linear-gradient(160deg, #141419d9 0%, #0d0d11e3 100%)
        : @linear-gradient(160deg, #fafafbe3 0%, #f1f1f4e8 100%);
    out property <brush> canvas-background-opaque: is-dark
        ? @linear-gradient(160deg, #141419 0%, #0d0d11 100%)
        : @linear-gradient(160deg, #fafafb 0%, #f1f1f4 100%);

    // Oxide copper accent: Rust-inspired without copying a brand palette.
    out property <color> accent: is-dark ? #e07a4f : #c85f38;
    out property <color> accent-hover: is-dark ? #eb906a : #b95330;
    out property <color> accent-pressed: is-dark ? #c9653f : #a94729;
    out property <color> accent-subtle: is-dark ? #e07a4f2b : #c85f3820;
    out property <color> on-accent: #ffffff;

    // Content colors.
    out property <color> text-primary: is-dark ? #f7f7f8 : #17171a;
    out property <color> text-secondary: is-dark ? #b5b5bd : #5f5f68;
    out property <color> text-muted: is-dark ? #7c7c86 : #8a8a94;
    out property <color> text-disabled: is-dark ? #55555e : #b1b1b8;
    out property <color> border-subtle: is-dark ? #ffffff12 : #00000010;
    out property <color> border-default: is-dark ? #ffffff20 : #0000001c;
    out property <color> border-strong: is-dark ? #ffffff36 : #00000030;
    out property <color> border-glass: is-dark ? #ffffff24 : #ffffffa3;

    // Feedback colors.
    out property <color> success: is-dark ? #32d583 : #168a55;
    out property <color> success-subtle: is-dark ? #32d58324 : #168a551a;
    out property <color> warning: is-dark ? #f6c344 : #a15c00;
    out property <color> warning-subtle: is-dark ? #f6c34424 : #a15c001a;
    out property <color> danger: is-dark ? #ff5f57 : #d92d3a;
    out property <color> danger-subtle: is-dark ? #ff5f5724 : #d92d3a1a;

    // Focus and elevation.
    out property <color> focus-ring: is-dark ? #f0a17d : #b95330;
    out property <length> focus-ring-width: 2px;
    out property <color> shadow-low: #00000026;
    out property <color> shadow-high: #00000052;
    out property <length> elevation-low-blur: 10px;
    out property <length> elevation-high-blur: 24px;
    out property <length> elevation-low-y: 3px;
    out property <length> elevation-high-y: 8px;

    // Four-point spacing scale.
    out property <length> space-0: 0px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-7: 28px;
    out property <length> space-8: 32px;
    out property <length> space-10: 40px;
    out property <length> space-12: 48px;

    // Shape and icon scales.
    out property <length> radius-small: 6px;
    out property <length> radius-medium: 8px;
    out property <length> radius-large: 10px;
    out property <length> radius-xlarge: 12px;
    out property <length> radius-full: 999px;
    out property <length> icon-small: 16px;
    out property <length> icon-medium: 20px;
    out property <length> icon-large: 24px;

    // Type scale.
    out property <length> text-xs: 11px;
    out property <length> text-small: 12px;
    out property <length> text-body: 14px;
    out property <length> text-large: 16px;
    out property <length> text-heading: 18px;
    out property <length> text-title: 20px;
    out property <length> text-display: 24px;

    // Motion.
    in-out property <bool> reduce-motion: false;
    out property <duration> motion-fast: reduce-motion ? 0ms : 120ms;
    out property <duration> motion-normal: reduce-motion ? 0ms : 220ms;
    out property <duration> motion-slow: reduce-motion ? 0ms : 280ms;

    // Player layout.
    out property <length> top-bar-height: 48px;
    out property <length> player-controls-height: 76px;
    out property <length> caption-button-width: 46px;

    // Compatibility aliases for components migrated in later slices.
    out property <color> surface-panel: surface-control;
    out property <color> surface-elevated: surface-popover;
    out property <color> surface-glass: surface-chrome;
    out property <color> surface-glass-strong: surface-inspector;
    out property <color> surface-glass-hover: surface-hover;
    out property <color> bg-primary: surface-canvas;
    out property <color> bg-secondary: surface-panel;
    out property <color> bg-elevated: surface-elevated;
    out property <color> border: border-subtle;
}
