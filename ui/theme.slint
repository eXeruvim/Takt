export global Theme {
    out property <color> bg-primary: #0b0f14;
    out property <color> bg-secondary: #121821;
    out property <color> bg-elevated: #171f2b;

    out property <color> accent: #4f7dff;
    out property <color> accent-hover: #6a91ff;
    out property <color> accent-pressed: #3d68e6;

    out property <color> text-primary: #ffffff;
    out property <color> text-secondary: #a7b0c0;
    out property <color> text-muted: #707b8c;

    out property <color> border: #ffffff15;

    out property <length> radius-small: 8px;
    out property <length> radius-medium: 12px;
    out property <length> radius-large: 18px;

    out property <length> panel-height: 92px;
}